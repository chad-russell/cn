# Reproducible COSMIC nightly image.
#
# Base: your local cdev image (Fedora). This adds the COSMIC desktop from the
# ryanabx/cosmic-epoch nightly COPR, plus the session plumbing a non-systemd
# container needs:
#   - dbus-daemon  -> provides dbus-run-session (no session bus otherwise)
#   - seatd        -> graphics-seat broker cosmic-comp talks to via
#                     LIBSEAT_BACKEND=seatd (no logind, and the builtin libseat
#                     backend can't acquire the session from podman exec)
#
# Update to the latest nightly by rebuilding with --no-cache:
#   sudo podman build --no-cache -t localhost/cosmic-dev:latest .
# (--no-cache is essential: without it, podman reuses cached RUN layers and
#  you get the OLD cosmic packages instead of the latest nightly.)

FROM localhost/cdev:latest

# dnf-plugins-core provides the `copr` subcommand.
RUN dnf install -y dnf-plugins-core

# COSMIC nightly COPR.
RUN dnf -y copr enable ryanabx/cosmic-epoch

# COSMIC desktop + the session plumbing. dnf resolves the latest versions
# available in the COPR at build time.
RUN dnf install -y cosmic-desktop dbus-daemon seatd && \
    dnf clean all
