{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/desktoppak-manifest-v1.schema.json",
  "title": "desktoppak manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "display_name", "session_type", "exec"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "session_type": {
      "type": "string",
      "enum": ["wayland"]
    },
    "exec": {
      "type": "string",
      "pattern": "^/"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": {
              "source": { "type": "string", "pattern": "^/" },
              "target": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "host_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "host", "guest"],
        "properties": {
          "type": { "type": "string", "enum": ["ro", "rw"] },
          "host": { "type": "string", "minLength": 1 },
          "guest": { "type": "string", "pattern": "^/|^\\$" },
          "optional": { "type": "boolean" }
        }
      }
    },
    "binds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "host", "guest"],
        "properties": {
          "type": { "type": "string", "enum": ["ro", "rw"] },
          "host": { "type": "string", "minLength": 1 },
          "guest": { "type": "string", "pattern": "^/|^\\$" }
        }
      }
    }
  }
}
