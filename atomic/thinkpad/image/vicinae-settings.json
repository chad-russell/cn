// This file is intentionally minimal: it keeps only the preferences that must
// be pinned for the bwrap-based host setup. Anything else can be changed from
// Vicinae's GUI and will be written back here.
{
  "$schema": "https://vicinae.com/schemas/config.json",
  "font": {
    "normal": {
      "family": "Noto Sans Mono",
      "size": 13
    }
  },
  "theme": {
    "dark": {
      "name": "zenwritten-dark"
    }
  },
  "providers": {
    "applications": {
      "preferences": {
        "defaultAction": "focus",
        "launchPrefix": "vicinae-host-launch"
      }
    }
  }
}
