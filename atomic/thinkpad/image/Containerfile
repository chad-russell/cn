# Custom Fedora Silverblue image for the ThinkPad — "bluefin-style".
#
# A thin layer over stock Silverblue. A few host-level changes that client-side
# rpm-ostree layering can't do cleanly:
#   - drop `toolbox` (ships IN the base image) and add `distrobox`;
#   - add `niri` (latest, via COPR) so GDM offers a Niri session next to GNOME;
#   - add Noctalia v5 and Vicinae as host binaries, each launched through
#     bubblewrap to keep filesystem/XDG state isolated.
# Everything else stays stock, per the project rule that the base image stays
# minimal and apps live in containers/flatpaks unless they genuinely need host
# session/hardware integration.
#
# This image uses the modern bootc-native build model, matching current
# Bluefin/finpilot (projectbluefin/finpilot):
#   - `dnf5` for all package changes at build time (NOT `rpm-ostree`).
#     finpilot's AGENTS.md is explicit: "Use dnf5 exclusively (never dnf, yum,
#     rpm-ostree)". In a bootc container build dnf5 writes straight into the
#     image's /usr, so a plain `dnf5 remove` drops a base package — no
#     `rpm-ostree override remove` needed (that was an rpm-ostree *client*
#     concept; at build time the tree is just a writable filesystem).
#   - `bootc container lint` to finalize/validate (replaces the old
#     `ostree container commit`).
#   - Switched/deployed with `bootc`, not `rpm-ostree` (see switch.sh).
#   bootc still uses ostree/libostree under the hood — it's the stable,
#   future-facing front-end (per bootc-status(8): "bootc and rpm-ostree share
#   the same code").
#
# Built and switched entirely locally — no registry, no GitHub Actions. See
# build.sh / switch.sh.
#
# Base image: the same one ublue/bluefin/finpilot derive from.

ARG FEDORA_MAJOR_VERSION=44
FROM quay.io/fedora-ostree-desktops/silverblue:${FEDORA_MAJOR_VERSION}

# ---- 1. The swap: toolbox -> distrobox --------------------------------
# `dnf5 remove` drops a base-image package; `dnf5 install` pulls distrobox from
# the Fedora repos. The cache mounts persist the dnf cache across rebuilds so
# repeated builds are fast (finpilot/lina-bh pattern).
#
# NOTE: this does NOT change the bespoke dev container in ../toolbox (that one
# stays a plain podman create with a separate $HOME). distrobox here just gives
# the `distrobox` CLI on the host for ad-hoc containers, replacing `toolbox`.
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    dnf5 -y remove toolbox && \
    dnf5 -y install distrobox

# ---- (future tweaks go here) ------------------------------------------
# Add more dnf5 layers for anything that genuinely can't live in a container or
# flatpak. Keep the base stock otherwise. Examples:
#
#   RUN --mount=type=cache,dst=/var/cache/libdnf5 \
#       dnf5 -y install <pkg>
#
# COPR (third-party Fedora repo) — enable -> install -> DISABLE in one layer so
# the repo doesn't persist into the booted image (finpilot's
# `copr_install_isolated` discipline, just inlined):
#
#   RUN --mount=type=cache,dst=/var/cache/libdnf5 \
#       dnf5 -y copr enable <user>/<project> && \
#       dnf5 -y install <pkg> && \
#       dnf5 -y copr disable <user>/<project>

# ---- 2. niri: a second Wayland session in GDM ------------------------
# Adds niri (scrollable-tiling Wayland compositor) so the GDM login screen
# offers a "Niri" session next to GNOME. The `niri` package installs
# `/usr/share/wayland-sessions/niri.desktop`, which GDM auto-discovers — no GDM
# config changes needed; it just appears under the gear icon at login.
#
# Pulls the latest STABLE niri from the upstream `yalter/niri` COPR (maintained
# by niri's author; newer than the Fedora-repo package). For nightly git builds
# — truly latest, but bleeding edge — swap the project to `yalter/niri-git`.
#
# `dnf5 copr` lives in `dnf5-plugins`, so install that first. Then the finpilot
# `copr_install_isolated` pattern shown in the comment block above: enable ->
# install -> disable in ONE layer so the COPR repo doesn't persist into the
# booted image. niri still refreshes on every image rebuild; no third-party repo
# leaks to /etc.
#
# NOTE: niri's built-in default config tries to spawn `waybar`, `fuzzel`, and
# `alacritty`. None are installed here (apps live in flatpaks/containers per the
# project rule), so a first login to Niri will be bare. Add those — as host
# packages, flatpaks, or in the dev container — to get a usable session.
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    dnf5 -y install dnf5-plugins && \
    dnf5 -y copr enable yalter/niri && \
    dnf5 -y install niri && \
    dnf5 -y copr disable yalter/niri && \
    dnf5 -y install fastfetch && \
    dnf5 -y remove toolbox && \
    dnf5 -y remove alacritty

# ---- 3. Noctalia: host binary + bwrap state isolation ------------------
# Noctalia is a desktop shell, so it needs native access to the host Wayland
# session, niri IPC socket, logind/system D-Bus, /sys backlight notifications,
# GPU/PipeWire, etc. A real container gives great dependency isolation but
# breaks backlight inotify via its separate sysfs mount. Install the binary on
# the host instead, then run it through `/usr/bin/noctalia-bwrap`, which
# uses bubblewrap only for filesystem/XDG state isolation.
#
# The Noctalia COPR is enabled only for this install layer, then disabled so no
# third-party repo persists in the booted image.
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    dnf5 -y install brightnessctl && \
    dnf5 -y copr enable lionheartp/Hyprland && \
    dnf5 -y install noctalia-git && \
    dnf5 -y copr disable lionheartp/Hyprland

COPY noctalia-bwrap /usr/bin/noctalia-bwrap
RUN chmod 0755 /usr/bin/noctalia-bwrap

# ---- 4. Vicinae: host binary + bwrap state isolation ---------------------
# Vicinae wants the same thing Noctalia does from this repo's point of view:
# native host integration (Wayland, app discovery, fast local IPC) without
# spraying config/cache/state/data across the real host XDG tree. Installing
# the host package and launching it through `/usr/bin/vicinae-bwrap`
# matches the Noctalia model and avoids the per-keypress latency of `podman
# exec ... vicinae toggle`.
#
# Unlike the earlier container prototype under ../vicinae/, the bwrap model uses
# the host's own package set and session bus directly. App launches are escaped
# back to the immutable host via `host-spawn`, called through the
# `vicinae-host-launch` prefix wrapper baked into this image.
ARG HOST_SPAWN_VERSION=v1.6.2
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    dnf5 -y copr enable quadratech188/vicinae && \
    dnf5 -y install vicinae curl && \
    dnf5 -y copr disable quadratech188/vicinae && \
    set -eux; \
    arch=$(uname -m); \
    case "$arch" in \
      x86_64|amd64) hsarch=x86_64 ;; \
      aarch64|arm64) hsarch=aarch64 ;; \
      armv7l) hsarch=armv7 ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/bin/host-spawn \
      "https://github.com/1player/host-spawn/releases/download/${HOST_SPAWN_VERSION}/host-spawn-${hsarch}"; \
    chmod 0755 /usr/bin/host-spawn

COPY vicinae-bwrap /usr/bin/vicinae-bwrap
COPY vicinae-host-launch /usr/bin/vicinae-host-launch
COPY vicinae-settings.json /usr/share/vicinae-bwrap/settings.json
RUN chmod 0755 /usr/bin/vicinae-bwrap /usr/bin/vicinae-host-launch

# ---- 5. build identity (lets `bootc upgrade` detect a rebuild) ----------
# Each build injects a unique IMAGE_VERSION (git SHA + timestamp; see
# build.sh) two ways:
#   - as an OCI LABEL, which lives in the image *config* and therefore changes
#     the image's MANIFEST/CONFIG DIGEST on every build. That digest is exactly
#     what `bootc upgrade` compares against the booted image, so a rebuilt
#     `:44` is always detected as new and gets deployed (see README, "switch
#     once, upgrade thereafter"). Without the label, a rebuild that reuses
#     podman's layer cache has an identical manifest digest and `bootc upgrade`
#     correctly — but uselessly — reports "No update available".
#   - written to /usr as well, so on the booted system you can `cat
#     /usr/lib/silverblue-thinkpad-version` to see exactly which build you're
#     on without querying bootc/podman.
# This is the ONLY layer that changes per build, so the dnf layers above stay
# cached and rebuilds stay fast.
ARG IMAGE_VERSION=local
RUN printf 'IMAGE_VERSION=%s\n' "${IMAGE_VERSION}" > /usr/lib/silverblue-thinkpad-version
LABEL org.opencontainers.image.version="${IMAGE_VERSION}"


# ---- 6. finalize: bootc-native validation -----------------------------
# systemd as pid 1 is required for a bootc image. `bootc container lint` then
# validates the image (catches /run leftovers, /opt issues, etc.) before you
# ever switch to it — it replaces the old `ostree container commit`.
CMD ["/sbin/init"]
RUN bootc container lint
