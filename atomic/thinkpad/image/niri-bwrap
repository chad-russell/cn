#!/usr/bin/env bash
# niri-bwrap — run the niri Wayland COMPOSITOR inside a bubblewrap mount
# namespace, so that all of the session's writable filesystem state is confined
# to one auditable volume tree under ~/.local/share/bwrap/niri-session.
#
# This is the compositor-level analogue of noctalia-bwrap / vicinae-bwrap.
# Those two sandbox individual desktop-shell *clients* of an already-running
# niri. This one sandboxes niri *itself* (and anything it spawns directly),
# so a login session can never write outside its volume root — making the
# per-login filesystem-cruft buildup that flatpaks/terminals/browsers normally
# spray across a real HOME physically impossible.
#
# It is wired up as a SEPARATE GDM session entry (see niri-bwrap.desktop), so
# the login gear menu keeps offering both "Niri" (stock) and "Niri (bubblewrap)"
# side by side. The stock /usr/share/wayland-sessions/niri.desktop from the
# package is left untouched.
#
# --------------------------------------------------------------------------- #
# What is isolated (contained to the volume root):
#   - $HOME is a private tmpfs; the real host HOME is not visible or writable.
#   - The ONLY persistent writable user state is the four XDG roots bind-mounted
#     from ~/.local/share/bwrap/niri-session/xdg-{config,state,data,cache}.
#     niri's config therefore lives at, on host:
#       ~/.local/share/bwrap/niri-session/xdg-config/niri/config.kdl
# --------------------------------------------------------------------------- #
# What is deliberately NOT isolated (a compositor needs host integration):
#   - host root filesystem, read-only  (packages, fonts, /etc, /usr)
#   - /dev, read-write                 (DRM/KMS card, GPU render node, input
#                                       event nodes, /dev/tty for VT switching)
#   - /proc (rw), /sys (ro)            process tree + hardware/udev enumeration
#   - $XDG_RUNTIME_DIR, rw             Wayland socket (created by niri here),
#                                      PipeWire, user/session bus, niri IPC
#                                      socket — so `niri msg` from a host
#                                      terminal keeps working
#   - /run/dbus (ro)                   system bus socket for logind: session
#                                      controller takeover + DRM/input fd handoff
#   - host ~/.local/share/bwrap (rw)   re-exposed at the SAME path inside the
#                                      sandbox so nested per-app wrappers
#                                      (noctalia-bwrap, vicinae-bwrap) launched
#                                      at niri startup still resolve their OWN
#                                      volume roots to the real on-disk location
#                                      instead of this session's tmpfs home, and
#                                      keep persisting normally
# --------------------------------------------------------------------------- #
# Why logind/KMS/input survive the sandbox:
#   bubblewrap here creates ONLY a mount namespace — it does not pass
#   --unshare-pid / --unshare-user / --unshare-cgroup. niri's PID therefore
#   stays in the login session's cgroup, sd_pid_get_session() still resolves,
#   and logind makes niri the session controller and passes it the DRM + input
#   fds over the system bus. No special Linux capabilities are required in the
#   process itself (this is also why this is a bwrap MOUNT sandbox and not a
#   Podman container, which would break logind's seat/VT mediation).
#
# Why niri-session can't be used here:
#   the package's `niri-session` launcher starts niri indirectly through
#   `systemctl --user`, i.e. OUTSIDE any bubblewrap namespace — so using it would
#   defeat the sandbox. We exec the `niri` binary directly instead. niri/Smithay
#   performs its own logind seat takeover and KMS setup, so it works bare; we
#   just set the desktop env vars (XDG_CURRENT_DESKTOP etc.) that niri-session
#   would otherwise export.
#
# The TWO niri-session chores that exec'ing bare niri would otherwise drop —
# publishing WAYLAND_DISPLAY into the systemd user manager + D-Bus activation
# environment, and capturing niri's output to a per-session log — are done by a
# tiny inline launcher that bwrap execs INSTEAD of niri directly (see
# NIRI_BWRAP_LAUNCHER near the bottom of this script). Without that launcher,
# D-Bus-activated and systemctl --user-started apps (portals, many Flatpaks,
# some terminals) never see the compositor — the classic some-apps-don't-launch
# symptom of a bare-compositor session.
set -euo pipefail

: "${HOME:?HOME is required}"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"

HOST_HOME="${HOME}"
SANDBOX_HOME="${HOME}"
VOL_ROOT="${NIRI_BWRAP_VOLUME_ROOT:-${HOST_HOME}/.local/share/bwrap/niri-session}"

# These are XDG *roots* as seen by the session, not app-specific subdirectories.
# Example: niri's config lives at
#   host:    $VOL_XDG_CONFIG/niri/config.kdl
#   sandbox: $HOME/.config/niri/config.kdl
VOL_XDG_CONFIG="${VOL_ROOT}/xdg-config"
VOL_XDG_STATE="${VOL_ROOT}/xdg-state"
VOL_XDG_DATA="${VOL_ROOT}/xdg-data"
VOL_XDG_CACHE="${VOL_ROOT}/xdg-cache"

SANDBOX_CONFIG="${SANDBOX_HOME}/.config"
SANDBOX_STATE="${SANDBOX_HOME}/.local/state"
SANDBOX_DATA="${SANDBOX_HOME}/.local/share"
SANDBOX_CACHE="${SANDBOX_HOME}/.cache"

# Real host bwrap volume root. Re-exposed inside the sandbox at the matching
# path below so nested per-app bwaps (noctalia-bwrap, vicinae-bwrap) launched
# from niri's spawn-at-startup resolve their own volume roots to the real
# on-disk location rather than this session's tmpfs home.
HOST_BWRAP_ROOT="${HOST_HOME}/.local/share/bwrap"
SANDBOX_BWRAP_ROOT="${SANDBOX_HOME}/.local/share/bwrap"

mkdir -p \
  "${VOL_XDG_CONFIG}" \
  "${VOL_XDG_STATE}" \
  "${VOL_XDG_DATA}" \
  "${VOL_XDG_CACHE}"

# First-run convenience: if the user already runs the STOCK Niri entry, they have
# a real ~/.config/niri. Seed the session volume from it so the first bwrap
# login isn't a bare default session. Idempotent — never overwrites an existing
# volume config, so the two entries can later diverge independently.
seed_niri_config() {
  local host_cfg="${HOST_HOME}/.config/niri"
  local vol_cfg="${VOL_XDG_CONFIG}/niri"
  if [[ -d "${host_cfg}" && ! -e "${vol_cfg}" ]]; then
    cp -a "${host_cfg}" "${vol_cfg}"
  fi
}
seed_niri_config

# System XDG_DATA_DIRS minus the host user paths that the tmpfs home now hides.
# Keeps /usr/share + system Flatpak exports visible for icon/cursor/desktop
# discovery. Per-user Flatpak exports live under the hidden host HOME and are
# intentionally dropped (apps escape to the host via vicinae-host-launch anyway).
SANDBOX_DATA_DIRS="/usr/local/share:/usr/share:/var/lib/flatpak/exports/share"

# Mount audit:
# - /                    readonly host OS/runtime, packages, fonts, desktop files
# - /dev                 FULL host /dev, rw: DRM/KMS (card0), GPU render node,
#                       input/event nodes, /dev/tty for VT switching. Broad on
#                       purpose: a compositor needs real device access, and the
#                       threat model here is filesystem-cruft containment, not
#                       privilege reduction on a single-user laptop. logind
#                       still mediates the DRM+input fds; this just guarantees
#                       the nodes are reachable.
# - /proc                rw: process tree (ps, niri child management)
# - /sys                 ro: hardware/hwmon/udev enumeration
# - $XDG_RUNTIME_DIR     rw: Wayland socket (niri creates wayland-0 here),
#                       PipeWire, user/session bus, niri IPC socket
# - /run/dbus            ro: system bus socket for logind. Clients only connect
#                       to /run/dbus/system_bus_socket; read-only is sufficient
#                       (the daemon runs on the host, outside the sandbox).
# - /run/udev            ro: libudev device metadata for hardware probes
# - $HOME                private tmpfs; real host home hidden
# - XDG roots            the only persistent writable state for the session
# - host bwrap root      rw re-expose so nested per-app bwaps persist correctly
# - /tmp                 private tmpfs
#
# The program always run is `niri` (plus any extra args passed through), to
# match the session purpose. We never go through niri-session — see header.
#
# Backend selection (CRITICAL): niri picks its backend from the environment.
# If WAYLAND_DISPLAY or DISPLAY is set, niri runs NESTED via its winit/X11
# backend — i.e. as a CLIENT of an existing compositor. This wrapper launches
# niri AS the compositor, so there is no parent compositor, and setting either
# var makes niri panic at startup with
#     WaylandError(Connection(NoCompositor))   (winit event_loop)
# — exactly the failure seen when WAYLAND_DISPLAY is baked in. So we
# --unsetenv BOTH and let niri fall through to its native DRM/libseat backend:
# it takes the seat via logind, creates wayland-0 under $XDG_RUNTIME_DIR
# itself, and exports WAYLAND_DISPLAY into the env of its own spawned children
# (noctalia-bwrap / vicinae-bwrap included). Nothing downstream needs us to
# set it. (This is the one real difference from the client-side wrappers, which
# DO set WAYLAND_DISPLAY because they connect to niri rather than being it.)
#
# bwrap therefore does NOT exec niri directly. It execs the inline launcher
# below, which: (1) starts niri with all its stdout/stderr captured to a
# per-session log, (2) once the Wayland socket exists, publishes WAYLAND_DISPLAY
# et al. into the systemd user manager and the D-Bus activation environment
# (the two niri-session chores exec'ing bare niri would otherwise drop), and
# (3) forwards teardown signals to niri (the launcher, not niri, is what bwrap
# waits on). The heredoc uses a single-quoted delimiter so the OUTER shell
# never touches $HOME / "$@" / $XDG_RUNTIME_DIR below; they are resolved by
# the INNER bash running inside the namespace. $0 is set to niri-bwrap-inner
# purely so ps/listings are legible.
IFS= read -r -d '' NIRI_BWRAP_LAUNCHER <<'NIRI_BWRAP_LAUNCHER' || true
set -uo pipefail

: "${HOME:?niri-bwrap launcher: HOME is not set in the sandbox}"
: "${XDG_RUNTIME_DIR:?niri-bwrap launcher: XDG_RUNTIME_DIR is not set}"

LOG_DIR="$HOME/.local/share/bwrap/niri-session"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/session.log"

# Rotate: keep the previous run as session.log.old so a fresh crash never
# destroys the evidence from the last attempt while iterating.
if [ -f "$LOG" ]; then
  mv -f "$LOG" "$LOG.old"
fi

# (1) Start niri. All of its stdout/stderr (panics, Smithay logs, child stderr
# from spawn-at-startup) lands in the session log.
niri "$@" >"$LOG" 2>&1 &
niri_pid=$!

# (3) Forward teardown signals logind/GDM send the session onto niri.
trap 'kill -TERM "$niri_pid" 2>/dev/null || true' TERM
trap 'kill -INT  "$niri_pid" 2>/dev/null || true' INT
trap 'kill -HUP  "$niri_pid" 2>/dev/null || true' HUP

# (2) Wait for the Wayland socket niri itself creates under $XDG_RUNTIME_DIR,
# then advertise the compositor to the rest of the user session. 10s ceiling;
# if the socket never appears (niri crashed during early init) the log records
# a warning — go read $LOG.
sock="$XDG_RUNTIME_DIR/wayland-0"
i=0
# Stop early if the socket appears OR niri has already died (so a fast niri
# crash does not make us wait the full 10s window).
while [ "$i" -lt 100 ] && [ ! -S "$sock" ] && kill -0 "$niri_pid" 2>/dev/null; do
  i=$((i + 1))
  sleep 0.1
done

if [ ! -S "$sock" ]; then
  if ! kill -0 "$niri_pid" 2>/dev/null; then
    echo "niri-bwrap: niri exited before creating $sock (see lines above for the crash)" >>"$LOG"
  else
    echo "niri-bwrap: $sock never appeared after ~10s; niri likely stuck during early init" >>"$LOG"
  fi
else
  export WAYLAND_DISPLAY=wayland-0
  if command -v systemctl >/dev/null 2>&1; then
    # Only compositor-discovery vars. Deliberately NOT XDG_*_HOME: those would
    # pollute the shared user manager (which runs OUTSIDE this sandbox) and
    # make user services resolve state against the wrong tree.
    systemctl --user import-environment \
      WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
      >>"$LOG" 2>&1 \
      || echo "niri-bwrap: systemctl --user import-environment failed" >>"$LOG"
  else
    echo "niri-bwrap: systemctl not found; cannot import env into user manager" >>"$LOG"
  fi
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --all >>"$LOG" 2>&1 \
      || echo "niri-bwrap: dbus-update-activation-environment failed" >>"$LOG"
  else
    echo "niri-bwrap: dbus-update-activation-environment not found (install dbus-x11)" >>"$LOG"
  fi
fi

# Block until niri exits, then propagate its status to bwrap/GDM.
wait "$niri_pid"
exit $?
NIRI_BWRAP_LAUNCHER

exec bwrap \
  --ro-bind / / \
  --dev-bind /dev /dev \
  --proc /proc \
  --ro-bind /sys /sys \
  --ro-bind-try /run/dbus /run/dbus \
  --ro-bind-try /run/udev /run/udev \
  --bind "${XDG_RUNTIME_DIR}" "${XDG_RUNTIME_DIR}" \
  --tmpfs /tmp \
  --tmpfs "${SANDBOX_HOME}" \
  --dir "${SANDBOX_HOME}/.config" \
  --dir "${SANDBOX_HOME}/.local" \
  --dir "${SANDBOX_HOME}/.local/state" \
  --dir "${SANDBOX_HOME}/.local/share" \
  --dir "${SANDBOX_HOME}/.local/share/bwrap" \
  --dir "${SANDBOX_HOME}/.cache" \
  --bind "${VOL_XDG_CONFIG}" "${SANDBOX_CONFIG}" \
  --bind "${VOL_XDG_STATE}" "${SANDBOX_STATE}" \
  --bind "${VOL_XDG_DATA}" "${SANDBOX_DATA}" \
  --bind "${VOL_XDG_CACHE}" "${SANDBOX_CACHE}" \
  --bind-try "${HOST_BWRAP_ROOT}" "${SANDBOX_BWRAP_ROOT}" \
  --setenv HOME "${SANDBOX_HOME}" \
  --setenv XDG_RUNTIME_DIR "${XDG_RUNTIME_DIR}" \
  --unsetenv WAYLAND_DISPLAY \
  --unsetenv DISPLAY \
  --setenv XDG_CONFIG_HOME "${SANDBOX_CONFIG}" \
  --setenv XDG_STATE_HOME "${SANDBOX_STATE}" \
  --setenv XDG_DATA_HOME "${SANDBOX_DATA}" \
  --setenv XDG_CACHE_HOME "${SANDBOX_CACHE}" \
  --setenv XDG_DATA_DIRS "${SANDBOX_DATA_DIRS}" \
  --setenv XDG_SESSION_TYPE "${XDG_SESSION_TYPE:-wayland}" \
  --setenv XDG_CURRENT_DESKTOP "${XDG_CURRENT_DESKTOP:-niri}" \
  --setenv XDG_SESSION_DESKTOP "${XDG_SESSION_DESKTOP:-niri}" \
  --chdir "${SANDBOX_HOME}" \
  bash -c "${NIRI_BWRAP_LAUNCHER}" niri-bwrap-inner "$@"
