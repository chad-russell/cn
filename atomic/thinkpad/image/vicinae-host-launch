#!/bin/sh
set -eu

STATE_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}"
LOG="${VICINAE_LAUNCH_LOG:-${STATE_ROOT}/vicinae/launch.log}"

mkdir -p "$(dirname "$LOG")"
printf '[%s] launching: %s\n' "$(date -Is)" "$*" >> "$LOG"

# Escape the bwrap namespace and run the target on the immutable host via
# flatpak-session-helper over the host session bus.
setsid /usr/bin/host-spawn "$@" >> "$LOG" 2>&1 < /dev/null &
exit 0
