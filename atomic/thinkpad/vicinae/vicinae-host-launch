#!/bin/sh
#
# ARCHIVED container-based Vicinae helper.
# Current production path is host `vicinae` + `image/vicinae-bwrap`; see
# `vicinae/README.md`.
#
# vicinae "Launch Prefix" wrapper.
#
# Set vicinae's "Launch Prefix" setting to:  vicinae-host-launch
# Then every app launch becomes:
#
#     vicinae-host-launch <.desktop Exec= tokens>
#
# e.g.   vicinae-host-launch firefox %u
#
# We forward the argv to `host-spawn`, which executes it on the immutable host
# via flatpak-session-helper (over the host session D-Bus).
#
# Why a wrapper (instead of setting the prefix to `host-spawn` directly)?
#   * We detach with setsid(1) so vicinae never blocks waiting for the launched
#     GUI app to exit.
#   * We log every launch to a file so you can see exactly what was run and
#     whether host-spawn is wired up correctly.
#
set -eu

LOG="${VICINAE_LAUNCH_LOG:-/home/vicinae/launch.log}"

printf '[%s] launching: %s\n' "$(date -Is)" "$*" >> "$LOG"

# Fully detach: new session, no controlling tty, stdio redirected to the log.
setsid /usr/local/bin/host-spawn "$@" >> "$LOG" 2>&1 < /dev/null &

# Don't let the launcher inherit the background pid / be tempted to wait on it.
disown 2>/dev/null || true
exit 0
