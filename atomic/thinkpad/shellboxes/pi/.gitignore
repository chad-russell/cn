# Machine-local pi state — not version controlled.
# These dirs are created/managed by pi at runtime via PI_CODING_AGENT_DIR /
# XDG_CACHE_HOME redirection.
#
# NOTE: config/ also holds auth.json (API keys) and sessions/, which is why
# the whole config tree is ignored by default. Commit individual files
# (settings.json, extensions, skills, themes) explicitly if you want them
# version controlled.
/config/
/cache/
