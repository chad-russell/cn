FROM registry.fedoraproject.org/fedora-toolbox:44

# --- Install Noctalia -----------------------------------------------------------
RUN dnf -y copr enable lionheartp/Hyprland && \
    dnf -y install brightnessctl && \
    dnf -y install noctalia-git && \
    dnf clean all

# --- Brightness helper ---------------------------------------------------------
# Runs inside the container; called from the host niri config via `podman exec`.
# See the script header for why `noctalia msg brightness-up` can't be used here.
COPY noctalia-brightness /usr/local/bin/noctalia-brightness
RUN chmod 0755 /usr/local/bin/noctalia-brightness
