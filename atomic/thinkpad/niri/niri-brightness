#!/bin/sh
# niri-brightness — change the backlight from inside the niri container, with OSD.
#
# Bound to the XF86MonBrightness keys from config.kdl, e.g.:
#     XF86MonBrightnessUp   { spawn-sh "niri-brightness up"; }
#     XF86MonBrightnessDown { spawn-sh "niri-brightness down"; }
#
# Why this exists:
#   Noctalia's `brightness-up/down` IPC is relative to a cached value refreshed
#   via sysfs inotify. That cache freezes in containers because sysfs inotify
#   does not fire there.
#
#   We therefore do two things ourselves:
#     1. change brightness through logind over the forwarded system bus
#     2. tell Noctalia to show the absolute-value OSD
#
#   This now talks to logind directly via D-Bus instead of going through
#   brightnessctl, because brightnessctl is failing in this container setup.
#
# Env:
#   BRIGHTNESS_STEP           percent step (default 5)
#   NOCTALIA_BRIGHTNESS_DEBUG set to 1 to trace to stderr
set -eu

log() { :; }
if [ -n "${NOCTALIA_BRIGHTNESS_DEBUG:-}" ]; then
    log() { echo "niri-brightness: $*" >&2; }
fi

die() {
    echo "niri-brightness: $*" >&2
    exit 1
}

step="${BRIGHTNESS_STEP:-5}"
direction="${1:-}"

case "$step" in ''|*[!0-9]*) step=5 ;; esac

case "$direction" in
    up|down) ;;
    *)
        echo "usage: niri-brightness <up|down>" >&2
        exit 2
        ;;
esac

[ -n "${XDG_SESSION_ID:-}" ] || die "XDG_SESSION_ID is not set"
command -v busctl >/dev/null 2>&1 || die "busctl not found on PATH"

backlight_dir="$(find /sys/class/backlight -mindepth 1 -maxdepth 1 -type l 2>/dev/null | head -n1)"
[ -n "$backlight_dir" ] || die "no backlight device found under /sys/class/backlight"

device="$(basename "$backlight_dir")"
max="$(cat "$backlight_dir/max_brightness")"
current="$(cat "$backlight_dir/brightness")"

case "$max:$current" in
    *[!0-9:]*|:|*::*) die "invalid backlight values (max=$max current=$current)" ;;
esac

change=$(( max * step / 100 ))
[ "$change" -gt 0 ] || change=1

case "$direction" in
    up) target=$(( current + change )) ;;
    down) target=$(( current - change )) ;;
esac

[ "$target" -ge 0 ] || target=0
[ "$target" -le "$max" ] || target="$max"

log "device=$device current=$current max=$max target=$target session=$XDG_SESSION_ID"

session_path="$(busctl --system call \
    org.freedesktop.login1 \
    /org/freedesktop/login1 \
    org.freedesktop.login1.Manager \
    GetSession s "$XDG_SESSION_ID" 2>/dev/null | sed -n 's/^o \(".*"\)$/\1/p' | tr -d '"')"
[ -n "$session_path" ] || die "failed to resolve logind session object for XDG_SESSION_ID=$XDG_SESSION_ID"

if ! output="$(busctl --system call \
    org.freedesktop.login1 \
    "$session_path" \
    org.freedesktop.login1.Session \
    SetBrightness ssu backlight "$device" "$target" 2>&1)"; then
    [ -n "$output" ] && log "$output"
    die "logind SetBrightness failed"
fi

new_current="$(cat "$backlight_dir/brightness" 2>/dev/null || printf '%s' "$target")"
percent=$(( new_current * 100 / max ))

if noctalia msg brightness-osd "$percent" >/dev/null 2>&1; then
    log "ok -> ${percent}%"
else
    log "osd call failed (brightness still changed to ${percent}%)"
fi
