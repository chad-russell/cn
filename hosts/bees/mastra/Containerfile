# Mastra Factory server image (bees — built by mastra-image-build.service).
#
# Stage 1 installs the vendored Factory server project
# (hosts/bees/mastra/factory) and builds it: `npm run build` →
# `mastra build --dir src/mastra --studio`, producing a self-contained
# .mastra/output (server bundle + Factory UI + Studio UI + its own
# node_modules).
#
# Stage 2 is the runtime: node:22-bookworm-slim plus git/openssh-client for
# LocalSandbox repo checkouts (FACTORY_SANDBOX_PROVIDER=local), and curl for
# the container healthcheck. The server runs `node index.mjs` directly —
# no varlock/.env in the container; every env var comes from the quadlet and
# /run/agenix/factory-env.

# Build context is the vendored factory project directory.
FROM docker.io/library/node:22-bookworm-slim AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY . .
RUN npm run check && npm run build

FROM docker.io/library/node:22-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates openssh-client curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /build/.mastra/output/ /app/
ENV NODE_ENV=production
# Serve the bundled Studio UI at /studio (the build CLI's own hint: without
# this the path falls through to the Factory SPA catch-all).
ENV MASTRA_STUDIO_PATH=/app/studio
EXPOSE 4111
# The generated server handles SIGTERM/SIGINT with a drain window (default
# 5s), so podman's default stop sequence shuts it down cleanly.
CMD ["node", "/app/index.mjs"]
