[Unit]
Description=Mastra Factory — Factory UI + Studio + agent server
# Image build (oneshot) and a healthy DB must both complete first.
Requires=mastra-image-build.service mastra-postgres.service
After=mastra-image-build.service mastra-postgres.service
# Always trying to be up: no restart-rate limiting (deliberate — the unit
# should keep relaunching through crash loops rather than give up).
StartLimitIntervalSec=0

[Container]
# Built by mastra-image-build.service from hosts/bees/mastra/factory/
# (the vendored Mastra Factory server template) via hosts/bees/mastra/
# Containerfile. Bump by committing project changes — the builder's podman
# cache only rebuilds layers whose inputs changed.
Image=localhost/mastra-factory:latest
ContainerName=mastra
# No auth provider — internal-only route (Chad's call: Mastra auth is
# optional; every route + Studio is open, gated by the overlay itself).
Environment=MASTRACODE_AUTH_DISABLED=1
Environment=NODE_ENV=production
Environment=MASTRACODE_PUBLIC_URL=https://mastra.internal.crussell.io
# Local execution: agent coding sessions check repos out under the sandbox
# volume, inside this container (git + node baked into the image).
Environment=FACTORY_SANDBOX_PROVIDER=local
Environment=MASTRACODE_LOCAL_SANDBOX_ROOT=/data/sandboxes
Environment=TZ=America/New_York
# DATABASE_URL (→ mastra-postgres), FACTORY_CREDENTIAL_ENCRYPTION_KEY,
# GITHUB_APP_WEBHOOK_SECRET (stable state-signing secret until the GitHub
# App is wired — see secrets.nix).
EnvironmentFile=/run/agenix/factory-env
Network=mastra.network
# Loopback only — bees Caddy (host network) fronts this at
# mastra.internal.crussell.io.
PublishPort=127.0.0.1:8094:4111
Volume=mastra_sandboxes:/data/sandboxes
# Server exposes GET /health (mastra-server convention); curl is baked into
# the image for exactly this.
HealthCmd=curl --fail --silent --output /dev/null http://127.0.0.1:4111/health
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthTimeout=5s
Notify=healthy

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
