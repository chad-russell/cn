[Unit]
Description=Lane (Plane CE) — space (public docs site :3000)
Requires=lane-api.service
After=lane-api.service lane-worker.service lane-web.service

[Container]
Image=docker.io/makeplane/plane-space:v1.4.2
ContainerName=space
Network=lane.network

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
