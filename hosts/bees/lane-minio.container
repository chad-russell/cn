[Unit]
Description=Lane (Plane CE) — MinIO (S3-compatible uploads)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
ContainerName=plane-minio
Command=server /export --console-address :9090
# AWS_SECRET_ACCESS_KEY (+ AWS_ACCESS_KEY_ID) come from /run/agenix/lane-env.
Environment=AWS_ACCESS_KEY_ID=lane
EnvironmentFile=/run/agenix/lane-env
Volume=lane_uploads:/export
Network=lane.network

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
