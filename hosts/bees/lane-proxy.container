[Unit]
Description=Lane (Plane CE) — edge proxy (nginx :80 → 127.0.0.1:8100)
Requires=lane-web.service lane-api.service lane-space.service lane-admin.service lane-live.service
After=lane-web.service lane-api.service lane-space.service lane-admin.service lane-live.service

[Container]
Image=docker.io/makeplane/plane-proxy:v1.4.2
ContainerName=lane-proxy
# TLS terminates at bees Caddy (wildcard *.internal.crussell.io); the proxy
# serves plain HTTP on :80 and publishes to loopback only.
Environment=APP_DOMAIN=lane.internal.crussell.io
Environment=SITE_ADDRESS=:80
Environment=BUCKET_NAME=uploads
Environment=FILE_SIZE_LIMIT=52428800
PublishPort=127.0.0.1:8100:80
Network=lane.network

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
