[Unit]
Description=Kaneo — PostgreSQL 16
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=kaneo-postgres
# POSTGRES_PASSWORD comes from the agenix env file (/run/agenix/kaneo-env).
Environment=POSTGRES_DB=kaneo
Environment=POSTGRES_USER=kaneo
EnvironmentFile=/run/agenix/kaneo-env
Volume=kaneo_postgres_data:/var/lib/postgresql/data
# No PublishPort — reachable only inside the kaneo network.
Network=kaneo.network
# Not considered started until the DB accepts connections, so kaneo.service
# (After/Requires this unit) never races a booting DB.
HealthCmd=pg_isready -U kaneo -d kaneo
HealthInterval=5s
HealthRetries=12
HealthStartPeriod=10s
HealthTimeout=3s
Notify=healthy

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
