[Unit]
Description=Lane (Plane CE) — web frontend (Next.js :3000)
Requires=lane-api.service
After=lane-api.service lane-worker.service

[Container]
Image=docker.io/makeplane/plane-frontend:v1.4.2
ContainerName=web
Network=lane.network

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
