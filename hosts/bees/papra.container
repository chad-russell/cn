[Unit]
Description=Papra Document Manager
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/papra-hq/papra:latest
# AutoUpdate=registry + nightly podman auto-update
# (hosts/bees/podman-auto-update.nix) track the floating tag.
AutoUpdate=registry
ContainerName=papra
EnvironmentFile=/var/lib/papra/auth.env
Environment=APP_BASE_URL=https://papra.internal.crussell.io
Environment=TZ=America/New_York
PublishPort=30083:1221
Volume=/var/lib/papra/data:/app/app-data

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
