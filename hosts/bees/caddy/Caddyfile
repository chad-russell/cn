# Internal services only - *.internal.crussell.io
#
# Public routes (*.crussell.io) are terminated by the gateway (Hetzner VPS),
# which runs its own Caddy and reverse-proxies to backends over Nebula. Bees
# no longer handles public TLS — only the internal wildcard below, which uses
# the Route53 DNS challenge because internal hostnames resolve to a private
# (Nebula) IP and so can't use HTTP-01.

*.internal.crussell.io {
    tls {
        dns route53 {
            hosted_zone_id Z0225258330LLQ5BK81Z0
        }
        propagation_timeout 5m
    }

    # All internal routes are loaded from individual files.
    # Each file in routes/internal/*.caddy contains matchers and handlers
    # for a logical group of services.
    import /etc/caddy/imports/routes/internal/*.caddy
}

# sweatshop app previews — one subdomain per sandbox preview:
# https://<slug>.preview.internal.crussell.io. Same upstream as
# sweatshop.internal.crussell.io (bee 10.10.0.12:3330); sweatshop reads
# the slug from the Host header (passed through untouched) and routes
# to the right sandbox. The slug labels sit one level deeper than
# *.internal.crussell.io, so this site needs its own wildcard cert —
# same Route53 DNS challenge; DNS itself is already covered by the
# zone's *.preview.internal wildcard (everything resolves to bees).
*.preview.internal.crussell.io {
    tls {
        dns route53 {
            hosted_zone_id Z0225258330LLQ5BK81Z0
        }
        propagation_timeout 5m
    }

    # Route files for preview subdomains. Every <slug>.preview host hits
    # these; see routes/preview/ in the repo.
    import /etc/caddy/imports/routes/preview/*.caddy
}

# dsh-relay management pages on the standard relay port — the dsh web UI's
# "Relay" corner link points at host:3443, so it must answer on the DNS name.
# Caddy terminates TLS with the same wildcard cert; the relay behind does its
# own self-signed TLS (skip verify, SNI = the public hostname it accepts).
dsh.internal.crussell.io:3443 {
    reverse_proxy https://10.10.0.12:3443 {
        transport http {
            tls_insecure_skip_verify
            tls_server_name dsh.internal.crussell.io
        }
    }
}
