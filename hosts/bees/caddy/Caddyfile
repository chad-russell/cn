# Internal services only - *.internal.crussell.io
#
# Public routes (*.crussell.io) are terminated by the gateway (Hetzner VPS),
# which runs its own Caddy and reverse-proxies to backends over Nebula. Bees
# no longer handles public TLS — only the internal wildcard below, which uses
# the Route53 DNS challenge because internal hostnames resolve to a private
# (Nebula) IP and so can't use HTTP-01.

*.internal.crussell.io {
    tls {
        dns route53 {
            hosted_zone_id Z0225258330LLQ5BK81Z0
        }
        propagation_timeout 5m
    }

    # All internal routes are loaded from individual files.
    # Each file in routes/internal/*.caddy contains matchers and handlers
    # for a logical group of services.
    import /etc/caddy/imports/routes/internal/*.caddy
}
