# sweatshop app previews (bee — sweatshop.service on 10.10.0.12:3330, the
# same upstream as sweatshop.internal.crussell.io). Each sandbox preview
# gets its own subdomain, https://<slug>.preview.internal.crussell.io
# (slug: 12 chars [A-Za-z0-9]); sweatshop reads the slug from the
# original Host header — Caddy passes Host through by default, don't
# rewrite it — and routes to the right sandbox container. Dev servers
# hold streams open (HMR WebSockets, SSE): pass through and flush
# immediately. No auth on purpose: LAN/Nebula only — never route
# publicly.

handle {
    reverse_proxy 10.10.0.12:3330 {
        flush_interval -1
    }
}
