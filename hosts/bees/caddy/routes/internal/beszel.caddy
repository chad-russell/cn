# Beszel monitoring hub (bees — localhost). Hub listens on 8091, not its
# default 8090, because ntfy-sh already uses 8090 on this host.
#
# WebSocket proxying is handled automatically by Caddy's reverse_proxy;
# the read_timeout matches Beszel's reverse-proxy docs so long-lived
# agent WebSocket connections aren't cut off.

@beszel host beszel.internal.crussell.io
handle @beszel {
    request_body {
        max_size 10MB
    }
    reverse_proxy 127.0.0.1:8091 {
        transport http {
            read_timeout 360s
        }
    }
}
