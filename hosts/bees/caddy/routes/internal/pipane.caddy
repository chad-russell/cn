# Pipane — Web UI for pi coding agent
#
# pi-bees: pipane running on bees (localhost)
# pi-bee:  pipane running on bee (Nebula 10.10.0.12)

@pipane-bees host pi-bees.internal.crussell.io
handle @pipane-bees {
    reverse_proxy 127.0.0.1:8222
}

@pipane-bee host pi-bee.internal.crussell.io
handle @pipane-bee {
    reverse_proxy 10.10.0.12:8222
}
