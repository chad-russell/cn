# Relay management pages for dsh.internal.crussell.io — bees Caddy terminates
# TLS with the real wildcard cert (browsers trust it) and proxies to the
# dsh-relay's self-signed listener on bee. publicHostnames on the relay
# accepts this Host. The dsh web UI's "Relay" corner link points at
# :3443 on its own host, so this route makes that link work from anywhere.
dsh.internal.crussell.io:3443 {
	reverse_proxy 10.10.0.12:3443 {
		transport http {
			tls_insecure_skip_verify
			# relay does its own TLS; caddy re-encrypts to it
			tls_server_name dsh.internal.crussell.io
		}
	}
}
