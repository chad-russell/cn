# Hub production services (bees — localhost)

@linkding host linkding.internal.crussell.io
handle @linkding {
    reverse_proxy 127.0.0.1:30080
}

@papra host papra.internal.crussell.io
handle @papra {
    reverse_proxy 127.0.0.1:30083
}

@ntfy host ntfy.internal.crussell.io
handle @ntfy {
    reverse_proxy 127.0.0.1:8090
}

@dsh host dsh.internal.crussell.io
handle @dsh {
    reverse_proxy 10.10.0.12:3080
}

@trades host trades.internal.crussell.io
handle @trades {
    reverse_proxy 10.10.0.12:8901
}

@nsfw host nsfw.internal.crussell.io
handle @nsfw {
    reverse_proxy 127.0.0.1:8097
}

# FileBrowser Quantum (bee — plans, docs, artifacts)
@files host files.internal.crussell.io
handle @files {
    reverse_proxy 10.10.0.12:8093
}

# Kanban dashboard (bee, user unit hermes-kanban-dashboard) — phone-first
# board UI for Hermes kanban (Lane→kanban migration Phase 3, 2026-09-08).
# Dashboard's own token/basic-auth gate in front.
@kanban host kanban.internal.crussell.io
handle @kanban {
    reverse_proxy 10.10.0.12:9120
}

# Lane (self-hosted Plane CE) RETIRED 2026-09-08 — Hermes kanban is the
# source of truth (kanban.internal.crussell.io). Routes removed; archive
# at NAS /mnt/backups/lane-archive-2026-09-08 (pg dump + uploads).

# Wankbank (bees quadlet — private video catalog)
@wankbank host wankbank.internal.crussell.io
handle @wankbank {
    reverse_proxy 127.0.0.1:3098
}
