# Hub production services (bees — localhost)

@linkding host linkding.internal.crussell.io
handle @linkding {
    reverse_proxy 127.0.0.1:30080
}

@papra host papra.internal.crussell.io
handle @papra {
    reverse_proxy 127.0.0.1:30083
}

@ntfy host ntfy.internal.crussell.io
handle @ntfy {
    reverse_proxy 127.0.0.1:8090
}

@dsh host dsh.internal.crussell.io
handle @dsh {
    reverse_proxy 10.10.0.12:3080
}

@trades host trades.internal.crussell.io
handle @trades {
    reverse_proxy 10.10.0.12:8901
}

@nsfw host nsfw.internal.crussell.io
handle @nsfw {
    reverse_proxy 127.0.0.1:8097
}

# FileBrowser Quantum (bee — plans, docs, artifacts)
@files host files.internal.crussell.io
handle @files {
    reverse_proxy 10.10.0.12:8093
}

# Lane (self-hosted Plane CE) on bees — proxy → 127.0.0.1:8100
@lane host lane.internal.crussell.io
handle @lane {
    reverse_proxy 127.0.0.1:8100
}

# Hermes web dashboard on bee (HML-7): managed hermes-dashboard.service
# (Nebula 10.10.0.12:9120). Auth gate is Hermes' own basic-auth provider
# (HERMES_DASHBOARD_BASIC_AUTH_*) — caddy only terminates TLS. read_timeout
# 360s per beszel.caddy precedent: the dashboard's embedded chat rides a
# long-lived WebSocket and turns can run for minutes.
@dashboard host dashboard.internal.crussell.io
handle @dashboard {
    reverse_proxy 10.10.0.12:9120 {
        transport http {
            read_timeout 360s
        }
    }
}

# Lane webhook bridge: Plane → Hermes webhook adapter (bee :8644).
# Copies X-Plane-Signature → linear-signature so Hermes HMAC verifier
# (hex HMAC-SHA256 of body, Linear format) validates Plane signature
# as-is. Real auth preserved end-to-end (2026-09-07).
@lanehooks host lane-hooks.internal.crussell.io
handle @lanehooks {
    reverse_proxy 10.10.0.12:8644 {
        header_up linear-signature "{http.request.header.X-Plane-Signature}"
        header_up X-GitHub-Event "{http.request.header.X-Plane-Event}"
    }
}

# Wankbank (bees quadlet — private video catalog)
@wankbank host wankbank.internal.crussell.io
handle @wankbank {
    reverse_proxy 127.0.0.1:3098
}
