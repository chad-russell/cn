# Lemmy (bees — native services.lemmy; see hosts/bees/lemmy.nix).
# Routing mirrors the nixpkgs lemmy module's own Caddy block: API /
# image / feed / nodeinfo paths plus POST and ActivityPub-Accept
# requests go to the backend, everything else to lemmy-ui. WebSocket
# upgrades (/api/v3/ws) are automatic in reverse_proxy.
@lemmy host lemmy.internal.crussell.io
handle @lemmy {
    @lemmy_api path /api/* /pictrs/* /feeds/* /nodeinfo/* /.well-known/*
    handle @lemmy_api {
        reverse_proxy 127.0.0.1:8536
    }
    @lemmy_post method POST
    handle @lemmy_post {
        reverse_proxy 127.0.0.1:8536
    }
    # Repeated header matchers on the same field are OR'd by Caddy.
    @lemmy_activity {
        header Accept "application/activity+json"
        header Accept "application/ld+json; profile=\"https://www.w3.org/ns/activitystreams\""
    }
    handle @lemmy_activity {
        reverse_proxy 127.0.0.1:8536
    }
    handle {
        reverse_proxy 127.0.0.1:1234
    }
}
