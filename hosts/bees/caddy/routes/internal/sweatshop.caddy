# sweatshop (bee — user quadlet sweatshop.service, apps/web on 10.10.0.12:3330).
# bees Caddy terminates TLS (wildcard *.internal.crussell.io) and proxies
# sweatshop.internal.crussell.io to bee over Nebula. Chats stream (SSE) —
# flush immediately. No auth on purpose: LAN/Nebula only — never route
# publicly.

@sweatshop host sweatshop.internal.crussell.io
handle @sweatshop {
    reverse_proxy 10.10.0.12:3330 {
        flush_interval -1
    }
}
