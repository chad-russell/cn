# tansweat (bee — user quadlet tansweat.service, apps/web on 10.10.0.12:3330).
# bees Caddy terminates TLS (wildcard *.internal.crussell.io) and proxies
# tansweat.internal.crussell.io to bee over Nebula. Chats stream (SSE) —
# flush immediately. No auth on purpose: LAN/Nebula only — never route
# publicly.

@tansweat host tansweat.internal.crussell.io
handle @tansweat {
    reverse_proxy 10.10.0.12:3330 {
        flush_interval -1
    }
}
