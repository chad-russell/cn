[Unit]
Description=Lane (Plane CE) — PostgreSQL 15
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/postgres:15.7-alpine
ContainerName=plane-db
Exec=postgres -c max_connections=200
# POSTGRES_PASSWORD (+ DATABASE_URL creds for the app units) live in the
# agenix env file (/run/agenix/lane-env).
Environment=POSTGRES_DB=plane
Environment=POSTGRES_USER=plane
Environment=PGDATA=/var/lib/postgresql/data
EnvironmentFile=/run/agenix/lane-env
Volume=lane_pgdata:/var/lib/postgresql/data
# No PublishPort — reachable only inside the lane network.
Network=lane.network
HealthCmd=pg_isready -U plane -d plane
HealthInterval=5s
HealthRetries=12
HealthStartPeriod=10s
HealthTimeout=3s
Notify=healthy

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
