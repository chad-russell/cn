# RustFS — shared S3-compatible object store on nas (2026-09-25).
#
# This is the shared NAS instance that docs/rustfs-migration/PLAN.md
# deferred behind a trigger rule (survives stack teardown / >1 consumer /
# operational weight): central logging is that trigger. First consumer:
# OpenObserve on bees (bucket `openobserve`, parquet only).
#
# Image: pinned to the SAME digest as the proven qrcode-dev sidecar
# (RustFS 1.0.0, amd64). PLAN.md's `rustfs/rustfs:1.0.1` tag does not
# exist on Docker Hub (verified via registry API 2026-09-25); 1.0.0 is
# the newest stable.
#
# Data: SINGLE path /data = /pool/rustfs (btrfs RAID1 underneath is the
# redundancy). The original plan was a multi-directory EC pool, but rustfs
# requires every erasure-set directory on a DISTINCT physical disk
# ([FATAL] "local erasure endpoints must use distinct physical disks" —
# hit live 2026-09-25 with d0..d3 all on the one btrfs fs), and EC across
# a single device adds nothing over btrfs's own mirroring. Same
# single-path shape as the proven qrcode sidecar (Exec=/data).
# Console disabled; debug via awscli (rustfs-bucket-init in rustfs.nix).
[Unit]
Description=RustFS S3 object storage (shared homelab instance)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/rustfs/rustfs@sha256:ba0a1b53e36f321c0d46f3867104abef169f7bc59c467c664ddac87e7ddc9a8b
ContainerName=rustfs
Environment=RUSTFS_ADDRESS=:9000
Environment=RUSTFS_REGION=us-east-1
Environment=RUSTFS_CONSOLE_ENABLE=false
Environment=RUSTFS_HEALTH_ENDPOINT_ENABLE=true
EnvironmentFile=/run/agenix/rustfs-env
PublishPort=10.10.0.3:9000:9000
Volume=/pool/rustfs:/data
Exec=/data
HealthCmd=curl --fail --silent http://127.0.0.1:9000/health/ready
HealthInterval=10s
HealthTimeout=5s
HealthRetries=30
HealthStartPeriod=20s

[Service]
TimeoutStartSec=180
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
