# MinIO (S3-compatible storage) for the polymer quadlet stack.
# NetworkAlias=polymer_minio. No host ports published — only 3000/3001 are
# exposed to the host (the browser-facing app ports).
[Unit]
Description=Polymer quadlet dev stack — MinIO (S3)
# Stop/restart this with the app unit (see polymer-dev-app.container).
PartOf=polymer-dev-app.container

[Container]
Image=docker.io/minio/minio:latest
ContainerName=polymer-quadlet-minio
Network=polymer-dev.network
NetworkAlias=polymer_minio
Environment=MINIO_ROOT_USER=minio
Environment=MINIO_ROOT_PASSWORD=password
Volume=polymer-dev-minio.volume:/data
Exec=server /data --console-address :9001

[Service]
TimeoutStartSec=120
