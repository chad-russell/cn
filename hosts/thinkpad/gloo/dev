#!/usr/bin/env bash
# dev — Gloo project dev-environment dispatcher.
#
# Brings up podman-compose dev stacks with an explicit service list (so the
# repo's alternative services like polymer_web don't auto-start and clash),
# and wraps the common dev actions behind short commands.
#
# Usage:  dev <project> <command>
#   dev polymer up        # db + minio + workspace(pnpm dev)  [hit play]
#   dev polymer down      # stop everything
#   dev polymer logs      # tail the dev server (workspace)
#   dev polymer infra     # db + minio only (no app)
#   dev polymer setup     # one-shot: pnpm install && db:push && db:seed
#   dev polymer migrate   # one-shot: pnpm db:push
#   dev polymer seed      # one-shot: pnpm db:seed
#
# One-shot commands run in a throwaway workspace container (same image +
# toolchain as the dev server, so native modules stay compatible). They bring
# up infra if needed and don't publish ports, so they coexist with a running
# dev server.
set -euo pipefail

proj="${1:-}"
cmd="${2:-up}"

if [ -z "$proj" ] || [ "$proj" = "-h" ] || [ "$proj" = "--help" ]; then
  sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 1
fi

# ---- per-project configuration ----------------------------------------
# To add a project (hb, gpl, ...): add a case block here.
case "$proj" in
  polymer)
    dir="$HOME/Gloo/360-polymer/.devcontainer"
    ov="$HOME/Code/cn/hosts/thinkpad/gloo/overrides/polymer.yml"
    app_svc="app"                                  # compose service key
    app_name="app"                                  # compose service key for logs
    infra="polymer_db polymer_minio"
    all="app polymer_db polymer_minio" ;;
  *)
    echo "unknown project: $proj (configure it in $0)" >&2
    exit 1 ;;
esac

[ -d "$dir" ] || { echo "project not cloned at $dir" >&2; exit 1; }
cd "$dir"

# compose invocation with both files layered
c() { podman compose -f docker-compose.yml -f "$ov" "$@"; }

# run a command in a throwaway app container (same toolchain as dev server)
oneshot() {
  c up -d $infra >/dev/null
  c run --rm --no-deps --name "${proj}_oneshot" "$app_svc" sh -lc "$1"
}

case "$cmd" in
  up)       c up -d $all ;;
  down)     c down ;;
  logs)     c logs -f "$app_name" ;;
  infra)    c up -d $infra ;;
  setup)    oneshot 'pnpm install && pnpm db:push && pnpm db:seed' ;;
  migrate)  oneshot 'pnpm db:push' ;;
  seed)     oneshot 'pnpm db:seed' ;;
  *)
    echo "unknown command: $cmd" >&2
    echo "commands: up down logs infra setup migrate seed" >&2
    exit 1 ;;
esac
