# shellbox aws — AWS CLI (v2)
#
# Provides the `aws` CLI only; runtime cwd, $HOME, and identity come from bwrap.
# The non-secret AWS config (profiles/regions) is vendored at ./config and read
# via AWS_CONFIG_FILE in shellbox.toml. Static credentials and SSO tokens stay
# at the default ~/.aws/ (HOME-relative, bind-mounted into the box by bwrap).

FROM fedora:latest

RUN dnf install -y awscli \
    && dnf clean all

CMD ["aws"]
