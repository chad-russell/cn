# shellbox vicinae — bleeding-edge application launcher, decoupled from the
# host image so its multi-per-week release cadence doesn't force a system
# rebuild. Niri lives on the host (slow COPR); vicinae lives here.
#
# Runtime model (see shellbox.toml, vicinae-launch, and README.md):
#   - vicinae runs inside the box; the apps it lists live on the HOST.
#   - vicinae-launch (vendored here, set as vicinae's `launchPrefix`) spawns
#     apps on the host user systemd manager via `systemd-run --user`, reached
#     through the $XDG_RUNTIME_DIR socket shellbox binds into the box.
#   - [[binds]] in shellbox.toml surface host /usr/share/{applications,icons,
#     fonts} so vicinae can enumerate and render host apps.
#
# `systemd` is installed for `systemd-run` (the host-escape primitive), the
# same reason the `default` box installs it. shellbox does NOT require it
# unless [host] tools are declared (they aren't here) — we use it directly
# from vicinae-launch.

FROM registry.fedoraproject.org/fedora:latest

RUN dnf -y copr enable quadratech188/vicinae \
    && dnf -y install \
         systemd \
         vicinae \
    && dnf clean all

COPY vicinae-launch /usr/local/bin/vicinae-launch
RUN chmod 0755 /usr/local/bin/vicinae-launch
