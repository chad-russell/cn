# shellbox opencode — self-contained opencode (sst/opencode) coding agent
#
# opencode ships as a native precompiled binary; the npm package is just a
# downloader (postinstall copies the platform binary into bin/). So opencode
# does NOT need node at runtime — node+npm here are only for the `npm i -g`
# install step, and remain available so opencode can spawn node-based LSP /
# MCP servers if a project needs them.
#
# Runtime cwd, $HOME, and identity come from bwrap (see shellbox docs); this
# image only provides the agent and its toolchain.

FROM fedora:latest

RUN dnf install -y \
      systemd \
      git ripgrep fd-find \
      jq \
      nodejs npm \
      findutils tar gzip unzip wget curl \
    && dnf clean all

# Install opencode globally. The postinstall script pulls the native binary
# for this platform (opencode-linux-x64).
RUN npm install -g opencode-ai

CMD ["opencode"]
