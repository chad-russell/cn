# MinIO (S3-compatible storage) for the buildspace quadlet stack.
# NetworkAlias=minio. Credentials match docker-compose.local.yml's defaults
# (MINIO_ROOT_USER/PASSWORD from BUILDSPACE_INTERNAL_R2_ACCESS_KEY_ID /
# BUILDSPACE_INTERNAL_R2_SECRET_ACCESS_KEY). No host ports published — reachable
# on the internal network only. The `buildspace-internal` bucket is created
# automatically by dev-server.sh on app start.
[Unit]
Description=Buildspace quadlet dev stack — MinIO (S3)
# Stop/restart this with the app unit (see buildspace-dev-app.container).
PartOf=buildspace-dev-app.container

[Container]
Image=quay.io/minio/minio:RELEASE.2025-02-18T16-25-55Z
ContainerName=buildspace-quadlet-minio
Network=buildspace-dev.network
NetworkAlias=minio
Environment=MINIO_ROOT_USER=buildspace
Environment=MINIO_ROOT_PASSWORD=buildspace123
Volume=buildspace-dev-minio.volume:/data
Exec=server /data --console-address :9001

[Service]
TimeoutStartSec=120
