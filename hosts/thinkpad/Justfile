784|# Enable inbound SSH on the thinkpad (for remote access over Nebula from bee/
785|# bees). Idempotent. (sudo)
786|#
787|# - Installs an /etc/ssh/sshd_config.d drop-in forcing key-only auth.
788|# - Authorizes this host's own ed25519 pub key (the SAME keypair lives on bee
789|#   and bees, so all three hosts can log in here).
790|# - Enables + starts the system sshd. openssh-server ships in the Silverblue
791|#   base image (no host-image change), and `systemctl enable` persists in /etc
792|#   across bootc upgrades, so this survives image rebuilds + reboots.
793|#
794|# Why key-only: crussell has a password set, and sshd binds to ALL interfaces
795|# (Nebula 10.10.0.10 + LAN/WiFi). Disabling password auth avoids opening a new
796|# LAN brute-force surface and matches the gateway posture. To allow password
797|# auth again, delete /etc/ssh/sshd_config.d/10-key-only.conf and restart sshd.
798|#
799|# Connect from bee/bees over Nebula:
800|#   ssh -o IdentitiesOnly=yes crussell@10.10.0.10
801|[group('system')]
802|ssh:
803|    #!/usr/bin/env bash
804|    set -euo pipefail
805|    # 1. Harden: key-only auth drop-in (read by sshd after sshd_config).
806|    dropin=/etc/ssh/sshd_config.d/10-key-only.conf
807|    sudo install -d -m 755 "$(dirname "$dropin")"
808|    printf '%s\n' \
809|      '# Managed by `cjust ssh` (hosts/thinkpad/Justfile). Key-only auth.' \
810|      'PasswordAuthentication no' \
811|      'KbdInteractiveAuthentication no' \
812|      'PermitRootLogin no' \
813|      | sudo tee "$dropin" >/dev/null
814|    sudo chmod 644 "$dropin"
815|    echo "  wrote $dropin (PasswordAuthentication no)"
816|    # 2. Authorize the shared ed25519 key (same keypair on bee/bees/think).
817|    install -d -m 700 "$HOME/.ssh"
818|    pub="$HOME/.ssh/id_ed25519.pub"
819|    auth="$HOME/.ssh/authorized_keys"
820|    touch "$auth"; chmod 600 "$auth"
821|    if [ -s "$pub" ]; then
822|      grep -qF "$(cat "$pub")" "$auth" || cat "$pub" >> "$auth"
823|      echo "  authorized: $(awk '{print $1, $3}' "$pub")"
824|    else
825|      echo "  WARN: $pub missing — no key added (install one manually)" >&2
826|    fi
827|    # 3. Enable + start the system sshd.
828|    sudo systemctl enable --now sshd.service
829|    echo "==> sshd enabled. Connect over Nebula:"
830|    echo "    ssh -o IdentitiesOnly=yes crussell@10.10.0.10"
831|    sudo ss -tlnp 2>/dev/null | grep ':22 ' || true
832|
833|# Show the current state of this machine: host-image version, bootc deployment,
834|# bubblebox mounts + wrappers, opencode install, and linked user units.
835|# Read-only.
836|[group('system')]
837|status:
838|    #!/usr/bin/env bash
839|    set -uo pipefail
840|    echo "=== host image ==="
841|    cat /usr/lib/host-image-thinkpad-version 2>/dev/null || echo "(no version file)"
842|    echo
843|    echo "=== bootc ==="
844|    bootc status 2>&1 | head -30 || true
845|    echo
846|    echo "=== bubblebox mounts ==="
847|    mount | grep '/bubblebox/' || echo "(none mounted)"
848|    echo
849|    echo "=== bubblebox wrappers (~/.local/bin/) ==="
850|    dst_bin="${HOME}/.local/bin"
851|    for t in $(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))'); do
852|      if [ -x "${dst_bin}/${t}" ]; then echo "  ok   ${t}"; else echo "  MISS ${t}"; fi
853|    done
854|    echo
855|    echo "=== opencode (host install) ==="
856|    if command -v opencode >/dev/null 2>&1; then
857|      echo "  $(opencode --version 2>&1 | head -1)"
858|    else
859|      echo "  (not installed — run: cjust opencode-install)"
860|    fi
861|    echo
862|    echo "=== user units (~/.config/systemd/user/) ==="
863|    dst_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
864|    if ls -1 "${dst_dir}"/*.service 2>/dev/null; then :; else echo "(none linked)"; fi
