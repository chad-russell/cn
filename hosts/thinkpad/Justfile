302|# ═══════════════════════════════════════════════════════════════════════════
# cosmic — backup / restore settings (NOT symlinked; cosmic dislikes
# symlinks for its config tree). Files live at ~/.config/cosmic/ normally;
# backup copies into bubblebox/files/.config/cosmic/ for git tracking, restore
306|# copies back.
307|# ═══════════════════════════════════════════════════════════════════════════
308|
309|# Copy settings from ~/.config/cosmic to bubblebox/files/.config/cosmic.
310|# Run this when you've tweaked something in the COSMIC settings UI and want
311|# to save the result to the repo.
312|[group('cosmic')]
313|cosmic-backup:
314|    #!/usr/bin/env bash
315|    set -euo pipefail
316|    src="${HOME}/.config/cosmic"
317|    dst="{{ justfile_directory() }}/bubblebox/files/.config/cosmic"
318|    if [ ! -d "${src}" ]; then
319|      echo "ERROR: ${src} does not exist — nothing to back up." >&2
320|      exit 1
321|    fi
322|    rm -rf "${dst}"
323|    cp -r "${src}" "${dst}"
324|    echo "cosmic settings backed up to ${dst}"
325|
326|# Copy settings from bubblebox/files/.config/cosmic to ~/.config/cosmic.
327|# Run this on a fresh install or to restore a known-good config.
328|# If ~/.config/cosmic is currently a symlink (from the old setup), it is
329|# removed first so COSMIC sees real files.
330|[group('cosmic')]
331|cosmic-restore:
332|    #!/usr/bin/env bash
333|    set -euo pipefail
334|    src="{{ justfile_directory() }}/bubblebox/files/.config/cosmic"
335|    dst="${HOME}/.config/cosmic"
336|    if [ ! -d "${src}" ]; then
337|      echo "ERROR: no saved cosmic settings at ${src}" >&2
338|      exit 1
339|    fi
340|    # If dst is a symlink (old symlink-based setup), remove it so COSMIC
341|    # sees real files.
342|    if [ -L "${dst}" ]; then
343|      echo "  REMOVE symlink ${dst} (old setup)"
344|      rm "${dst}"
345|    fi
346|    rm -rf "${dst}"
347|    cp -r "${src}" "${dst}"
348|    echo "cosmic settings restored to ${dst}"
