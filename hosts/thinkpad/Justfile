# cjust — post-install & maintenance tasks for the thinkpad atomic host.
#
# Entry point is the `cjust` shell function (bubblebox/files/.zshrc):
#   cjust            → fuzzy recipe chooser (`just --choose`, needs fzf)
#   cjust <recipe>   → run a recipe directly
#   cjust -l         → list all recipes
#
# thinkpad-only. Recipes assume a Fedora Silverblue/bootc host with `just` and
# `fzf` baked into the host image (host-image/Containerfile). Both are
# host-native on purpose: `cjust` must work before any tool sandbox is set up,
# and the menu must not depend on the thing it bootstraps.
#
# Recipes are cwd-independent: every path into the repo is built from
# `justfile_directory()`, so `cjust` works from any cwd.
#
# To add a new bubblebox tool / user unit / dotfile, edit `bubblebox/profile.toml`
# (the `[[files]]` and `[[units]]` sections) — no recipe changes needed.

# ═══════════════════════════════════════════════════════════════════════════
# DATA TABLES (single source of truth)
# ═══════════════════════════════════════════════════════════════════════════

# Path to the bubblebox profile — single source of truth for the root list
# (was: a hand-maintained `bubblebox_tools` string that had to be kept in sync
# with this file's `packages` list). Recipes below read this via a python3
# one-liner at runtime (tomllib is in stdlib since 3.11; the host image ships
# python3). `bubblebox build` gracefully skips any "virtual entrypoint" whose
# `package` field points at another package (e.g. age-keygen → age) — no
# Containerfile of its own to build, no error.
bubblebox_profile := justfile_directory() + "/bubblebox/profile.toml"

# bubblebox engine dir (the Rust CLI binary + fuse-mount + shared bin/). The
# package source tree (Containerfiles + entrypoints) is a separate repo at
# ~/Code/bubblebox-pkgs, registered via profile.toml below.
# Hardcoded to $HOME/Code/bubblebox (deliberate — this Justfile is thinkpad-
# specific, and the layout matches the rest of the cn repo).
bubblebox_dir := env_var_or_default("HOME", "/tmp") + "/Code/bubblebox"
# The Rust CLI binary (the single entry point; bash scripts are retired).
# Build it with `cargo build --release` at the workspace root (use the dev
# toolbox for the toolchain). Re-run `cjust bubblebox-export` after rebuilding
# to refresh the ~/.local/bin wrappers' baked-in path.
bubblebox_bin := bubblebox_dir + "/target/release/bubblebox"

# ═══════════════════════════════════════════════════════════════════════════
# setup
# ═══════════════════════════════════════════════════════════════════════════

# Host-resident dotfiles and systemd user units are now managed by bubblebox
# itself (Phase B/C). `cjust bubblebox-apply` handles them alongside packages:
#   - `[[files]]` in bubblebox/profile.toml → content-addressed store symlinks
#   - `[[units]]` in bubblebox/profile.toml → systemd user unit symlinks + systemctl
# The old `cjust link` and `cjust units` recipes are retired — the declarative
# profile is the single source of truth.

# Full first-run setup: all bubblebox tools + opencode. Run this on a fresh
# install (after the host image is booted). Idempotent. The bubblebox SOURCE
# is declared in bubblebox/profile.toml (profile-authoritative) — no separate
# `source add` step. Dotfiles and units are applied by `bubblebox-apply`.
# Note: `opencode-install` requires nodejs/npm on the host (added to the
# host image in mid-2026). If you're on an older image, that step fails
# harmlessly — complete the host-image rebuild + reboot, then re-run setup.
[group('setup')]
setup: bubblebox opencode-install
    @echo "==> Setup complete."
    @echo "    If host-image deps changed (just/fzf/nodejs/npm), rebuild & reboot:"
    @echo "      cjust image-build && cjust image-upgrade && systemctl reboot"

# GNOME tweak to allow for mod + <right-click> to resize, like how it works in niri or Cosmic
[group('setup')]
gnome-right-click-resize:
    #!/usr/bin/env bash
    gsettings set org.gnome.desktop.wm.preferences resize-with-right-button "true"

# Install the Papirus icon theme into the per-user icons dir and make it the
# active icon theme for GNOME and Niri/GTK apps. Idempotent — re-running
# rebuilds from current HEAD and re-applies the settings.
#
# Method: build in a throwaway podman container from git HEAD, then copy only
# the final icon dirs out to ~/.local/share/icons. Containerizing keeps all
# build cruft (git clone, dnf, make) off the host — only the rendered icons
# land on disk. We build from git HEAD because the GitHub *release* tag lags
# ~a year behind master, and active icon updates only land on master.
#
# Kept out of the host image on purpose — icons are easy to iterate on per-user
# and don't deserve an image rebuild + reboot cycle. (Niri has no icon-theme
# knob in config.kdl — it's a cursor compositor, not a theming layer. GTK apps
# under Niri read ~/.config/gtk-{3,4}.0/settings.ini for icon-theme-name; GNOME
# reads org.gnome.desktop.interface via dconf. Both are set here so the theme
# sticks in either session.)
[group('setup')]
icons:
    #!/usr/bin/env bash
    set -euo pipefail
    icons_dir="${HOME}/.local/share/icons"
    image="docker.io/library/fedora:44"
    mkdir -p "${icons_dir}"
    stage="$(mktemp -d)"
    trap 'rm -rf "${stage}"' EXIT
    # Build in a throwaway podman container so the host never sees git/dnf/make
    # artifacts — only the final icon dirs are copied out. `make install` for
    # Papirus is literally a `cp -R` of the pre-rendered Papirus{,-Dark,-Light}
    # dirs into the staging prefix; HEAD tracks active updates that the stale
    # release tag misses.
    echo "==> building Papirus from git HEAD in a podman container..."
    podman run --rm -v "${stage}:/out:Z" "${image}" bash -c '
      set -euo pipefail
      dnf install -y git make >/dev/null 2>&1
      git clone --depth 1 --quiet https://github.com/PapirusDevelopmentTeam/papirus-icon-theme.git /work/p
      make -C /work/p -s install DESTDIR=/out PREFIX=/usr
      echo "  HEAD $(git -C /work/p rev-parse --short HEAD) ($(git -C /work/p log -1 --format=%cd --date=short))"
    '
    src="${stage}/usr/share/icons"
    [ -f "${src}/Papirus/index.theme" ] || { echo "ERROR: ${src}/Papirus/index.theme missing" >&2; exit 1; }
    for v in Papirus Papirus-Dark Papirus-Light; do
      rm -rf "${icons_dir}/${v}"
      cp -r "${src}/${v}" "${icons_dir}/${v}"
    done
    echo "  installed -> ${icons_dir}/{Papirus,Papirus-Dark,Papirus-Light}"
    # GNOME (and GTK apps that read dconf via gsd / xdg-desktop-portal-gnome):
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus'
    echo "  set gsettings org.gnome.desktop.interface icon-theme=Papirus"
    # Niri / GTK3 / GTK4 without a GNOME settings daemon: settings.ini is what
    # GTK actually consults for icon-theme-name in those sessions.
    for v in gtk-3.0 gtk-4.0; do
      ini="${HOME}/.config/${v}/settings.ini"
      mkdir -p "$(dirname "${ini}")"
      touch "${ini}"
      if grep -q '^gtk-icon-theme-name=' "${ini}"; then
        sed -i 's|^gtk-icon-theme-name=.*|gtk-icon-theme-name=Papirus|' "${ini}"
      else
        grep -q '^\[Settings\]' "${ini}" || printf '[Settings]\n' >> "${ini}"
        printf 'gtk-icon-theme-name=Papirus\n' >> "${ini}"
      fi
      echo "  set ${v}/settings.ini gtk-icon-theme-name=Papirus"
    done
    echo "==> Papirus is now the active icon theme (GNOME + Niri/GTK)."

# Cap Zen Browser's memory via a cgroup v2 soft limit, by overriding its
# flatpak desktop file to launch through the `zen-browser` wrapper script
# (deployed by `bubblebox apply` to ~/.local/bin/). Idempotent — re-running
# re-derives from the current flatpak export (so Zen desktop-file updates
# flow through) and rewrites the override.
#
# Why a wrapper, not `systemd-run --scope -p MemoryHigh=...` in Exec=:
# flatpak calls StartTransientScope itself via its session helper, creating
# `app-flatpak-<appid>-<id>.scope` as a SIBLING under app.slice. An outer
# scope we wrap the launch in is bypassed — the browser escapes with
# MemoryHigh=infinity (verified empirically). The only reliable attachment
# point is flatpak's own scope, which the wrapper polls for and caps with
# `systemctl --user set-property --runtime` once it appears. The wrapper
# also re-caps an already-running instance if the launch forwarded to one.
#
# Why MemoryHigh (not MemoryMax): MemoryHigh is a cgroup v2 *soft* limit.
# When the scope exceeds it, the kernel aggressively reclaims pages inside
# it (swap → zram) and emits PSI memory-pressure events, but never OOM-kills.
# Firefox/Zen's nsAvailableMemoryWatcher reacts to PSI by unloading tabs —
# so the browser self-governs as if the box only has $mem RAM, which is the
# goal: stop it from eating everything before its own unload logic kicks in,
# without ever killing it. MemoryMax would OOM-kill the whole browser;
# MemoryHigh just throttles/reclaims.
#
# The wrapper script (bubblebox/files/.local/bin/zen-browser) is generic — it reads
# the limit from ZEN_MEMHIGH. This recipe generates only the desktop override,
# baking the limit into an `env ZEN_MEMHIGH=$mem` prefix on each Exec= line,
# so `cjust zen-memlimit 12G` regenerates with the new value without touching
# the wrapper. The override is host-local regenerable state (NOT a symlinked
# dotfile) — Zen's desktop file ships hundreds of i18n lines and changes
# across versions, so the source of truth is THIS recipe (version-controlled).
# Clear with `cjust zen-memlimit-clear`.
#
# Default is 16G on a 32G host; pass any systemd size, e.g. `cjust zen-memlimit 12G`.
# NOTE: this recipe generates the override for FUTURE launches. A currently
# running Zen instance keeps whatever MemoryHigh its scope had at attach time
# — cap it live with:
#   scope=$(systemctl --user list-units --type=scope --all --no-legend | \
#           awk '/app-flatpak-app\.zen_browser\.zen-[0-9]+\.scope/{print $1}')
#   systemctl --user set-property --runtime "$scope" MemoryHigh=16G
[group('setup')]
zen-memlimit mem="16G":
    #!/usr/bin/env bash
    set -euo pipefail
    appid="app.zen_browser.zen"
    # Resolve the original desktop file from the flatpak export (system install
    # first, then per-user). Reading from the export — not a prior override —
    # keeps this idempotent and lets Zen desktop-file updates flow through.
    src=""
    for cand in \
      "/var/lib/flatpak/exports/share/applications/${appid}.desktop" \
      "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share/applications/${appid}.desktop"; do
      if [ -e "$cand" ]; then src="$cand"; break; fi
    done
    if [ -z "$src" ]; then
      echo "ERROR: no ${appid}.desktop in flatpak exports — is Zen installed?" >&2
      exit 1
    fi
    wrapper="${HOME}/.local/bin/zen-browser"
    if [ ! -x "$wrapper" ]; then
      echo "ERROR: ${wrapper} missing or not executable — run 'cjust bubblebox-apply' first." >&2
      exit 1
    fi
    dst_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    dst="${dst_dir}/${appid}.desktop"
    mkdir -p "$dst_dir"
    # Rewrite every Exec= line: drop flatpak's run-prefix + appid, keep the
    # per-action flags + file-forwarding markers, prepend an env ZEN_MEMHIGH
    # + the wrapper path. `.*app\.zen_browser\.zen ` is robust to changes in
    # flatpak's run flags; if the appid token itself ever moves, the line is
    # left untouched (safe — just no limit until the recipe is updated).
    sed -E "s|^Exec=.*app\\.zen_browser\\.zen (.*)$|Exec=env ZEN_MEMHIGH={{ mem }} ${wrapper} \\1|g" "$src" > "$dst"
    update-desktop-database "$dst_dir" 2>/dev/null || true
    echo "Wrote ${dst}"
    echo "  source:     ${src}"
    echo "  wrapper:    ${wrapper}"
    echo "  MemoryHigh: {{ mem }} (cgroup v2 soft limit; no OOM kill)"
    echo
    echo "Future launches from the menu are capped. Verify after relaunch:"
    echo "  systemctl --user show app-flatpak-${appid}-*.scope -p MemoryHigh -p MemoryMax   # MemoryHigh=..., MemoryMax=infinity"
    echo "  grep -E 'some|full' /proc/pressure/memory                                      # PSI rises as Zen grows past {{ mem }}"

# Remove the Zen memory override; Zen falls back to its stock flatpak desktop
# file (unlimited). Idempotent.
[group('setup')]
zen-memlimit-clear:
    #!/usr/bin/env bash
    set -euo pipefail
    appid="app.zen_browser.zen"
    dst_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    dst="${dst_dir}/${appid}.desktop"
    if [ -e "$dst" ]; then
      rm "$dst"
      update-desktop-database "$dst_dir" 2>/dev/null || true
      echo "Removed ${dst} — Zen now uses the stock flatpak desktop file."
    else
      echo "No override at ${dst} (nothing to do)."
    fi

# ═══════════════════════════════════════════════════════════════════════════
# cosmic — backup / restore settings (NOT symlinked; cosmic dislikes
# symlinks for its config tree). Files live at ~/.config/cosmic/ normally;
# backup copies into bubblebox/files/.config/cosmic/ for git tracking, restore
# copies back.
# ═══════════════════════════════════════════════════════════════════════════

# Copy settings from ~/.config/cosmic to bubblebox/files/.config/cosmic.
# Run this when you've tweaked something in the COSMIC settings UI and want
# to save the result to the repo.
[group('cosmic')]
cosmic-backup:
    #!/usr/bin/env bash
    set -euo pipefail
    src="${HOME}/.config/cosmic"
    dst="{{ justfile_directory() }}/bubblebox/files/.config/cosmic"
    if [ ! -d "${src}" ]; then
      echo "ERROR: ${src} does not exist — nothing to back up." >&2
      exit 1
    fi
    rm -rf "${dst}"
    cp -r "${src}" "${dst}"
    echo "cosmic settings backed up to ${dst}"

# Copy settings from bubblebox/files/.config/cosmic to ~/.config/cosmic.
# Run this on a fresh install or to restore a known-good config.
# If ~/.config/cosmic is currently a symlink (from the old setup), it is
# removed first so COSMIC sees real files.
[group('cosmic')]
cosmic-restore:
    #!/usr/bin/env bash
    set -euo pipefail
    src="{{ justfile_directory() }}/bubblebox/files/.config/cosmic"
    dst="${HOME}/.config/cosmic"
    if [ ! -d "${src}" ]; then
      echo "ERROR: no saved cosmic settings at ${src}" >&2
      exit 1
    fi
    # If dst is a symlink (old symlink-based setup), remove it so COSMIC
    # sees real files.
    if [ -L "${dst}" ]; then
      echo "  REMOVE symlink ${dst} (old setup)"
      rm "${dst}"
    fi
    rm -rf "${dst}"
    cp -r "${src}" "${dst}"
    echo "cosmic settings restored to ${dst}"

# ═══════════════════════════════════════════════════════════════════════════
# bubblebox tools
# ═══════════════════════════════════════════════════════════════════════════
#
# bubblebox auto-mounts each tool on first run (rootless FUSE). The recipes
# below are: init (build FUSE server, one-time), build (per-tool image +
# composefs descriptor), export (per-tool wrapper at ~/.local/bin/).

# Build the FUSE server binary in a container (no host rust toolchain needed).
# Idempotent — cargo build is incremental.
[group('bubblebox')]
bubblebox-init:
    {{ bubblebox_bin }} init

# Build each tool's image + composefs descriptor. With no args, builds all
# tools from `bubblebox_tools`; with args, builds only the named tools, e.g.
# `cjust bubblebox-build wezterm`.
#
# Tool source dirs resolve from the registered bubblebox SOURCE (declared in
# bubblebox/profile.toml — profile-authoritative, so no `source add` needed).
[group('bubblebox')]
bubblebox-build *tools:
    #!/usr/bin/env bash
    set -euo pipefail
    tools="{{ tools }}"
    if [ -z "${tools}" ]; then
      tools=$(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))')
    fi
    for t in $tools; do
      echo "==> bubblebox-build ${t}"
      {{ bubblebox_bin }} build "$t"
    done

# Generate one wrapper per tool at ~/.local/bin/<tool>. With no args, exports
# all tools; with args, exports only the named tools.
# Idempotent — overwrites with the current binary path.
[group('bubblebox')]
bubblebox-export *tools:
    #!/usr/bin/env bash
    set -euo pipefail
    tools="{{ tools }}"
    if [ -z "${tools}" ]; then
      tools=$(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))')
    fi
    for t in $tools; do
      {{ bubblebox_bin }} export "$t"
    done
    echo
    echo "Wrappers at ~/.local/bin/ (already on PATH via bubblebox/files/.zshenv)."

# Realize the declarative profile (bubblebox/profile.toml): sync it to
# ~/.config/bubblebox/, then `bubblebox apply` — resolve inputs (local
# descriptors for built tools, or `bubblebox apply --refresh` against a cache),
# write/refresh profile.lock + a generation, self-migrate descriptors to the
# Phase-1 digest-addressed layout, materialize bindings, and sync ~/.local/bin
# wrappers. The declarative counterpart to bubblebox-build + bubblebox-export:
# build (or pull) populates the store; apply declares what's active.
[group('bubblebox')]
bubblebox-apply:
    #!/usr/bin/env bash
    set -euo pipefail
    # Sync profile.toml + the files/ and units/ source trees to the config dir
    # (bubblebox reads profile.toml from there, and resolves [[files]]/[[units]]
    # source paths relative to it).
    install -Dm644 "{{ justfile_directory() }}/bubblebox/profile.toml" "$HOME/.config/bubblebox/profile.toml"
    rsync -a --delete \
      "{{ justfile_directory() }}/bubblebox/files/" \
      "$HOME/.config/bubblebox/files/"
    rsync -a --delete \
      "{{ justfile_directory() }}/bubblebox/units/" \
      "$HOME/.config/bubblebox/units/"
    {{ bubblebox_bin }} apply

# Reclaim store bytes no generation/binding/mount references. Dry-run by
# default (reclaims nothing until you prune old generations —
# `{{ bubblebox_bin }} generations --older-than 30d`). Pass `apply` to sweep.
[group('bubblebox')]
bubblebox-gc *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{ args }}" = "apply" ]; then
      {{ bubblebox_bin }} gc --apply
    else
      {{ bubblebox_bin }} gc
    fi

# Init + build + apply in one shot. The thing to run on a fresh install or
# after pulling changes that touch tool configs. (Source registration + wrapper
# export are both handled by `apply` via the declarative profile.)
[group('bubblebox')]
bubblebox: bubblebox-init bubblebox-build bubblebox-apply
    @echo "==> bubblebox: FUSE server built, tools built, profile applied."

# ═══════════════════════════════════════════════════════════════════════════
# opencode (host install)
# ═══════════════════════════════════════════════════════════════════════════
#
# opencode runs on the host directly (not in bubblebox) because it's the AI
# coding agent — it needs full host control when something breaks, without
# sandbox restrictions getting in the way of recovery. Vendored config lives
# at bubblebox/files/.config/opencode/ (symlinked by `bubblebox apply`); secrets stay
# machine-local at ~/.local/share/opencode/auth.json (gitignored by virtue
# of being outside the vendored tree).

# Install opencode globally via npm. Silverblue's /usr/local is read-only, so
# npm's prefix is set to ~/.local — opencode lands at ~/.local/bin/opencode
# (already on PATH). Re-run after `cjust image-upgrade` to pick up new versions.
[group('opencode')]
opencode-install:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v npm >/dev/null 2>&1; then
      echo "ERROR: npm not found on host." >&2
      echo "       Rebuild the host image with nodejs+npm, reboot, then re-run." >&2
      exit 1
    fi
    npm config set prefix "$HOME/.local"
    npm install -g opencode-ai
    echo
    echo "opencode installed to ~/.local/bin/opencode"
    # First-time auth (or after wiping ~/.local/share/opencode/auth.json):
    #   opencode auth login

# ═══════════════════════════════════════════════════════════════════════════
# hermes (host install + off-host desktop build)
# ═══════════════════════════════════════════════════════════════════════════
#
# Like opencode, hermes runs on the host directly (NOT in bubblebox) — it's an
# AI agent and needs full host control to edit files and run tools in the
# user's working directory. See hosts/thinkpad/README.md ("opencode and hermes
# are the exceptions"). The CLI/TUI come from the official installer; the
# desktop GUI is built off-host in a throwaway container (the `cjust icons`
# Papirus pattern), keeping Electron's ~200 MB of build cruft off the host.
#
# Secrets: provider keys live in secrets/hermes-thinkpad-env.age (agenix),
# decrypted into a per-login tmpfs by bubblebox/files/.zshenv. The desktop wrapper at
# bubblebox/files/.local/bin/hermes-desktop sources that cache so compositor-launched
# GUI sees the keys too (shells already get them via .zshenv).

# Install the hermes CLI/TUI via the official installer. Lays down
# ~/.local/bin/hermes (already on PATH via .zshenv) and self-manages
# ~/.hermes/hermes-agent/ (Python venv + Node + ripgrep + ffmpeg). Re-run after
# `cjust image-upgrade` or any `hermes uninstall` to pick up a fresh install.
# `hermes update` (run by hermes itself) handles in-place upgrades thereafter.
[group('hermes')]
hermes-install:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v curl >/dev/null 2>&1; then
      echo "ERROR: curl not found on host." >&2
      echo "       Rebuild the host image, reboot, then re-run." >&2
      exit 1
    fi
    curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash
    echo
    echo "hermes installed to ~/.local/bin/hermes"
    # First-time setup (provider config, model pick): the OPENAI_API_KEY env
    # var is already exported by .zshenv (from secrets/hermes-thinkpad-env.age).
    # To point hermes at the Z.AI coding endpoint (OpenAI-compatible), declare
    # a custom provider in ~/.hermes/config.yaml:
    #   hermes config set custom_providers '[{name:zai-coding,base_url:https://api.z.ai/api/coding/paas/v4,key_env:OPENAI_API_KEY}]'
    #   hermes config set model.provider zai-coding
    #   hermes config set model.default glm-5.3

# Build the hermes desktop (Electron) app OFF-HOST in a throwaway Fedora+Node
# podman container, then copy only the unpacked app dir onto the host. Mirrors
# `cjust icons` (Papirus): containerizing keeps Electron's build cruft
# (~200 MB node_modules, the Electron download, gcc-c++/make) off the host, so
# no host-image change or reboot is needed. Idempotent; re-run any time, e.g.
# after `hermes update` bumps the source tree.
#
# Output: ~/.local/share/hermes-desktop/ (the unpacked Electron dir). Launch
# via ~/.local/bin/hermes-desktop (wrapper that sources the cn-secrets cache so
# the compositor-launched GUI sees provider keys) or the "Hermes" launcher entry
# (bubblebox/files/.local/share/applications/hermes.desktop, symlinked by `bubblebox apply`).
#
# Why not bubblebox: hermes is an AI coding agent (same category as opencode) —
# its tool backend spawns synchronous subprocesses in arbitrary host cwds with
# I/O capture, which has no precedent in the bubblebox tree and fights the
# sandbox's read-only / content-addressed model. See README for the long version.
[group('hermes')]
hermes-desktop-build:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v hermes >/dev/null 2>&1; then
      echo "ERROR: hermes not found — run 'cjust hermes-install' first." >&2
      exit 1
    fi
    if [ ! -d "$HOME/.hermes/hermes-agent" ]; then
      echo "ERROR: ~/.hermes/hermes-agent missing — run 'cjust hermes-install' first." >&2
      exit 1
    fi
    dest="$HOME/.local/share/hermes-desktop"
    stage="$(mktemp -d)"
    trap 'rm -rf "${stage}"' EXIT
    # Build inside a throwaway container against the host's hermes-agent
    # checkout. We invoke npm directly (the same path `hermes desktop
    # --build-only` runs internally) instead of the hermes CLI: the venv's
    # `hermes` script has a host-absolute shebang and won't resolve inside the
    # container. electron-builder's `--dir` flag emits release/linux-unpacked/
    # (the unpacked Electron app, no installers). Native Node modules need
    # gcc-c++/make (Fedora — NOT build-essential, which is a Debian-ism).
    echo "==> building hermes-desktop in a throwaway podman container..."
    podman run --rm \
      -v "$HOME/.hermes/hermes-agent:/work:Z" \
      -v "${stage}:/out:Z" \
      docker.io/library/fedora:latest \
      bash -c '
        set -euo pipefail
        # Fedora build deps. build-essential does not exist on Fedora (Debian
        # only); gcc-c++ + make are the Fedora equivalents and what npm needs
        # for native modules. python3 is required by node-gyp.
        dnf install -y --quiet nodejs npm gcc-c++ make python3 git
        cd /work
        echo "--- npm install (workspace from repo root) ---"
        npm install --no-fund --no-audit
        # npm sometimes fails to set the exec bit on `bin` script targets when
        # installing on a bind-mounted volume (cross-env, electron-builder, etc.
        # show up as `Permission denied` / exit 126 on invocation). Walk every
        # node_modules/.bin/* symlink and chmod its target. No-op when npm got
        # it right; rescue when it did not.
        for link in node_modules/.bin/*; do
          [ -L "$link" ] || continue
          tgt=$(readlink -f "$link") && [ -f "$tgt" ] && chmod +x "$tgt" 2>/dev/null || true
        done
        echo "--- npm run pack (apps/desktop, electron-builder --dir) ---"
        cd apps/desktop
        npm run pack
        # electron-builder --dir emits release/linux-unpacked/.
        if [ -d release/linux-unpacked ]; then
          cp -a release/linux-unpacked /out/hermes-desktop
        else
          echo "ERROR: release/linux-unpacked/ missing after pack" >&2
          find release -maxdepth 2 -type d >&2 || true
          exit 1
        fi
        echo "  built -> /out/hermes-desktop"
      '
    # Install the built dir onto the host.
    rm -rf "${dest}"
    mkdir -p "$(dirname "${dest}")"
    cp -a "${stage}/hermes-desktop" "${dest}"
    # Locate the Electron binary inside the unpacked dir. electron-builder
    # names the main binary after productName (Hermes), but linux-unpacked/
    # also contains chrome-sandbox, chrome_crashpad_handler, libEGL.so, etc.
    # that are executable but not the app. Same exclusion logic as the
    # ~/.local/bin/hermes-desktop wrapper.
    bin=""
    for cand in "${dest}/hermes" "${dest}/Hermes" "${dest}/hermes-desktop"; do
      if [ -x "$cand" ]; then bin="$cand"; break; fi
    done
    if [ -z "$bin" ]; then
      bin="$(find "${dest}" -maxdepth 1 -type f -executable \
              ! -name 'chrome-sandbox' ! -name '*crashpad*' ! -name 'vulkan_*' ! -name 'lib*' \
              2>/dev/null | head -1 || true)"
    fi
    if [ -z "$bin" ]; then
      echo "WARNING: no main app binary found inside ${dest}." >&2
      echo "         Contents:" >&2
      ls -la "${dest}" >&2
    else
      echo "  main binary: ${bin#${dest}/}"
    fi
    echo "==> hermes-desktop installed to ${dest}"
    echo
    echo "Launch via:"
    echo "  hermes desktop --skip-build      # upstream launcher (uses ~/.hermes)"
    echo "  ~/.local/bin/hermes-desktop      # host wrapper (sources cn-secrets env first)"
    echo "  Launcher → 'Hermes'              # the .desktop entry (run 'cjust bubblebox-apply' to install)"
    # Refresh the launcher icon (Icon=hermes) so a rebuild always leaves a
    # branded icon in place. Idempotent + non-fatal.
    {{ just_executable() }} hermes-icon || echo "  (hermes-icon skipped)"

# Install the official Hermes launcher icon (Icon=hermes) from the upstream
# hermes-agent repo into the user hicolor theme, so the .desktop entry shows the
# branded Hermes glyph instead of a generic info icon. Idempotent; re-run any
# time, and invoked automatically at the tail of `cjust hermes-desktop-build`.
# Mirrors the `cjust icons` (Papirus) pattern: per-user, off the host image.
#
# IMPORTANT: GNOME/GTK only scan STANDARD hicolor size dirs (16..512, per the
# system /usr/share/icons/hicolor/index.theme). The upstream icon.png is
# 1024x1024 — non-standard, so a copy in 1024x1024/ is INVISIBLE to GNOME (the
# app shows a generic gear). We therefore install downscaled copies at 512x512
# and 256x256. ImageMagick (magick/convert) does a real resize; if absent we
# just copy the source into each dir (GNOME scales the loaded image to the
# requested size regardless of the declared dir size, so that still works — the
# only thing that matters is landing in a standard dir).
[group('hermes')]
hermes-icon:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp="$(mktemp)"; trap 'rm -f "${tmp}"' EXIT
    url="https://raw.githubusercontent.com/NousResearch/hermes-agent/main/apps/desktop/assets/icon.png"
    curl -fsSL "${url}" -o "${tmp}"
    base="${HOME}/.local/share/icons/hicolor"
    for s in 512 256; do
      dir="${base}/${s}x${s}/apps"
      mkdir -p "${dir}"
      if command -v magick >/dev/null 2>&1; then
        magick "${tmp}" -resize ${s}x${s} "${dir}/hermes.png"
      elif command -v convert >/dev/null 2>&1; then
        convert "${tmp}" -resize ${s}x${s} "${dir}/hermes.png"
      else
        cp -f "${tmp}" "${dir}/hermes.png"
      fi
      echo "  ${s}x${s}/apps/hermes.png"
    done
    # Drop a stale non-standard 1024x1024 copy from an older recipe version
    # (GNOME ignores that dir, so it only wastes space).
    rm -rf "${base}/1024x1024"
    gtk-update-icon-cache -f -t "${base}" 2>/dev/null || true
    echo "==> hermes icon installed at standard sizes (512x512, 256x256; Icon=hermes)"

# host image (bootc)
# ═══════════════════════════════════════════════════════════════════════════
#
# The NORMAL flow is registry-driven, built on bees:
#   bees builds + publishes 10.10.0.6:5000/cn/thinkpad-host:44 daily
#   (thinkpad-image-build.timer, hosts/bees/thinkpad-registry.nix), keeping
#   the last 3 immutable tags. `cjust image-rebuild` triggers a build NOW;
#   `cjust image-upgrade` pulls the diff and stages it; reboot applies.
#
# The LOCAL flow (build.sh into root podman storage) remains as break-glass
# while bees/Nebula is down, or for testing image changes pre-registry.

# Trigger a build on bees NOW and wait for it, then pull + stage the result.
# The "I pushed to origin/main and want it on the laptop today" command.
# Requires: SSH key to bees (same ed25519 as elsewhere) + Nebula up.
# The build pulls origin/main on bees (your local commits must be pushed
# first) and pushes :44 + an immutable 44-<sha>-<ts> tag to zot.
[group('host image')]
image-rebuild:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> triggering build on bees (this pulls origin/main there) ..."
    ssh -o IdentitiesOnly=yes crussell@10.10.0.6 \
      'sudo systemctl start --no-block thinkpad-image-build.service && sudo journalctl -u thinkpad-image-build.service -f -n 0 -o cat'
    echo
    echo "==> build published; pulling + staging on this host"
    {{ just_executable() }} --justfile "{{ justfile_directory() }}/Justfile" image-upgrade

# One-time: adopt the bees registry image as the host's boot image. (sudo)
# Only for first adoption or changing image reference; for routine updates
# use `image-upgrade`. Reboot after. See host-image/switch.sh.
[group('host image')]
image-switch:
    {{ justfile_directory() }}/host-image/switch.sh

# Routine: pull the latest :44 from bees's registry + stage a new deployment.
# (sudo) Downloads only changed layers. Reboot to go live.
[group('host image')]
image-upgrade:
    {{ justfile_directory() }}/host-image/upgrade.sh

# BREAK-GLASS: build the image locally on this host (sudo). The normal flow
# builds on bees. First time on a fresh host, follow with `image-switch`.
[group('host image')]
image-build:
    {{ justfile_directory() }}/host-image/build.sh

