350|# ═══════════════════════════════════════════════════════════════════════════
351|# bubblebox tools
352|# ═══════════════════════════════════════════════════════════════════════════
353|#
354|# bubblebox auto-mounts each tool on first run (rootless FUSE). The recipes
355|# below are: init (build FUSE server, one-time), build (per-tool image +
356|# composefs descriptor), export (per-tool wrapper at ~/.local/bin/).
357|
358|# Build the FUSE server binary in a container (no host rust toolchain needed).
359|# Idempotent — cargo build is incremental.
360|[group('bubblebox')]
361|bubblebox-init:
362|    {{ bubblebox_bin }} init
363|
364|# Build each tool's image + composefs descriptor. With no args, builds all
365|# tools from `bubblebox_tools`; with args, builds only the named tools, e.g.
366|# `cjust bubblebox-build wezterm`.
367|#
368|# Tool source dirs resolve from the registered bubblebox SOURCE (declared in
369|# bubblebox/profile.toml — profile-authoritative, so no `source add` needed).
370|[group('bubblebox')]
371|bubblebox-build *tools:
372|    #!/usr/bin/env bash
373|    set -euo pipefail
374|    tools="{{ tools }}"
375|    if [ -z "${tools}" ]; then
376|      tools=$(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))')
377|    fi
378|    for t in $tools; do
379|      echo "==> bubblebox-build ${t}"
380|      {{ bubblebox_bin }} build "$t"
381|    done
382|
383|# Generate one wrapper per tool at ~/.local/bin/<tool>. With no args, exports
384|# all tools; with args, exports only the named tools.
385|# Idempotent — overwrites with the current binary path.
386|[group('bubblebox')]
387|bubblebox-export *tools:
388|    #!/usr/bin/env bash
389|    set -euo pipefail
390|    tools="{{ tools }}"
391|    if [ -z "${tools}" ]; then
392|      tools=$(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))')
393|    fi
394|    for t in $tools; do
395|      {{ bubblebox_bin }} export "$t"
396|    done
397|    echo
398|    echo "Wrappers at ~/.local/bin/ (already on PATH via bubblebox/files/.zshenv)."
399|
400|# Realize the declarative profile (bubblebox/profile.toml): sync it to
401|# ~/.config/bubblebox/, then `bubblebox apply` — resolve inputs (local
402|# descriptors for built tools, or `bubblebox apply --refresh` against a cache),
403|# write/refresh profile.lock + a generation, self-migrate descriptors to the
404|# Phase-1 digest-addressed layout, materialize bindings, and sync ~/.local/bin
405|# wrappers. The declarative counterpart to bubblebox-build + bubblebox-export:
406|# build (or pull) populates the store; apply declares what's active.
407|[group('bubblebox')]
408|bubblebox-apply:
409|    #!/usr/bin/env bash
410|    set -euo pipefail
411|    install -Dm644 "{{ justfile_directory() }}/bubblebox/profile.toml" "$HOME/.config/bubblebox/profile.toml"
412|    {{ bubblebox_bin }} apply
413|
414|# Reclaim store bytes no generation/binding/mount references. Dry-run by
415|# default (reclaims nothing until you prune old generations —
416|# `{{ bubblebox_bin }} generations --older-than 30d`). Pass `apply` to sweep.
417|[group('bubblebox')]
418|bubblebox-gc *args:
419|    #!/usr/bin/env bash
420|    set -euo pipefail
421|    if [ "{{ args }}" = "apply" ]; then
422|      {{ bubblebox_bin }} gc --apply
423|    else
424|      {{ bubblebox_bin }} gc
425|    fi
426|
427|# Init + build + apply in one shot. The thing to run on a fresh install or
428|# after pulling changes that touch tool configs. (Source registration + wrapper
429|# export are both handled by `apply` via the declarative profile.)
430|[group('bubblebox')]
431|bubblebox: bubblebox-init bubblebox-build bubblebox-apply
432|    @echo "==> bubblebox: FUSE server built, tools built, profile applied."
433|
434|# ═══════════════════════════════════════════════════════════════════════════
435|# opencode (host install)
436|# ═══════════════════════════════════════════════════════════════════════════
437|#
438|# opencode runs on the host directly (not in bubblebox) because it's the AI
439|# coding agent — it needs full host control when something breaks, without
440|# sandbox restrictions getting in the way of recovery. Vendored config lives
441|# at bubblebox/files/.config/opencode/ (symlinked by `bubblebox apply`); secrets stay
442|# machine-local at ~/.local/share/opencode/auth.json (gitignored by virtue
443|# of being outside the vendored tree).
444|
445|# Install opencode globally via npm. Silverblue's /usr/local is read-only, so
446|# npm's prefix is set to ~/.local — opencode lands at ~/.local/bin/opencode
447|# (already on PATH). Re-run after `cjust image-upgrade` to pick up new versions.
448|[group('opencode')]
449|opencode-install:
450|    #!/usr/bin/env bash
451|    set -euo pipefail
452|    if ! command -v npm >/dev/null 2>&1; then
453|      echo "ERROR: npm not found on host." >&2
454|      echo "       Rebuild the host image with nodejs+npm, reboot, then re-run." >&2
455|      exit 1
456|    fi
457|    npm config set prefix "$HOME/.local"
458|    npm install -g opencode-ai
459|    echo
460|    echo "opencode installed to ~/.local/bin/opencode"
461|    # First-time auth (or after wiping ~/.local/share/opencode/auth.json):
462|    #   opencode auth login
463|
464|# ═══════════════════════════════════════════════════════════════════════════
465|# hermes (host install + off-host desktop build)
466|# ═══════════════════════════════════════════════════════════════════════════
467|#
468|# Like opencode, hermes runs on the host directly (NOT in bubblebox) — it's an
469|# AI agent and needs full host control to edit files and run tools in the
470|# user's working directory. See hosts/thinkpad/README.md ("opencode and hermes
471|# are the exceptions"). The CLI/TUI come from the official installer; the
472|# desktop GUI is built off-host in a throwaway container (the `cjust icons`
473|# Papirus pattern), keeping Electron's ~200 MB of build cruft off the host.
474|#
475|# Secrets: provider keys live in secrets/hermes-thinkpad-env.age (agenix),
476|# decrypted into a per-login tmpfs by bubblebox/files/.zshenv. The desktop wrapper at
477|# bubblebox/files/.local/bin/hermes-desktop sources that cache so compositor-launched
478|# GUI sees the keys too (shells already get them via .zshenv).
479|
480|# Install the hermes CLI/TUI via the official installer. Lays down
481|# ~/.local/bin/hermes (already on PATH via .zshenv) and self-manages
482|# ~/.hermes/hermes-agent/ (Python venv + Node + ripgrep + ffmpeg). Re-run after
483|# `cjust image-upgrade` or any `hermes uninstall` to pick up a fresh install.
484|# `hermes update` (run by hermes itself) handles in-place upgrades thereafter.
485|[group('hermes')]
486|hermes-install:
487|    #!/usr/bin/env bash
488|    set -euo pipefail
489|    if ! command -v curl >/dev/null 2>&1; then
490|      echo "ERROR: curl not found on host." >&2
491|      echo "       Rebuild the host image, reboot, then re-run." >&2
492|      exit 1
493|    fi
494|    curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash
495|    echo
496|    echo "hermes installed to ~/.local/bin/hermes"
497|    # First-time setup (provider config, model pick): the OPENAI_API_KEY env
498|    # var is already exported by .zshenv (from secrets/hermes-thinkpad-env.age).
499|    # To point hermes at the Z.AI coding endpoint (OpenAI-compatible), declare
500|    # a custom provider in ~/.hermes/config.yaml:
501|    #   hermes config set custom_providers '[{name:zai-coding,base_url:https://api.z.ai/api/coding/paas/v4,key_env:OPENAI_API_KEY}]'
502|    #   hermes config set model.provider zai-coding
503|    #   hermes config set model.default glm-5.2
504|
505|# Build the hermes desktop (Electron) app OFF-HOST in a throwaway Fedora+Node
506|# podman container, then copy only the unpacked app dir onto the host. Mirrors
507|# `cjust icons` (Papirus): containerizing keeps Electron's build cruft
508|# (~200 MB node_modules, the Electron download, gcc-c++/make) off the host, so
509|# no host-image change or reboot is needed. Idempotent; re-run any time, e.g.
510|# after `hermes update` bumps the source tree.
511|#
512|# Output: ~/.local/share/hermes-desktop/ (the unpacked Electron dir). Launch
513|# via ~/.local/bin/hermes-desktop (wrapper that sources the cn-secrets cache so
514|# the compositor-launched GUI sees provider keys) or the "Hermes" launcher entry
515|# (bubblebox/files/.local/share/applications/hermes.desktop, symlinked by `bubblebox apply`).
516|#
517|# Why not bubblebox: hermes is an AI coding agent (same category as opencode) —
518|# its tool backend spawns synchronous subprocesses in arbitrary host cwds with
519|# I/O capture, which has no precedent in the bubblebox tree and fights the
520|# sandbox's read-only / content-addressed model. See README for the long version.
521|[group('hermes')]
522|hermes-desktop-build:
523|    #!/usr/bin/env bash
524|    set -euo pipefail
525|    if ! command -v hermes >/dev/null 2>&1; then
526|      echo "ERROR: hermes not found — run 'cjust hermes-install' first." >&2
527|      exit 1
528|    fi
529|    if [ ! -d "$HOME/.hermes/hermes-agent" ]; then
530|      echo "ERROR: ~/.hermes/hermes-agent missing — run 'cjust hermes-install' first." >&2
531|      exit 1
532|    fi
533|    dest="$HOME/.local/share/hermes-desktop"
534|    stage="$(mktemp -d)"
535|    trap 'rm -rf "${stage}"' EXIT
536|    # Build inside a throwaway container against the host's hermes-agent
537|    # checkout. We invoke npm directly (the same path `hermes desktop
538|    # --build-only` runs internally) instead of the hermes CLI: the venv's
539|    # `hermes` script has a host-absolute shebang and won't resolve inside the
540|    # container. electron-builder's `--dir` flag emits release/linux-unpacked/
541|    # (the unpacked Electron app, no installers). Native Node modules need
542|    # gcc-c++/make (Fedora — NOT build-essential, which is a Debian-ism).
543|    echo "==> building hermes-desktop in a throwaway podman container..."
544|    podman run --rm \
545|      -v "$HOME/.hermes/hermes-agent:/work:Z" \
546|      -v "${stage}:/out:Z" \
547|      docker.io/library/fedora:latest \
548|      bash -c '
549|        set -euo pipefail
550|        # Fedora build deps. build-essential does not exist on Fedora (Debian
551|        # only); gcc-c++ + make are the Fedora equivalents and what npm needs
552|        # for native modules. python3 is required by node-gyp.
553|        dnf install -y --quiet nodejs npm gcc-c++ make python3 git
554|        cd /work
555|        echo "--- npm install (workspace from repo root) ---"
556|        npm install --no-fund --no-audit
557|        # npm sometimes fails to set the exec bit on `bin` script targets when
558|        # installing on a bind-mounted volume (cross-env, electron-builder, etc.
559|        # show up as `Permission denied` / exit 126 on invocation). Walk every
560|        # node_modules/.bin/* symlink and chmod its target. No-op when npm got
561|        # it right; rescue when it did not.
562|        for link in node_modules/.bin/*; do
563|          [ -L "$link" ] || continue
564|          tgt=$(readlink -f "$link") && [ -f "$tgt" ] && chmod +x "$tgt" 2>/dev/null || true
565|        done
566|        echo "--- npm run pack (apps/desktop, electron-builder --dir) ---"
567|        cd apps/desktop
568|        npm run pack
569|        # electron-builder --dir emits release/linux-unpacked/.
570|        if [ -d release/linux-unpacked ]; then
571|          cp -a release/linux-unpacked /out/hermes-desktop
572|        else
573|          echo "ERROR: release/linux-unpacked/ missing after pack" >&2
574|          find release -maxdepth 2 -type d >&2 || true
575|          exit 1
576|        fi
577|        echo "  built -> /out/hermes-desktop"
578|      '
579|    # Install the built dir onto the host.
580|    rm -rf "${dest}"
581|    mkdir -p "$(dirname "${dest}")"
582|    cp -a "${stage}/hermes-desktop" "${dest}"
583|    # Locate the Electron binary inside the unpacked dir. electron-builder
584|    # names the main binary after productName (Hermes), but linux-unpacked/
585|    # also contains chrome-sandbox, chrome_crashpad_handler, libEGL.so, etc.
586|    # that are executable but not the app. Same exclusion logic as the
587|    # ~/.local/bin/hermes-desktop wrapper.
588|    bin=""
589|    for cand in "${dest}/hermes" "${dest}/Hermes" "${dest}/hermes-desktop"; do
590|      if [ -x "$cand" ]; then bin="$cand"; break; fi
591|    done
592|    if [ -z "$bin" ]; then
593|      bin="$(find "${dest}" -maxdepth 1 -type f -executable \
594|              ! -name 'chrome-sandbox' ! -name '*crashpad*' ! -name 'vulkan_*' ! -name 'lib*' \
595|              2>/dev/null | head -1 || true)"
596|    fi
597|    if [ -z "$bin" ]; then
598|      echo "WARNING: no main app binary found inside ${dest}." >&2
599|      echo "         Contents:" >&2
600|      ls -la "${dest}" >&2
601|    else
602|      echo "  main binary: ${bin#${dest}/}"
603|    fi
604|    echo "==> hermes-desktop installed to ${dest}"
605|    echo
606|    echo "Launch via:"
607|    echo "  hermes desktop --skip-build      # upstream launcher (uses ~/.hermes)"
608|    echo "  ~/.local/bin/hermes-desktop      # host wrapper (sources cn-secrets env first)"
609|    echo "  Launcher → 'Hermes'              # the .desktop entry (run 'cjust bubblebox-apply' to install)"
610|    # Refresh the launcher icon (Icon=hermes) so a rebuild always leaves a
611|    # branded icon in place. Idempotent + non-fatal.
612|    {{ just_executable() }} hermes-icon || echo "  (hermes-icon skipped)"
613|
614|# Install the official Hermes launcher icon (Icon=hermes) from the upstream
615|# hermes-agent repo into the user hicolor theme, so the .desktop entry shows the
616|# branded Hermes glyph instead of a generic info icon. Idempotent; re-run any
617|# time, and invoked automatically at the tail of `cjust hermes-desktop-build`.
618|# Mirrors the `cjust icons` (Papirus) pattern: per-user, off the host image.
619|#
620|# IMPORTANT: GNOME/GTK only scan STANDARD hicolor size dirs (16..512, per the
621|# system /usr/share/icons/hicolor/index.theme). The upstream icon.png is
622|# 1024x1024 — non-standard, so a copy in 1024x1024/ is INVISIBLE to GNOME (the
623|# app shows a generic gear). We therefore install downscaled copies at 512x512
624|# and 256x256. ImageMagick (magick/convert) does a real resize; if absent we
625|# just copy the source into each dir (GNOME scales the loaded image to the
626|# requested size regardless of the declared dir size, so that still works — the
627|# only thing that matters is landing in a standard dir).
628|[group('hermes')]
629|hermes-icon:
630|    #!/usr/bin/env bash
631|    set -euo pipefail
632|    tmp="$(mktemp)"; trap 'rm -f "${tmp}"' EXIT
633|    url="https://raw.githubusercontent.com/NousResearch/hermes-agent/main/apps/desktop/assets/icon.png"
634|    curl -fsSL "${url}" -o "${tmp}"
635|    base="${HOME}/.local/share/icons/hicolor"
636|    for s in 512 256; do
637|      dir="${base}/${s}x${s}/apps"
638|      mkdir -p "${dir}"
639|      if command -v magick >/dev/null 2>&1; then
640|        magick "${tmp}" -resize ${s}x${s} "${dir}/hermes.png"
641|      elif command -v convert >/dev/null 2>&1; then
642|        convert "${tmp}" -resize ${s}x${s} "${dir}/hermes.png"
643|      else
644|        cp -f "${tmp}" "${dir}/hermes.png"
645|      fi
646|      echo "  ${s}x${s}/apps/hermes.png"
647|    done
648|    # Drop a stale non-standard 1024x1024 copy from an older recipe version
649|    # (GNOME ignores that dir, so it only wastes space).
650|    rm -rf "${base}/1024x1024"
651|    gtk-update-icon-cache -f -t "${base}" 2>/dev/null || true
652|    echo "==> hermes icon installed at standard sizes (512x512, 256x256; Icon=hermes)"
653|
654|# ═══════════════════════════════════════════════════════════════════════════
655|# buzz desktop (host-installed AppImage)
656|# ═══════════════════════════════════════════════════════════════════════════
657|#
658|# Buzz desktop is a Tauri app; upstream publishes a Linux AppImage per release
659|# (tag pattern desktop-v*). The AppImage is the right artifact for this atomic
660|# (Silverblue/bootc) host: a single self-contained file under ~/.local/share/,
661|# no rpm-ostree layering, survives image upgrades — same "host small + state in
662|# named places" rule as hermes-desktop.
663|#
664|# Why not bubblebox: bubblebox is a read-only FUSE sandbox for dev CLI tools.
665|# Wrapping a 167 MB prebuilt GUI in an OCI image (authored in the separate
666|# bubblebox-pkgs repo) gives no isolation benefit for your own comms app, needs
667|# network + relay creds anyway, and turns every update into an image rebuild.
668|# The off-host-acquire + host-wrapper pattern (hermes-desktop precedent) is the
669|# simpler, on-repo fit. See hosts/thinkpad/README.md.
670|#
671|# This recipe is BOTH install and update: it resolves the latest desktop-v*
672|# release, downloads the AppImage (+ .sig), extracts the version-matched branded
673|# icon, and is a no-op when already current. Launch via ~/.local/bin/buzz-desktop
674|# (wrapper that sources cn-secrets env) or the "Buzz" launcher entry (run
675|# `cjust bubblebox-apply`). Re-run any time to pull a newer release.
676|
677|# Install or update the Buzz desktop AppImage to the latest desktop-v* release.
678|# Idempotent; safe to re-run. Stores under ~/.local/share/buzz-desktop/.
679|[group('buzz')]
680|buzz-desktop-install:
681|    #!/usr/bin/env bash
682|    set -euo pipefail
683|    if ! command -v curl >/dev/null 2>&1; then
684|      echo "ERROR: curl not found on host." >&2; exit 1
685|    fi
686|    api="https://api.github.com/repos/block/buzz/releases/latest"
687|    # releases/latest on block/buzz points at the desktop-v* line (the desktop
688|    # app ships there, separate from the relay's :main channel). Fetch the body
689|    # whole, then parse — piping curl into `grep -m1` makes grep close the pipe
690|    # early and curl exits 23 (SIGPIPE) under `set -o pipefail`.
691|    resp="$(curl -fsSL "${api}")"
692|    tag="$(printf '%s\n' "${resp}" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"desktop-v\([^"]*\)".*/\1/p')"
693|    if [ -z "${tag}" ]; then
694|      echo "ERROR: could not resolve latest desktop-v* tag from ${api}" >&2; exit 1
695|    fi
696|    dest="${HOME}/.local/share/buzz-desktop"
697|    mkdir -p "${dest}"
698|    cur="$(cat "${dest}/version" 2>/dev/null || true)"
699|    if [ "${cur}" = "${tag}" ] && [ -x "${dest}/Buzz.AppImage" ]; then
700|      echo "buzz-desktop desktop-v${tag} already installed"; exit 0
701|    fi
702|    echo "==> installing Buzz desktop desktop-v${tag}"
703|    base="https://github.com/block/buzz/releases/download/desktop-v${tag}/Buzz_${tag}_amd64"
704|    curl -fL "${base}.AppImage" -o "${dest}/Buzz.AppImage.new"
705|    curl -fsSL "${base}.AppImage.sig" -o "${dest}/Buzz.AppImage.sig" || true
706|    chmod +x "${dest}/Buzz.AppImage.new"
707|    # Extract the version-matched branded icon straight from the AppImage
708|    # (squashfs-root/ holds a <identifier>.png + .DirIcon). This always matches
709|    # the installed release's branding, like rendering Papirus from git HEAD.
710|    root="$(mktemp -d)"; trap 'rm -rf "${root}"' EXIT
711|    ( cd "${root}" && "${dest}/Buzz.AppImage.new" --appimage-extract >/dev/null 2>&1 ) || true
712|    icon="$(find "${root}/squashfs-root" -maxdepth 1 -type f -name '*.png' 2>/dev/null | head -1 || true)"
713|    if [ -n "${icon}" ]; then
714|      # Install at the png's real dimensions (AppImage icons are often 256x256,
715|      # not 512x512) so the hicolor dir matches the asset and gtk-update-icon-cache
716|      # doesn't warn about a size mismatch.
717|      dim="$(file "${icon}" | sed -n 's/.*image data, \([0-9][0-9]*\) x.*/\1/p' | head -1)"
718|      [ -n "${dim}" ] || dim=512
719|      icon_dir="${HOME}/.local/share/icons/hicolor/${dim}x${dim}/apps"
720|      mkdir -p "${icon_dir}"
721|      cp -f "${icon}" "${icon_dir}/buzz.png"
722|      echo "  icon <- extracted from AppImage (${dim}x${dim}) -> ${icon_dir}/buzz.png"
723|    else
724|      echo "  WARNING: could not extract icon from AppImage; Icon=buzz may be blank." >&2
725|    fi
726|    gtk-update-icon-cache -f -t "${HOME}/.local/share/icons/hicolor" 2>/dev/null || true
727|    mv -f "${dest}/Buzz.AppImage.new" "${dest}/Buzz.AppImage"
728|    echo "${tag}" > "${dest}/version"
729|    echo "==> buzz-desktop desktop-v${tag} installed -> ${dest}/Buzz.AppImage"
730|    echo
731|    echo "Launch via:"
732|    echo "  ~/.local/bin/buzz-desktop        # host wrapper (sources cn-secrets env first)"
733|    echo "  Launcher → 'Buzz'                # the .desktop entry (run 'cjust bubblebox-apply' to install)"
734|
