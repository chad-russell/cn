# cjust — post-install & maintenance tasks for the thinkpad atomic host.
#
# Entry point is the `cjust` shell function (dotfiles/.zshrc):
#   cjust            → fuzzy recipe chooser (`just --choose`, needs fzf)
#   cjust <recipe>   → run a recipe directly
#   cjust -l         → list all recipes
#
# thinkpad-only. Recipes assume a Fedora Silverblue/bootc host with `just` and
# `fzf` baked into the host image (host-image/Containerfile). Both are
# host-native on purpose: `cjust` must work before any tool sandbox is set up,
# and the menu must not depend on the thing it bootstraps.
#
# Recipes are cwd-independent: every path into the repo is built from
# `justfile_directory()`, so `cjust` works from any cwd.
#
# To add a new bubblebox tool / user unit / dotfile, edit the lists in
# DATA TABLES — no recipe changes needed.

# ═══════════════════════════════════════════════════════════════════════════
# DATA TABLES (single source of truth)
# ═══════════════════════════════════════════════════════════════════════════

# Path to the bubblebox profile — single source of truth for the root list
# (was: a hand-maintained `bubblebox_tools` string that had to be kept in sync
# with this file's `packages` list). Recipes below read this via a python3
# one-liner at runtime (tomllib is in stdlib since 3.11; the host image ships
# python3). `bubblebox build` gracefully skips any "virtual entrypoint" whose
# `package` field points at another package (e.g. age-keygen → age) — no
# Containerfile of its own to build, no error.
bubblebox_profile := justfile_directory() + "/bubblebox/profile.toml"

# bubblebox engine dir (the Rust CLI binary + fuse-mount + shared bin/). The
# package source tree (Containerfiles + entrypoints) is a separate repo at
# ~/Code/bubblebox-pkgs, registered via profile.toml below.
# Hardcoded to $HOME/Code/bubblebox (deliberate — this Justfile is thinkpad-
# specific, and the layout matches the rest of the cn repo).
bubblebox_dir := env_var_or_default("HOME", "/tmp") + "/Code/bubblebox"
# The Rust CLI binary (the single entry point; bash scripts are retired).
# Build it with `cargo build --release` at the workspace root (use the dev
# toolbox for the toolchain). Re-run `cjust bubblebox-export` after rebuilding
# to refresh the ~/.local/bin wrappers' baked-in path.
bubblebox_bin := bubblebox_dir + "/target/release/bubblebox"

# systemd user units (filenames in systemd/user/, WITHOUT the .service suffix)
# to symlink into ~/.config/systemd/user/.
user_units := "opencode-web vicinae"

# Host-native dotfiles: relative paths under dotfiles/ that mirror $HOME.
# Each is symlinked dotfiles/<path> → $HOME/<path>. Convention (see
# dotfiles/.zshenv): dotfiles/ mirrors $HOME-relative layout, so src and dst
# paths are identical.
#
# COSMIC desktop settings are NOT symlinked (COSMIC has issues with
# symlink-backed config). Instead, use `cjust cosmic-backup` and
# `cjust cosmic-restore` to copy settings between the repo and
# ~/.config/cosmic.
dotfiles := ".aws/config .config/oh-my-posh.json .config/environment.d/10-bubblebox.conf .config/niri/config.kdl .config/nvim .config/wezterm .config/ghostty .config/vicinae/settings.json .config/opencode .local/share/applications/wezterm.desktop .local/share/applications/ghostty.desktop .zshrc .zshenv"

# ═══════════════════════════════════════════════════════════════════════════
# setup
# ═══════════════════════════════════════════════════════════════════════════

# Symlink host-native dotfiles from dotfiles/ into $HOME (idempotent).
# Ported from the old dotfiles/setup.sh: existing real files are backed up to
# <path>.bak.<ts>; already-correct symlinks are left alone.
[group('setup')]
link:
    #!/usr/bin/env bash
    set -euo pipefail
    paths="{{ dotfiles }}"
    home="${HOME:-$(getent passwd "${USER:-$(id -un)}" | cut -d: -f6)}"
    ts="$(date -u +%Y%m%d-%H%M%S)"
    src_root="{{ justfile_directory() }}/dotfiles"
    rc=0
    for rel in $paths; do
      src="${src_root}/${rel}"
      dst="${home}/${rel}"
      if [ ! -e "${src}" ]; then
        echo "  SKIP  ${rel}: source missing in repo"; rc=1; continue
      fi
      if [ -L "${dst}" ] && [ "$(readlink -f "${dst}")" = "$(readlink -f "${src}")" ]; then
        echo "  OK    ${rel} (already linked)"; continue
      fi
      if [ -e "${dst}" ] && [ ! -L "${dst}" ]; then
        backup="${dst}.bak.${ts}"
        echo "  BACKUP ${rel} -> ${backup#${home}/}"
        mv "${dst}" "${backup}"
      fi
      mkdir -p "$(dirname "${dst}")"
      ln -s "${src}" "${dst}"
      echo "  LINK  ${rel}"
    done
    if [ "${rc}" -ne 0 ]; then
      echo; echo "Completed with warnings (see SKIP lines above)." >&2
    fi

# Symlink systemd user units from systemd/user/ into ~/.config/systemd/user/,
# reload the user manager, and enable lingering so user services run at boot.
# Idempotent. This is the fix for the "Unit opencode-web.service not found"
# class of problem: the unit lives in the repo and has to be linked into place.
[group('setup')]
units:
    #!/usr/bin/env bash
    set -euo pipefail
    units="{{ user_units }}"
    src_dir="{{ justfile_directory() }}/systemd/user"
    dst_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    ts="$(date -u +%Y%m%d-%H%M%S)"
    mkdir -p "${dst_dir}"
    for u in $units; do
      src="${src_dir}/${u}.service"
      dst="${dst_dir}/${u}.service"
      if [ ! -e "${src}" ]; then
        echo "  SKIP  ${u}: source missing"; continue
      fi
      if [ -L "${dst}" ] && [ "$(readlink -f "${dst}")" = "$(readlink -f "${src}")" ]; then
        echo "  OK    ${u} (already linked)"; continue
      fi
      if [ -e "${dst}" ] && [ ! -L "${dst}" ]; then
        echo "  BACKUP ${u}.service -> ${u}.service.bak.${ts}"
        mv "${dst}" "${dst}.bak.${ts}"
      fi
      ln -s "${src}" "${dst}"
      echo "  LINK  ${u}.service"
    done
    systemctl --user daemon-reload
    # Enable lingering so user services start before login (one-time, no-op if set).
    user="${USER:-$(id -un)}"
    if ! loginctl show-user "$user" 2>/dev/null | grep -q '^Linger=yes'; then
      loginctl enable-linger "$user"
      echo "  LINGER enabled for ${user}"
    fi
    echo "Done. Enable a unit with: systemctl --user enable --now <unit>"

# Full first-run setup: dotfiles + units + all bubblebox tools + opencode. Run
# this on a fresh install (after the host image is booted). Idempotent. The
# bubblebox SOURCE is declared in bubblebox/profile.toml (profile-authoritative)
# — no separate `source add` step.
# Note: `opencode-install` requires nodejs/npm on the host (added to the
# host image in mid-2026). If you're on an older image, that step fails
# harmlessly — complete the host-image rebuild + reboot, then re-run setup.
[group('setup')]
setup: link units bubblebox opencode-install
    @echo "==> Setup complete."
    @echo "    If host-image deps changed (just/fzf/nodejs/npm), rebuild & reboot:"
    @echo "      cjust image-build && cjust image-upgrade && systemctl reboot"

# GNOME tweak to allow for mod + <right-click> to resize, like how it works in niri or Cosmic
[group('setup')]
gnome-right-click-resize:
    #!/usr/bin/env bash
    gsettings set org.gnome.desktop.wm.preferences resize-with-right-button "true"

# Install the Papirus icon theme into the per-user icons dir and make it the
# active icon theme for GNOME and Niri/GTK apps. Idempotent — re-running
# rebuilds from current HEAD and re-applies the settings.
#
# Method: build in a throwaway podman container from git HEAD, then copy only
# the final icon dirs out to ~/.local/share/icons. Containerizing keeps all
# build cruft (git clone, dnf, make) off the host — only the rendered icons
# land on disk. We build from git HEAD because the GitHub *release* tag lags
# ~a year behind master, and active icon updates only land on master.
#
# Kept out of the host image on purpose — icons are easy to iterate on per-user
# and don't deserve an image rebuild + reboot cycle. (Niri has no icon-theme
# knob in config.kdl — it's a cursor compositor, not a theming layer. GTK apps
# under Niri read ~/.config/gtk-{3,4}.0/settings.ini for icon-theme-name; GNOME
# reads org.gnome.desktop.interface via dconf. Both are set here so the theme
# sticks in either session.)
[group('setup')]
icons:
    #!/usr/bin/env bash
    set -euo pipefail
    icons_dir="${HOME}/.local/share/icons"
    image="docker.io/library/fedora:44"
    mkdir -p "${icons_dir}"
    stage="$(mktemp -d)"
    trap 'rm -rf "${stage}"' EXIT
    # Build in a throwaway podman container so the host never sees git/dnf/make
    # artifacts — only the final icon dirs are copied out. `make install` for
    # Papirus is literally a `cp -R` of the pre-rendered Papirus{,-Dark,-Light}
    # dirs into the staging prefix; HEAD tracks active updates that the stale
    # release tag misses.
    echo "==> building Papirus from git HEAD in a podman container..."
    podman run --rm -v "${stage}:/out:Z" "${image}" bash -c '
      set -euo pipefail
      dnf install -y git make >/dev/null 2>&1
      git clone --depth 1 --quiet https://github.com/PapirusDevelopmentTeam/papirus-icon-theme.git /work/p
      make -C /work/p -s install DESTDIR=/out PREFIX=/usr
      echo "  HEAD $(git -C /work/p rev-parse --short HEAD) ($(git -C /work/p log -1 --format=%cd --date=short))"
    '
    src="${stage}/usr/share/icons"
    [ -f "${src}/Papirus/index.theme" ] || { echo "ERROR: ${src}/Papirus/index.theme missing" >&2; exit 1; }
    for v in Papirus Papirus-Dark Papirus-Light; do
      rm -rf "${icons_dir}/${v}"
      cp -r "${src}/${v}" "${icons_dir}/${v}"
    done
    echo "  installed -> ${icons_dir}/{Papirus,Papirus-Dark,Papirus-Light}"
    # GNOME (and GTK apps that read dconf via gsd / xdg-desktop-portal-gnome):
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus'
    echo "  set gsettings org.gnome.desktop.interface icon-theme=Papirus"
    # Niri / GTK3 / GTK4 without a GNOME settings daemon: settings.ini is what
    # GTK actually consults for icon-theme-name in those sessions.
    for v in gtk-3.0 gtk-4.0; do
      ini="${HOME}/.config/${v}/settings.ini"
      mkdir -p "$(dirname "${ini}")"
      touch "${ini}"
      if grep -q '^gtk-icon-theme-name=' "${ini}"; then
        sed -i 's|^gtk-icon-theme-name=.*|gtk-icon-theme-name=Papirus|' "${ini}"
      else
        grep -q '^\[Settings\]' "${ini}" || printf '[Settings]\n' >> "${ini}"
        printf 'gtk-icon-theme-name=Papirus\n' >> "${ini}"
      fi
      echo "  set ${v}/settings.ini gtk-icon-theme-name=Papirus"
    done
    echo "==> Papirus is now the active icon theme (GNOME + Niri/GTK)."

# ═══════════════════════════════════════════════════════════════════════════
# cosmic — backup / restore settings (NOT symlinked; cosmic dislikes
# symlinks for its config tree). Files live at ~/.config/cosmic/ normally;
# backup copies into dotfiles/.config/cosmic/ for git tracking, restore
# copies back.
# ═══════════════════════════════════════════════════════════════════════════

# Copy settings from ~/.config/cosmic to dotfiles/.config/cosmic.
# Run this when you've tweaked something in the COSMIC settings UI and want
# to save the result to the repo.
[group('cosmic')]
cosmic-backup:
    #!/usr/bin/env bash
    set -euo pipefail
    src="${HOME}/.config/cosmic"
    dst="{{ justfile_directory() }}/dotfiles/.config/cosmic"
    if [ ! -d "${src}" ]; then
      echo "ERROR: ${src} does not exist — nothing to back up." >&2
      exit 1
    fi
    rm -rf "${dst}"
    cp -r "${src}" "${dst}"
    echo "cosmic settings backed up to ${dst}"

# Copy settings from dotfiles/.config/cosmic to ~/.config/cosmic.
# Run this on a fresh install or to restore a known-good config.
# If ~/.config/cosmic is currently a symlink (from the old setup), it is
# removed first so COSMIC sees real files.
[group('cosmic')]
cosmic-restore:
    #!/usr/bin/env bash
    set -euo pipefail
    src="{{ justfile_directory() }}/dotfiles/.config/cosmic"
    dst="${HOME}/.config/cosmic"
    if [ ! -d "${src}" ]; then
      echo "ERROR: no saved cosmic settings at ${src}" >&2
      exit 1
    fi
    # If dst is a symlink (old symlink-based setup), remove it so COSMIC
    # sees real files.
    if [ -L "${dst}" ]; then
      echo "  REMOVE symlink ${dst} (old setup)"
      rm "${dst}"
    fi
    rm -rf "${dst}"
    cp -r "${src}" "${dst}"
    echo "cosmic settings restored to ${dst}"

# ═══════════════════════════════════════════════════════════════════════════
# bubblebox tools
# ═══════════════════════════════════════════════════════════════════════════
#
# bubblebox auto-mounts each tool on first run (rootless FUSE). The recipes
# below are: init (build FUSE server, one-time), build (per-tool image +
# composefs descriptor), export (per-tool wrapper at ~/.local/bin/).

# Build the FUSE server binary in a container (no host rust toolchain needed).
# Idempotent — cargo build is incremental.
[group('bubblebox')]
bubblebox-init:
    {{ bubblebox_bin }} init

# Build each tool's image + composefs descriptor. With no args, builds all
# tools from `bubblebox_tools`; with args, builds only the named tools, e.g.
# `cjust bubblebox-build wezterm`.
#
# Tool source dirs resolve from the registered bubblebox SOURCE (declared in
# bubblebox/profile.toml — profile-authoritative, so no `source add` needed).
[group('bubblebox')]
bubblebox-build *tools:
    #!/usr/bin/env bash
    set -euo pipefail
    tools="{{ tools }}"
    if [ -z "${tools}" ]; then
      tools=$(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))')
    fi
    for t in $tools; do
      echo "==> bubblebox-build ${t}"
      {{ bubblebox_bin }} build "$t"
    done

# Generate one wrapper per tool at ~/.local/bin/<tool>. With no args, exports
# all tools; with args, exports only the named tools.
# Idempotent — overwrites with the current binary path.
[group('bubblebox')]
bubblebox-export *tools:
    #!/usr/bin/env bash
    set -euo pipefail
    tools="{{ tools }}"
    if [ -z "${tools}" ]; then
      tools=$(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))')
    fi
    for t in $tools; do
      {{ bubblebox_bin }} export "$t"
    done
    echo
    echo "Wrappers at ~/.local/bin/ (already on PATH via dotfiles/.zshenv)."

# Realize the declarative profile (bubblebox/profile.toml): sync it to
# ~/.config/bubblebox/, then `bubblebox apply` — resolve inputs (local
# descriptors for built tools, or `bubblebox apply --refresh` against a cache),
# write/refresh profile.lock + a generation, self-migrate descriptors to the
# Phase-1 digest-addressed layout, materialize bindings, and sync ~/.local/bin
# wrappers. The declarative counterpart to bubblebox-build + bubblebox-export:
# build (or pull) populates the store; apply declares what's active.
[group('bubblebox')]
bubblebox-apply:
    #!/usr/bin/env bash
    set -euo pipefail
    install -Dm644 "{{ justfile_directory() }}/bubblebox/profile.toml" "$HOME/.config/bubblebox/profile.toml"
    {{ bubblebox_bin }} apply

# Reclaim store bytes no generation/binding/mount references. Dry-run by
# default (reclaims nothing until you prune old generations —
# `{{ bubblebox_bin }} generations --older-than 30d`). Pass `apply` to sweep.
[group('bubblebox')]
bubblebox-gc *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{ args }}" = "apply" ]; then
      {{ bubblebox_bin }} gc --apply
    else
      {{ bubblebox_bin }} gc
    fi

# Init + build + apply in one shot. The thing to run on a fresh install or
# after pulling changes that touch tool configs. (Source registration + wrapper
# export are both handled by `apply` via the declarative profile.)
[group('bubblebox')]
bubblebox: bubblebox-init bubblebox-build bubblebox-apply
    @echo "==> bubblebox: FUSE server built, tools built, profile applied."

# ═══════════════════════════════════════════════════════════════════════════
# opencode (host install)
# ═══════════════════════════════════════════════════════════════════════════
#
# opencode runs on the host directly (not in bubblebox) because it's the AI
# coding agent — it needs full host control when something breaks, without
# sandbox restrictions getting in the way of recovery. Vendored config lives
# at dotfiles/.config/opencode/ (symlinked by `cjust link`); secrets stay
# machine-local at ~/.local/share/opencode/auth.json (gitignored by virtue
# of being outside the vendored tree).

# Install opencode globally via npm. Silverblue's /usr/local is read-only, so
# npm's prefix is set to ~/.local — opencode lands at ~/.local/bin/opencode
# (already on PATH). Re-run after `cjust image-upgrade` to pick up new versions.
[group('opencode')]
opencode-install:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v npm >/dev/null 2>&1; then
      echo "ERROR: npm not found on host." >&2
      echo "       Rebuild the host image with nodejs+npm, reboot, then re-run." >&2
      exit 1
    fi
    npm config set prefix "$HOME/.local"
    npm install -g opencode-ai
    echo
    echo "opencode installed to ~/.local/bin/opencode"
    # First-time auth (or after wiping ~/.local/share/opencode/auth.json):
    #   opencode auth login

# ═══════════════════════════════════════════════════════════════════════════
# host image (bootc)
# ═══════════════════════════════════════════════════════════════════════════

# Build the custom Silverblue host image into root podman storage. (sudo)
# See host-image/README.md. First time on a host, follow with `image-switch`.
[group('host image')]
image-build:
    {{ justfile_directory() }}/host-image/build.sh

# One-time: adopt the custom image as the host's boot image. (sudo)
# Only for first adoption or changing image reference; for routine rebuilds
# use `image-upgrade` instead. Reboot after.
[group('host image')]
image-switch:
    {{ justfile_directory() }}/host-image/switch.sh

# Routine: apply a freshly rebuilt image to the host. (sudo)
# Re-resolves the :44 tag from local storage and stages a new deployment if the
# digest changed. Reboot after.
[group('host image')]
image-upgrade:
    {{ justfile_directory() }}/host-image/upgrade.sh

