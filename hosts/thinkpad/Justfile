1|# cjust — post-install & maintenance tasks for the thinkpad atomic host.
2|#
3|# Entry point is the `cjust` shell function (bubblebox/files/.zshrc):
4|#   cjust            → fuzzy recipe chooser (`just --choose`, needs fzf)
5|#   cjust <recipe>   → run a recipe directly
6|#   cjust -l         → list all recipes
7|#
8|# thinkpad-only. Recipes assume a Fedora Silverblue/bootc host with `just` and
9|# `fzf` baked into the host image (host-image/Containerfile). Both are
10|# host-native on purpose: `cjust` must work before any tool sandbox is set up,
11|# and the menu must not depend on the thing it bootstraps.
12|#
13|# Recipes are cwd-independent: every path into the repo is built from
14|# `justfile_directory()`, so `cjust` works from any cwd.
15|#
16|# To add a new bubblebox tool / user unit / dotfile, edit `bubblebox/profile.toml`
17|# (the `[[files]]` and `[[units]]` sections) — no recipe changes needed.
18|
19|# ═══════════════════════════════════════════════════════════════════════════
20|# DATA TABLES (single source of truth)
21|# ═══════════════════════════════════════════════════════════════════════════
22|
23|# Path to the bubblebox profile — single source of truth for the root list
24|# (was: a hand-maintained `bubblebox_tools` string that had to be kept in sync
25|# with this file's `packages` list). Recipes below read this via a python3
26|# one-liner at runtime (tomllib is in stdlib since 3.11; the host image ships
27|# python3). `bubblebox build` gracefully skips any "virtual entrypoint" whose
28|# `package` field points at another package (e.g. age-keygen → age) — no
29|# Containerfile of its own to build, no error.
30|bubblebox_profile := justfile_directory() + "/bubblebox/profile.toml"
31|
32|# bubblebox engine dir (the Rust CLI binary + fuse-mount + shared bin/). The
33|# package source tree (Containerfiles + entrypoints) is a separate repo at
34|# ~/Code/bubblebox-pkgs, registered via profile.toml below.
35|# Hardcoded to $HOME/Code/bubblebox (deliberate — this Justfile is thinkpad-
36|# specific, and the layout matches the rest of the cn repo).
37|bubblebox_dir := env_var_or_default("HOME", "/tmp") + "/Code/bubblebox"
38|# The Rust CLI binary (the single entry point; bash scripts are retired).
39|# Build it with `cargo build --release` at the workspace root (use the dev
40|# toolbox for the toolchain). Re-run `cjust bubblebox-export` after rebuilding
41|# to refresh the ~/.local/bin wrappers' baked-in path.
42|bubblebox_bin := bubblebox_dir + "/target/release/bubblebox"
43|
44|# ═══════════════════════════════════════════════════════════════════════════
45|# setup
46|# ═══════════════════════════════════════════════════════════════════════════
47|
48|# Host-resident dotfiles and systemd user units are now managed by bubblebox
# itself (Phase B/C). `cjust bubblebox-apply` handles them alongside packages:
#   - `[[files]]` in bubblebox/profile.toml → content-addressed store symlinks
#   - `[[units]]` in bubblebox/profile.toml → systemd user unit symlinks + systemctl
# The old `cjust link` and `cjust units` recipes are retired — the declarative
# profile is the single source of truth.

# Full first-run setup: all bubblebox tools + opencode. Run this on a fresh
# install (after the host image is booted). Idempotent. The bubblebox SOURCE
# is declared in bubblebox/profile.toml (profile-authoritative) — no separate
# `source add` step. Dotfiles and units are applied by `bubblebox-apply`.
# Note: `opencode-install` requires nodejs/npm on the host (added to the
# host image in mid-2026). If you're on an older image, that step fails
# harmlessly — complete the host-image rebuild + reboot, then re-run setup.
[group('setup')]
setup: bubblebox opencode-install
    @echo "==> Setup complete."
    @echo "    If host-image deps changed (just/fzf/nodejs/npm), rebuild & reboot:"
    @echo "      cjust image-build && cjust image-upgrade && systemctl reboot"

# GNOME tweak to allow for mod + <right-click> to resize, like how it works in niri or Cosmic
134|[group('setup')]
135|gnome-right-click-resize:
136|    #!/usr/bin/env bash
137|    gsettings set org.gnome.desktop.wm.preferences resize-with-right-button "true"
138|
139|# Install the Papirus icon theme into the per-user icons dir and make it the
140|# active icon theme for GNOME and Niri/GTK apps. Idempotent — re-running
141|# rebuilds from current HEAD and re-applies the settings.
142|#
143|# Method: build in a throwaway podman container from git HEAD, then copy only
144|# the final icon dirs out to ~/.local/share/icons. Containerizing keeps all
145|# build cruft (git clone, dnf, make) off the host — only the rendered icons
146|# land on disk. We build from git HEAD because the GitHub *release* tag lags
147|# ~a year behind master, and active icon updates only land on master.
148|#
149|# Kept out of the host image on purpose — icons are easy to iterate on per-user
150|# and don't deserve an image rebuild + reboot cycle. (Niri has no icon-theme
151|# knob in config.kdl — it's a cursor compositor, not a theming layer. GTK apps
152|# under Niri read ~/.config/gtk-{3,4}.0/settings.ini for icon-theme-name; GNOME
153|# reads org.gnome.desktop.interface via dconf. Both are set here so the theme
154|# sticks in either session.)
155|[group('setup')]
156|icons:
157|    #!/usr/bin/env bash
158|    set -euo pipefail
159|    icons_dir="${HOME}/.local/share/icons"
160|    image="docker.io/library/fedora:44"
161|    mkdir -p "${icons_dir}"
162|    stage="$(mktemp -d)"
163|    trap 'rm -rf "${stage}"' EXIT
164|    # Build in a throwaway podman container so the host never sees git/dnf/make
165|    # artifacts — only the final icon dirs are copied out. `make install` for
166|    # Papirus is literally a `cp -R` of the pre-rendered Papirus{,-Dark,-Light}
167|    # dirs into the staging prefix; HEAD tracks active updates that the stale
168|    # release tag misses.
169|    echo "==> building Papirus from git HEAD in a podman container..."
170|    podman run --rm -v "${stage}:/out:Z" "${image}" bash -c '
171|      set -euo pipefail
172|      dnf install -y git make >/dev/null 2>&1
173|      git clone --depth 1 --quiet https://github.com/PapirusDevelopmentTeam/papirus-icon-theme.git /work/p
174|      make -C /work/p -s install DESTDIR=/out PREFIX=/usr
175|      echo "  HEAD $(git -C /work/p rev-parse --short HEAD) ($(git -C /work/p log -1 --format=%cd --date=short))"
176|    '
177|    src="${stage}/usr/share/icons"
178|    [ -f "${src}/Papirus/index.theme" ] || { echo "ERROR: ${src}/Papirus/index.theme missing" >&2; exit 1; }
179|    for v in Papirus Papirus-Dark Papirus-Light; do
180|      rm -rf "${icons_dir}/${v}"
181|      cp -r "${src}/${v}" "${icons_dir}/${v}"
182|    done
183|    echo "  installed -> ${icons_dir}/{Papirus,Papirus-Dark,Papirus-Light}"
184|    # GNOME (and GTK apps that read dconf via gsd / xdg-desktop-portal-gnome):
185|    gsettings set org.gnome.desktop.interface icon-theme 'Papirus'
186|    echo "  set gsettings org.gnome.desktop.interface icon-theme=Papirus"
187|    # Niri / GTK3 / GTK4 without a GNOME settings daemon: settings.ini is what
188|    # GTK actually consults for icon-theme-name in those sessions.
189|    for v in gtk-3.0 gtk-4.0; do
190|      ini="${HOME}/.config/${v}/settings.ini"
191|      mkdir -p "$(dirname "${ini}")"
192|      touch "${ini}"
193|      if grep -q '^gtk-icon-theme-name=' "${ini}"; then
194|        sed -i 's|^gtk-icon-theme-name=.*|gtk-icon-theme-name=Papirus|' "${ini}"
195|      else
196|        grep -q '^\[Settings\]' "${ini}" || printf '[Settings]\n' >> "${ini}"
197|        printf 'gtk-icon-theme-name=Papirus\n' >> "${ini}"
198|      fi
199|      echo "  set ${v}/settings.ini gtk-icon-theme-name=Papirus"
200|    done
201|    echo "==> Papirus is now the active icon theme (GNOME + Niri/GTK)."
202|
203|# Cap Zen Browser's memory via a cgroup v2 soft limit, by overriding its
204|# flatpak desktop file to launch through the `zen-browser` wrapper script
205|# (deployed by `bubblebox apply` to ~/.local/bin/). Idempotent — re-running
206|# re-derives from the current flatpak export (so Zen desktop-file updates
207|# flow through) and rewrites the override.
208|#
209|# Why a wrapper, not `systemd-run --scope -p MemoryHigh=...` in Exec=:
210|# flatpak calls StartTransientScope itself via its session helper, creating
211|# `app-flatpak-<appid>-<id>.scope` as a SIBLING under app.slice. An outer
212|# scope we wrap the launch in is bypassed — the browser escapes with
213|# MemoryHigh=infinity (verified empirically). The only reliable attachment
214|# point is flatpak's own scope, which the wrapper polls for and caps with
215|# `systemctl --user set-property --runtime` once it appears. The wrapper
216|# also re-caps an already-running instance if the launch forwarded to one.
217|#
218|# Why MemoryHigh (not MemoryMax): MemoryHigh is a cgroup v2 *soft* limit.
219|# When the scope exceeds it, the kernel aggressively reclaims pages inside
220|# it (swap → zram) and emits PSI memory-pressure events, but never OOM-kills.
221|# Firefox/Zen's nsAvailableMemoryWatcher reacts to PSI by unloading tabs —
222|# so the browser self-governs as if the box only has $mem RAM, which is the
223|# goal: stop it from eating everything before its own unload logic kicks in,
224|# without ever killing it. MemoryMax would OOM-kill the whole browser;
225|# MemoryHigh just throttles/reclaims.
226|#
227|# The wrapper script (bubblebox/files/.local/bin/zen-browser) is generic — it reads
228|# the limit from ZEN_MEMHIGH. This recipe generates only the desktop override,
229|# baking the limit into an `env ZEN_MEMHIGH=$mem` prefix on each Exec= line,
230|# so `cjust zen-memlimit 12G` regenerates with the new value without touching
231|# the wrapper. The override is host-local regenerable state (NOT a symlinked
232|# dotfile) — Zen's desktop file ships hundreds of i18n lines and changes
233|# across versions, so the source of truth is THIS recipe (version-controlled).
234|# Clear with `cjust zen-memlimit-clear`.
235|#
236|# Default is 16G on a 32G host; pass any systemd size, e.g. `cjust zen-memlimit 12G`.
237|# NOTE: this recipe generates the override for FUTURE launches. A currently
238|# running Zen instance keeps whatever MemoryHigh its scope had at attach time
239|# — cap it live with:
240|#   scope=$(systemctl --user list-units --type=scope --all --no-legend | \
241|#           awk '/app-flatpak-app\.zen_browser\.zen-[0-9]+\.scope/{print $1}')
242|#   systemctl --user set-property --runtime "$scope" MemoryHigh=16G
243|[group('setup')]
244|zen-memlimit mem="16G":
245|    #!/usr/bin/env bash
246|    set -euo pipefail
247|    appid="app.zen_browser.zen"
248|    # Resolve the original desktop file from the flatpak export (system install
249|    # first, then per-user). Reading from the export — not a prior override —
250|    # keeps this idempotent and lets Zen desktop-file updates flow through.
251|    src=""
252|    for cand in \
253|      "/var/lib/flatpak/exports/share/applications/${appid}.desktop" \
254|      "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share/applications/${appid}.desktop"; do
255|      if [ -e "$cand" ]; then src="$cand"; break; fi
256|    done
257|    if [ -z "$src" ]; then
258|      echo "ERROR: no ${appid}.desktop in flatpak exports — is Zen installed?" >&2
259|      exit 1
260|    fi
261|    wrapper="${HOME}/.local/bin/zen-browser"
262|    if [ ! -x "$wrapper" ]; then
263|      echo "ERROR: ${wrapper} missing or not executable — run 'cjust bubblebox-apply' first." >&2
264|      exit 1
265|    fi
266|    dst_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
267|    dst="${dst_dir}/${appid}.desktop"
268|    mkdir -p "$dst_dir"
269|    # Rewrite every Exec= line: drop flatpak's run-prefix + appid, keep the
270|    # per-action flags + file-forwarding markers, prepend an env ZEN_MEMHIGH
271|    # + the wrapper path. `.*app\.zen_browser\.zen ` is robust to changes in
272|    # flatpak's run flags; if the appid token itself ever moves, the line is
273|    # left untouched (safe — just no limit until the recipe is updated).
274|    sed -E "s|^Exec=.*app\\.zen_browser\\.zen (.*)$|Exec=env ZEN_MEMHIGH={{ mem }} ${wrapper} \\1|g" "$src" > "$dst"
275|    update-desktop-database "$dst_dir" 2>/dev/null || true
276|    echo "Wrote ${dst}"
277|    echo "  source:     ${src}"
278|    echo "  wrapper:    ${wrapper}"
279|    echo "  MemoryHigh: {{ mem }} (cgroup v2 soft limit; no OOM kill)"
280|    echo
281|    echo "Future launches from the menu are capped. Verify after relaunch:"
282|    echo "  systemctl --user show app-flatpak-${appid}-*.scope -p MemoryHigh -p MemoryMax   # MemoryHigh=..., MemoryMax=infinity"
283|    echo "  grep -E 'some|full' /proc/pressure/memory                                      # PSI rises as Zen grows past {{ mem }}"
284|
285|# Remove the Zen memory override; Zen falls back to its stock flatpak desktop
286|# file (unlimited). Idempotent.
287|[group('setup')]
288|zen-memlimit-clear:
289|    #!/usr/bin/env bash
290|    set -euo pipefail
291|    appid="app.zen_browser.zen"
292|    dst_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
293|    dst="${dst_dir}/${appid}.desktop"
294|    if [ -e "$dst" ]; then
295|      rm "$dst"
296|      update-desktop-database "$dst_dir" 2>/dev/null || true
297|      echo "Removed ${dst} — Zen now uses the stock flatpak desktop file."
298|    else
299|      echo "No override at ${dst} (nothing to do)."
300|    fi
