# Enable inbound SSH on the thinkpad (for remote access over Nebula from bee/
# bees). Idempotent. (sudo)
#
# - Installs an /etc/ssh/sshd_config.d drop-in forcing key-only auth.
# - Authorizes this host's own ed25519 pub key (the SAME keypair lives on bee
#   and bees, so all three hosts can log in here).
# - Enables + starts the system sshd. openssh-server ships in the Silverblue
#   base image (no host-image change), and `systemctl enable` persists in /etc
#   across bootc upgrades, so this survives image rebuilds + reboots.
#
# Why key-only: crussell has a password set, and sshd binds to ALL interfaces
# (Nebula 10.10.0.10 + LAN/WiFi). Disabling password auth avoids opening a new
# LAN brute-force surface and matches the gateway posture. To allow password
# auth again, delete /etc/ssh/sshd_config.d/10-key-only.conf and restart sshd.
#
# Connect from bee/bees over Nebula:
#   ssh -o IdentitiesOnly=yes crussell@10.10.0.10
[group('system')]
ssh:
    #!/usr/bin/env bash
    set -euo pipefail
    # 1. Harden: key-only auth drop-in (read by sshd after sshd_config).
    dropin=/etc/ssh/sshd_config.d/10-key-only.conf
    sudo install -d -m 755 "$(dirname "$dropin")"
    printf '%s\n' \
      '# Managed by `cjust ssh` (hosts/thinkpad/Justfile). Key-only auth.' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'PermitRootLogin no' \
      | sudo tee "$dropin" >/dev/null
    sudo chmod 644 "$dropin"
    echo "  wrote $dropin (PasswordAuthentication no)"
    # 2. Authorize the shared ed25519 key (same keypair on bee/bees/think).
    install -d -m 700 "$HOME/.ssh"
    pub="$HOME/.ssh/id_ed25519.pub"
    auth="$HOME/.ssh/authorized_keys"
    touch "$auth"; chmod 600 "$auth"
    if [ -s "$pub" ]; then
      grep -qF "$(cat "$pub")" "$auth" || cat "$pub" >> "$auth"
      echo "  authorized: $(awk '{print $1, $3}' "$pub")"
    else
      echo "  WARN: $pub missing — no key added (install one manually)" >&2
    fi
    # 3. Enable + start the system sshd.
    sudo systemctl enable --now sshd.service
    echo "==> sshd enabled. Connect over Nebula:"
    echo "    ssh -o IdentitiesOnly=yes crussell@10.10.0.10"
    sudo ss -tlnp 2>/dev/null | grep ':22 ' || true

# Show the current state of this machine: host-image version, bootc deployment,
# bubblebox mounts + wrappers, opencode install, and linked user units.
# Read-only.
[group('system')]
status:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "=== host image ==="
    cat /usr/lib/host-image-thinkpad-version 2>/dev/null || echo "(no version file)"
    echo
    echo "=== bootc ==="
    bootc status 2>&1 | head -30 || true
    echo
    echo "=== bubblebox mounts ==="
    mount | grep '/bubblebox/' || echo "(none mounted)"
    echo
    echo "=== bubblebox wrappers (~/.local/bin/) ==="
    dst_bin="${HOME}/.local/bin"
    for t in $(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))'); do
      if [ -x "${dst_bin}/${t}" ]; then echo "  ok   ${t}"; else echo "  MISS ${t}"; fi
    done
    echo
    echo "=== opencode (host install) ==="
    if command -v opencode >/dev/null 2>&1; then
      echo "  $(opencode --version 2>&1 | head -1)"
    else
      echo "  (not installed — run: cjust opencode-install)"
    fi
    echo
    echo "=== user units (~/.config/systemd/user/) ==="
    dst_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    if ls -1 "${dst_dir}"/*.service 2>/dev/null; then :; else echo "(none linked)"; fi

# ═══════════════════════════════════════════════════════════════════════════
# bee remote dev — SSH tunnels (dev access for gpl/polymer/buildspace/hummingbird/storyhub on bee)
# ═══════════════════════════════════════════════════════════════════════════
#
# Next.js dev servers hard-code localhost (the HMR/dev channel is restricted to
# localhost via allowedDevOrigins; gpl/polymer auth clients fall back to
# localhost:3000/3006), so remote dev on bee uses SSH port-forwarding instead
# of a reverse proxy: the SAME laptop ports you'd use locally are mapped onto
# bee's offset published ports (which exist only to avoid colliding with the
# other dev stacks on bee). Browse http://localhost:<port>
# exactly like local dev — every callback / cookie / HMR URL works unchanged.
# Ctrl-C closes a tunnel.
#
# gpl + polymer + buildspace + hummingbird + storyhub use disjoint port ranges
# on bee, so they CAN all run there at once — BUT on the laptop several share
# :3000 (polymer, buildspace, hummingbird) so run one at a time.
#
# Override the bee target with BEE=user@host (default crussell@10.10.0.12).
# Stacks themselves are managed on bee with `qd` (see hosts/bee/dev-quadlets/).

# Open the SSH tunnel for one project (stack must already be running on bee).
# Blocks the terminal — Ctrl-C to close. Maps the thinkpad-standard localhost
# ports onto bee's offset published ports:
#   gpl         localhost:3006                      -> bee:3006
#   polymer     localhost:3000 + :3001              -> bee:3100 / :3101
#   buildspace  localhost:3000,3002-3006,3008,3010  -> bee:32xx
#   hummingbird localhost:3000 + :8000              -> bee:3300 / :3308
#   storyhub    localhost:3001,8001,9000,9001       -> bee:3301/3309/3390/3391
[group('bee')]
dev-tunnel project:
    #!/usr/bin/env bash
    set -euo pipefail
    BEE="${BEE:-crussell@10.10.0.12}"
    SSH_OPTS=(-o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -N)
    case "{{ project }}" in
      gpl)
        echo "==> gpl tunnel: http://localhost:3006 -> bee:3006  (Ctrl-C to close)"
        exec ssh "${SSH_OPTS[@]}" "$BEE" -L 3006:localhost:3006
        ;;
      polymer)
        echo "==> polymer tunnel: http://localhost:3000 + :3001 -> bee:3100/3101  (Ctrl-C to close)"
        exec ssh "${SSH_OPTS[@]}" "$BEE" -L 3000:localhost:3100 -L 3001:localhost:3101
        ;;
      buildspace|bs)
        echo "==> buildspace tunnel: http://localhost:{3000,3002-3006,3008,3010} -> bee:32xx  (Ctrl-C to close)"
        exec ssh "${SSH_OPTS[@]}" "$BEE" \
          -L 3000:localhost:3200 -L 3002:localhost:3202 -L 3003:localhost:3203 -L 3004:localhost:3204 \
          -L 3005:localhost:3205 -L 3006:localhost:3206 -L 3008:localhost:3208 -L 3010:localhost:3210
        ;;
      hummingbird|hb)
        echo "==> hummingbird tunnel: http://localhost:3000 (web) + :8000 (api) -> bee:3300/3308  (Ctrl-C to close)"
        exec ssh "${SSH_OPTS[@]}" "$BEE" -L 3000:localhost:3300 -L 8000:localhost:3308
        ;;
      storyhub|sh)
        echo "==> storyhub tunnel: http://localhost:{3001,8001,9000,9001} -> bee:3301/3309/3390/3391  (Ctrl-C to close)"
        exec ssh "${SSH_OPTS[@]}" "$BEE" \
          -L 3001:localhost:3301 -L 8001:localhost:3309 -L 9000:localhost:3390 -L 9001:localhost:3391
        ;;
      *)
        echo "usage: cjust dev-tunnel <gpl|polymer|buildspace|bs|hummingbird|hb|storyhub|sh>" >&2
        echo "  gpl         -> http://localhost:3006" >&2
        echo "  polymer     -> http://localhost:3000 (polymer) + http://localhost:3001 (admin360)" >&2
        echo "  buildspace  -> http://localhost:{3000,3002,3003,3004,3005,3006,3008,3010}" >&2
        echo "  hummingbird -> http://localhost:3000 (web) + http://localhost:8000 (api)" >&2
        echo "  storyhub    -> http://localhost:3001 (web) + :8001 (worker) + :9000/:9001 (minio)" >&2
        echo "start the stack on bee first:  ssh -o IdentitiesOnly=yes \"$BEE\" 'qd <project> up'" >&2
        echo "polymer+buildspace+hummingbird share laptop :3000; gpl+buildspace share :3006." >&2
        exit 1
        ;;
    esac

# One-shot: start the stack on bee (`qd <project> up`), then open the tunnel.
# `qd up` blocks until the app container is running — on a cold first start that
# means the in-container pnpm/bun install runs first (can take minutes); watch
# progress in another terminal with `ssh -o IdentitiesOnly=yes $BEE 'qd <project> logs'`.
# Then Ctrl-C closes the tunnel (the stack keeps running on bee).
[group('bee')]
dev-up project:
    #!/usr/bin/env bash
    set -euo pipefail
    BEE="${BEE:-crussell@10.10.0.12}"
    case "{{ project }}" in
      gpl|polymer|buildspace|hummingbird|storyhub) proj="{{ project }}" ;;
      bs)                     proj="buildspace" ;;
      hb)                     proj="hummingbird" ;;
      sh)                     proj="storyhub" ;;
      *)
        echo "usage: cjust dev-up <gpl|polymer|buildspace|bs|hummingbird|hb|storyhub|sh>" >&2
        exit 1
        ;;
    esac
    echo "==> starting $proj on bee ($BEE) …"
    ssh -o IdentitiesOnly=yes "$BEE" "qd $proj up"
    echo "==> stack up; opening tunnel (Ctrl-C to close) …"
    exec just --justfile "{{ justfile_directory() }}/Justfile" dev-tunnel "$proj"

# ═══════════════════════════════════════════════════════════════════════════
# bees remote ops — llama.cpp LLM server (on-demand, OpenAI API on :8888)
# ═══════════════════════════════════════════════════════════════════════════
#
# bees serves local LLMs via a systemd TEMPLATE service (llama-server@<model>):
# the instance name is the GGUF basename in /var/lib/llama/models/ minus the
# .gguf extension. Only ONE model runs at a time (single :8888). Full ops
# guide: strix-halo-llm-serving skill; module: hosts/bees/llama-server.nix.
#
#   cjust llama           # start default model (Qwen3.8-27B), wait for :8888
#   cjust llama stop      # stop default model (frees VRAM immediately)
#   cjust llama status    # which model is running + systemd status
#   cjust llama models    # list GGUFs on bees (valid instance names)
#   cjust llama start L3.3-MS-Nevoria-70b-Q4_K_M    # start a different model
#
# Override the target with BEES=user@host (default crussell@10.10.0.6).

# Start/stop/restart/status the on-demand llama-server on bees over SSH.
# `start` refuses if a DIFFERENT model is already loaded (only one fits :8888)
# and then polls /v1/models until the server answers — loading the GGUF into
# VRAM takes ~30-60s for the 27B, so expect a short wait.
[group('bees')]
llama action="start" model="Qwen3.8-27B-UD-Q6_K_XL":
    #!/usr/bin/env bash
    set -euo pipefail
    BEES="${BEES:-crussell@10.10.0.6}"
    host="${BEES#*@}"
    act="{{ action }}"
    model="{{ model }}"
    case "$act" in
      models)
        echo "GGUFs on bees (/var/lib/llama/models/) — instance name = basename minus .gguf:"
        ssh -o IdentitiesOnly=yes "$BEES" 'ls -lh /var/lib/llama/models/'
        exit 0
        ;;
      status)
        ssh -o IdentitiesOnly=yes "$BEES" \
          "systemctl list-units --type=service --state=active --no-legend 'llama-server@*'; \
           systemctl status 'llama-server@${model}.service' --no-pager" || true
        exit 0
        ;;
      start|stop|restart) ;;
      *)
        echo "usage: cjust llama [start|stop|restart|status|models] [model]" >&2
        exit 1
        ;;
    esac
    # Which instance is currently active? (quote the @ pattern — remote zsh globs)
    running="$(ssh -o IdentitiesOnly=yes "$BEES" \
      "systemctl list-units --type=service --state=active --no-legend 'llama-server@*' \
       | awk '{print \$1}'")"
    running="${running%.service}"; running="${running#llama-server@}"
    if [ "$act" = start ] && [ -n "$running" ]; then
      if [ "$running" = "$model" ]; then
        echo "==> ${model} already running — checking health"
      else
        echo "ERROR: ${running} is loaded and only one model fits :8888." >&2
        echo "       Stop it first:  cjust llama stop ${running}" >&2
        exit 1
      fi
    fi
    ssh -o IdentitiesOnly=yes "$BEES" "sudo systemctl ${act} 'llama-server@${model}.service'"
    [ "$act" = start ] || exit 0
    echo "==> waiting for ${model} to load into VRAM ..."
    for _ in $(seq 1 60); do
      if curl -sf "http://${host}:8888/v1/models" >/dev/null 2>&1; then
        echo "==> serving on http://${host}:8888/v1 :"
        curl -sf "http://${host}:8888/v1/models"; echo
        exit 0
      fi
      sleep 2
    done
    echo "ERROR: :8888 not answering after 120s — check with:" >&2
    echo "  ssh $BEES 'journalctl -u llama-server@${model} -n 50'" >&2
    exit 1
