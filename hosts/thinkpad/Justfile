# cjust — post-install & maintenance tasks for the thinkpad atomic host.
#
# Entry point is the `cjust` shell function (bubblebox/files/.zshrc):
#   cjust            → fuzzy recipe chooser (`just --choose`, needs fzf)
#   cjust <recipe>   → run a recipe directly
#   cjust -l         → list all recipes
#
# thinkpad-only. Recipes assume a Fedora Silverblue/bootc host with `just` and
# `fzf` baked into the host image (host-image/Containerfile). Both are
# host-native on purpose: `cjust` must work before any tool sandbox is set up,
# and the menu must not depend on the thing it bootstraps.
#
# Recipes are cwd-independent: every path into the repo is built from
# `justfile_directory()`, so `cjust` works from any cwd.
#
# To add a new bubblebox tool / user unit / dotfile, edit `bubblebox/profile.toml`
# (the `[[files]]` and `[[units]]` sections) — no recipe changes needed.

# ═══════════════════════════════════════════════════════════════════════════
# DATA TABLES (single source of truth)
# ═══════════════════════════════════════════════════════════════════════════

# Path to the bubblebox profile — single source of truth for the root list
# (was: a hand-maintained `bubblebox_tools` string that had to be kept in sync
# with this file's `packages` list). Recipes below read this via a python3
# one-liner at runtime (tomllib is in stdlib since 3.11; the host image ships
# python3). `bubblebox build` gracefully skips any "virtual entrypoint" whose
# `package` field points at another package (e.g. age-keygen → age) — no
# Containerfile of its own to build, no error.
bubblebox_profile := justfile_directory() + "/bubblebox/profile.toml"

# bubblebox engine: the RELEASED portable build (Forgejo release tarball,
# installed by `cjust bubblebox-install` into ~/.local/bin next to
# bubblebox-fuse). The laptop is a pure CONSUMER — packages are built, signed,
# and published by bubblebox-pkgs CI (publish.yml) to the bees cache; nothing
# here builds packages by default. Bump the pin to upgrade the engine.
# Set BUBBLEBOX_BIN to point recipes at a dev checkout build instead
# (e.g. ~/Code/bubblebox/target/release/bubblebox).
bubblebox_version := "0.4.2"
bubblebox_bin := env_var_or_default("BUBBLEBOX_BIN", env_var_or_default("HOME", "/tmp") + "/.local/bin/bubblebox")

# ═══════════════════════════════════════════════════════════════════════════
# setup
# ═══════════════════════════════════════════════════════════════════════════

# Host-resident dotfiles and systemd user units are now managed by bubblebox
# itself (Phase B/C). `cjust bubblebox-apply` handles them alongside packages:
#   - `[[files]]` in bubblebox/profile.toml → content-addressed store symlinks
#   - `[[units]]` in bubblebox/profile.toml → systemd user unit symlinks + systemctl
# The old `cjust link` and `cjust units` recipes are retired — the declarative
# profile is the single source of truth.

# Full first-run setup: all bubblebox tools. Run this on a fresh
# install (after the host image is booted). Idempotent. The bubblebox SOURCE
# is declared in bubblebox/profile.toml (profile-authoritative) — no separate
# `source add` step. Dotfiles and units are applied by `bubblebox-apply`.
# (opencode retired 2026-09-02; hermes desktop + dsh CLI removed from this
#  host 2026-10-16 — agent work happens on bee via dsh.internal.crussell.io.)
[group('setup')]
setup: bubblebox-install bubblebox-doctor bubblebox-apply
    @echo "==> Setup complete."
    @echo "    If host-image deps changed (just/fzf/nodejs/npm), rebuild & reboot:"
    @echo "      cjust image-rebuild && systemctl reboot"

# (gnome-right-click-resize retired: resize-with-right-button is declared in
#  bubblebox/files/.config/dconf/bubblebox.d/00-thinkpad.)

# Install the Papirus icon theme into the per-user icons dir and make it the
# active icon theme for GNOME and Niri/GTK apps. Idempotent — re-running
# rebuilds from current HEAD and re-applies the settings.
#
# Method: build in a throwaway podman container from git HEAD, then copy only
# the final icon dirs out to ~/.local/share/icons. Containerizing keeps all
# build cruft (git clone, dnf, make) off the host — only the rendered icons
# land on disk. We build from git HEAD because the GitHub *release* tag lags
# ~a year behind master, and active icon updates only land on master.
#
# Kept out of the host image on purpose — icons are easy to iterate on per-user
# and don't deserve an image rebuild + reboot cycle. (Niri has no icon-theme
# knob in config.kdl — it's a cursor compositor, not a theming layer. GTK apps
# under Niri read ~/.config/gtk-{3,4}.0/settings.ini for icon-theme-name; GNOME
# reads org.gnome.desktop.interface via dconf. Both are set here so the theme
# sticks in either session.)
[group('setup')]
icons:
    #!/usr/bin/env bash
    set -euo pipefail
    icons_dir="${HOME}/.local/share/icons"
    image="docker.io/library/fedora:44"
    mkdir -p "${icons_dir}"
    stage="$(mktemp -d)"
    trap 'rm -rf "${stage}"' EXIT
    # Build in a throwaway podman container so the host never sees git/dnf/make
    # artifacts — only the final icon dirs are copied out. `make install` for
    # Papirus is literally a `cp -R` of the pre-rendered Papirus{,-Dark,-Light}
    # dirs into the staging prefix; HEAD tracks active updates that the stale
    # release tag misses.
    echo "==> building Papirus from git HEAD in a podman container..."
    podman run --rm -v "${stage}:/out:Z" "${image}" bash -c '
      set -euo pipefail
      dnf install -y git make >/dev/null 2>&1
      git clone --depth 1 --quiet https://github.com/PapirusDevelopmentTeam/papirus-icon-theme.git /work/p
      make -C /work/p -s install DESTDIR=/out PREFIX=/usr
      echo "  HEAD $(git -C /work/p rev-parse --short HEAD) ($(git -C /work/p log -1 --format=%cd --date=short))"
    '
    src="${stage}/usr/share/icons"
    [ -f "${src}/Papirus/index.theme" ] || { echo "ERROR: ${src}/Papirus/index.theme missing" >&2; exit 1; }
    for v in Papirus Papirus-Dark Papirus-Light; do
      rm -rf "${icons_dir}/${v}"
      cp -r "${src}/${v}" "${icons_dir}/${v}"
    done
    echo "  installed -> ${icons_dir}/{Papirus,Papirus-Dark,Papirus-Light}"
    # GNOME's icon-theme is DECLARED (dconf bubblebox.d: Papirus-Dark) — not
    # written here, or this recipe would plant a user-db override over it.
    # GTK3/GTK4 settings.ini (non-GNOME sessions) are bubblebox [[files]]
    # now (bubblebox/files/.config/gtk-{3,4}.0/settings.ini) — editing them
    # here would clobber the managed symlinks. Change the theme there instead.
    echo "==> Papirus installed. GNOME icon theme: dconf layer (Papirus-Dark)."
    echo "    GTK sessions: bubblebox [[files]] gtk-{3,4}.0/settings.ini."

# Cap Zen Browser's memory via a cgroup v2 soft limit, by overriding its
# flatpak desktop file to launch through the `zen-browser` wrapper script
# (deployed by `bubblebox apply` to ~/.local/bin/). Idempotent — re-running
# re-derives from the current flatpak export (so Zen desktop-file updates
# flow through) and rewrites the override.
#
# Why a wrapper, not `systemd-run --scope -p MemoryHigh=...` in Exec=:
# flatpak calls StartTransientScope itself via its session helper, creating
# `app-flatpak-<appid>-<id>.scope` as a SIBLING under app.slice. An outer
# scope we wrap the launch in is bypassed — the browser escapes with
# MemoryHigh=infinity (verified empirically). The only reliable attachment
# point is flatpak's own scope, which the wrapper polls for and caps with
# `systemctl --user set-property --runtime` once it appears. The wrapper
# also re-caps an already-running instance if the launch forwarded to one.
#
# Why MemoryHigh (not MemoryMax): MemoryHigh is a cgroup v2 *soft* limit.
# When the scope exceeds it, the kernel aggressively reclaims pages inside
# it (swap → zram) and emits PSI memory-pressure events, but never OOM-kills.
# Firefox/Zen's nsAvailableMemoryWatcher reacts to PSI by unloading tabs —
# so the browser self-governs as if the box only has $mem RAM, which is the
# goal: stop it from eating everything before its own unload logic kicks in,
# without ever killing it. MemoryMax would OOM-kill the whole browser;
# MemoryHigh just throttles/reclaims.
#
# The wrapper script (bubblebox/files/.local/bin/zen-browser) is generic — it reads
# the limit from ZEN_MEMHIGH. This recipe generates only the desktop override,
# baking the limit into an `env ZEN_MEMHIGH=$mem` prefix on each Exec= line,
# so `cjust zen-memlimit 12G` regenerates with the new value without touching
# the wrapper. The override is host-local regenerable state (NOT a symlinked
# dotfile) — Zen's desktop file ships hundreds of i18n lines and changes
# across versions, so the source of truth is THIS recipe (version-controlled).
# Clear with `cjust zen-memlimit-clear`.
#
# Default is 16G on a 32G host; pass any systemd size, e.g. `cjust zen-memlimit 12G`.
# NOTE: this recipe generates the override for FUTURE launches. A currently
# running Zen instance keeps whatever MemoryHigh its scope had at attach time
# — cap it live with:
#   scope=$(systemctl --user list-units --type=scope --all --no-legend | \
#           awk '/app-flatpak-app\.zen_browser\.zen-[0-9]+\.scope/{print $1}')
#   systemctl --user set-property --runtime "$scope" MemoryHigh=16G
[group('setup')]
zen-memlimit mem="16G":
    #!/usr/bin/env bash
    set -euo pipefail
    appid="app.zen_browser.zen"
    # Resolve the original desktop file from the flatpak export (system install
    # first, then per-user). Reading from the export — not a prior override —
    # keeps this idempotent and lets Zen desktop-file updates flow through.
    src=""
    for cand in \
      "/var/lib/flatpak/exports/share/applications/${appid}.desktop" \
      "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share/applications/${appid}.desktop"; do
      if [ -e "$cand" ]; then src="$cand"; break; fi
    done
    if [ -z "$src" ]; then
      echo "ERROR: no ${appid}.desktop in flatpak exports — is Zen installed?" >&2
      exit 1
    fi
    wrapper="${HOME}/.local/bin/zen-browser"
    if [ ! -x "$wrapper" ]; then
      echo "ERROR: ${wrapper} missing or not executable — run 'cjust bubblebox-apply' first." >&2
      exit 1
    fi
    dst_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    dst="${dst_dir}/${appid}.desktop"
    mkdir -p "$dst_dir"
    # Rewrite every Exec= line: drop flatpak's run-prefix + appid, keep the
    # per-action flags + file-forwarding markers, prepend an env ZEN_MEMHIGH
    # + the wrapper path. `.*app\.zen_browser\.zen ` is robust to changes in
    # flatpak's run flags; if the appid token itself ever moves, the line is
    # left untouched (safe — just no limit until the recipe is updated).
    sed -E "s|^Exec=.*app\\.zen_browser\\.zen (.*)$|Exec=env ZEN_MEMHIGH={{ mem }} ${wrapper} \\1|g" "$src" > "$dst"
    update-desktop-database "$dst_dir" 2>/dev/null || true
    echo "Wrote ${dst}"
    echo "  source:     ${src}"
    echo "  wrapper:    ${wrapper}"
    echo "  MemoryHigh: {{ mem }} (cgroup v2 soft limit; no OOM kill)"
    echo
    echo "Future launches from the menu are capped. Verify after relaunch:"
    echo "  systemctl --user show app-flatpak-${appid}-*.scope -p MemoryHigh -p MemoryMax   # MemoryHigh=..., MemoryMax=infinity"
    echo "  grep -E 'some|full' /proc/pressure/memory                                      # PSI rises as Zen grows past {{ mem }}"

# Remove the Zen memory override; Zen falls back to its stock flatpak desktop
# file (unlimited). Idempotent.
[group('setup')]
zen-memlimit-clear:
    #!/usr/bin/env bash
    set -euo pipefail
    appid="app.zen_browser.zen"
    dst_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    dst="${dst_dir}/${appid}.desktop"
    if [ -e "$dst" ]; then
      rm "$dst"
      update-desktop-database "$dst_dir" 2>/dev/null || true
      echo "Removed ${dst} — Zen now uses the stock flatpak desktop file."
    else
      echo "No override at ${dst} (nothing to do)."
    fi

# ═══════════════════════════════════════════════════════════════════════════
# desktoppak — RETIRED 2026-09-01. The bwrap-payload experiment lost to the
# normal bootc/image path; compositors ship in the host image (see
# host-image/Containerfile). One final cleanup recipe remains for the live
# host's /usr/local leftovers; once it has run once, this whole section can
# be deleted. It is kept only so the removal is a discoverable cjust verb
# instead of tribal knowledge.
# ═══════════════════════════════════════════════════════════════════════════

# One-time removal of the retired desktoppak artifacts from the live host:
# the wrapper scripts and the ghost GDM session entries they created (the
# "COSMIC (desktoppak)" / "Niri (bubblewrap)" entries in the login screen).
# These files were never image-managed — they were hand-placed in /usr/local
# — so deleting them once is permanent. Idempotent; safe to re-run.
[group('desktoppak')]
desktoppak-purge:
    #!/usr/bin/env bash
    set -euo pipefail
    removed=0
    for f in \
      /usr/local/bin/desktoppak \
      /usr/local/bin/niri-bwrap-session \
      /usr/local/share/wayland-sessions/desktoppak-cosmic.desktop \
      /usr/local/share/wayland-sessions/desktoppak-niri.desktop; do
        if [ -e "$f" ]; then
            sudo rm -f "$f"
            echo "removed: $f"
            removed=1
        fi
    done
    if [ "$removed" = 0 ]; then
        echo "Nothing to purge — desktoppak artifacts already gone."
    else
        update-desktop-database /usr/local/share/wayland-sessions 2>/dev/null || true
        echo "Done. Ghost GDM entries disappear at next logout/login."
    fi

# ═══════════════════════════════════════════════════════════════════════════
# cosmic — backup / restore settings (NOT symlinked; cosmic dislikes
# symlinks for its config tree). Files live at ~/.config/cosmic/ normally;
# backup copies into bubblebox/files/.config/cosmic/ for git tracking, restore
# copies back. COSMIC itself is soft-removed from the image (2026-09-01);
# these recipes + the backed-up settings are what make re-adding it later a
# one-line Containerfile change + `cjust cosmic-restore`.
# ═══════════════════════════════════════════════════════════════════════════

# Copy settings from ~/.config/cosmic to bubblebox/files/.config/cosmic.
# Run this when you've tweaked something in the COSMIC settings UI and want
# to save the result to the repo.
[group('cosmic')]
cosmic-backup:
    #!/usr/bin/env bash
    set -euo pipefail
    src="${HOME}/.config/cosmic"
    dst="{{ justfile_directory() }}/bubblebox/files/.config/cosmic"
    if [ ! -d "${src}" ]; then
      echo "ERROR: ${src} does not exist — nothing to back up." >&2
      exit 1
    fi
    rm -rf "${dst}"
    cp -r "${src}" "${dst}"
    echo "cosmic settings backed up to ${dst}"

# Copy settings from bubblebox/files/.config/cosmic to ~/.config/cosmic.
# Run this on a fresh install or to restore a known-good config.
# If ~/.config/cosmic is currently a symlink (from the old setup), it is
# removed first so COSMIC sees real files.
[group('cosmic')]
cosmic-restore:
    #!/usr/bin/env bash
    set -euo pipefail
    src="{{ justfile_directory() }}/bubblebox/files/.config/cosmic"
    dst="${HOME}/.config/cosmic"
    if [ ! -d "${src}" ]; then
      echo "ERROR: no saved cosmic settings at ${src}" >&2
      exit 1
    fi
    # If dst is a symlink (old symlink-based setup), remove it so COSMIC
    # sees real files.
    if [ -L "${dst}" ]; then
      echo "  REMOVE symlink ${dst} (old setup)"
      rm "${dst}"
    fi
    rm -rf "${dst}"
    cp -r "${src}" "${dst}"
    echo "cosmic settings restored to ${dst}"

# ═══════════════════════════════════════════════════════════════════════════
# bubblebox tools
# ═══════════════════════════════════════════════════════════════════════════
#
# The laptop CONSUMES bubblebox: the engine is a pinned release, packages
# come from the signed bees cache (published by bubblebox-pkgs CI), and the
# profile is applied IN PLACE from this repo — ~/.config/bubblebox/profile.toml
# is a symlink to bubblebox/profile.toml, so files/ and units/ resolve here and
# the engine mirrors profile.lock back next to it (commit it — the flake.lock
# analog). Wrappers, devshells, and bare `bubblebox plan` all see the same
# profile through the symlink.
#
#   cjust bubblebox-apply     realize the COMMITTED lock (reproducible; = switch)
#   cjust bubblebox-upgrade   re-resolve against the cache, then apply (= update)
#   cjust bubblebox-plan      dry-run of either (pass `--refresh` for upgrade)
#
# No ordering trap any more: nothing local builds packages, so apply can never
# roll a fresh local build back to a stale lock.

# Install (or re-install) the pinned engine release into ~/.local/bin:
# bubblebox + bubblebox-fuse side by side (exe-adjacent FUSE resolution) plus
# the shell helpers. Idempotent; skips the download when already at the pin.
# Install the pinned engine release into ~/.local/bin.
[group('bubblebox')]
bubblebox-install:
    #!/usr/bin/env bash
    set -euo pipefail
    want="{{ bubblebox_version }}"
    have="$("$HOME/.local/bin/bubblebox" --version 2>/dev/null | awk '{print $2}' || true)"
    if [ "${have}" = "${want}" ]; then
      echo "bubblebox ${have} already installed"; exit 0
    fi
    name="bubblebox-v${want}-linux-x86_64"
    url="https://git.crussell.io/chad/bubblebox/releases/download/v${want}/${name}.tar.gz"
    tmp="$(mktemp -d)"; trap 'rm -rf "${tmp}"' EXIT
    echo "==> ${have:-none} -> ${want}  (${url})"
    curl -fsSL "${url}" | tar -xz -C "${tmp}"
    "${tmp}/${name}/install.sh" "${tmp}/${name}"
    # Wrappers bake in the ABSOLUTE engine path, and `apply` only (re)writes
    # wrappers for newly added roots — so re-point every existing root at the
    # installed engine (first run: moves them off the old dev-checkout build).
    roots=$(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))')
    stale=""
    for r in ${roots}; do
      [ -f "$HOME/.local/bin/${r}" ] && stale="${stale} ${r}"
    done
    if [ -n "${stale}" ]; then
      "$HOME/.local/bin/bubblebox" -q export ${stale} >/dev/null
      echo "==> re-pointed $(echo ${stale} | wc -w) wrapper(s) at $HOME/.local/bin/bubblebox"
    fi

# Pre-flight the host: every runtime dep (bwrap, fuse3, composefs, userns,
# FUSE server) with per-distro install hints. Non-zero exit when a required
# piece is missing — that's why `setup` runs it first.
# Check host runtime deps for bubblebox.
[group('bubblebox')]
bubblebox-doctor:
    {{ bubblebox_bin }} doctor

# Point ~/.config/bubblebox/profile.toml at this repo's profile (idempotent).
# Replaces the old install/rsync copy of profile.toml + files/ + units/ and the
# copy-the-lock-back step: the engine follows the symlink and mirrors the lock.
[private]
bubblebox-link-profile:
    #!/usr/bin/env bash
    set -euo pipefail
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/bubblebox"
    src="{{ justfile_directory() }}/bubblebox/profile.toml"
    mkdir -p "${cfg}"
    if [ "$(readlink "${cfg}/profile.toml" || true)" != "${src}" ]; then
      ln -sfn "${src}" "${cfg}/profile.toml"
      echo "linked ${cfg}/profile.toml -> ${src}"
      # Leftover copies from the rsync era are dead weight now.
      for d in files units; do
        [ -d "${cfg}/${d}" ] && [ ! -L "${cfg}/${d}" ] \
          && echo "note: ${cfg}/${d}/ is an unused copy from the old rsync flow; safe to delete"
      done
    fi

# Realize the committed profile.lock: pull any missing pinned packages from the
# cache, materialize bindings, sync ~/.local/bin wrappers, $HOME files, and
# user units. Fresh host + committed lock = byte-identical tool set.
# Apply the committed profile + lock (reproducible).
[group('bubblebox')]
bubblebox-apply: bubblebox-link-profile
    {{ bubblebox_bin }} apply
    @systemctl --user start dconf-bubblebox-compile.service 2>/dev/null || true

# Refresh the bubblebox-pkgs git source (entrypoint changes), re-resolve every
# package against the bees cache index (whatever CI last published), apply,
# and write the new lock next to profile.toml.
# Review + commit bubblebox/profile.lock afterwards.
# Re-resolve packages against the cache, apply, update the lock.
[group('bubblebox')]
bubblebox-upgrade: bubblebox-link-profile
    {{ bubblebox_bin }} source update personal
    {{ bubblebox_bin }} apply --refresh
    @git -C "{{ justfile_directory() }}" diff --stat -- bubblebox/profile.lock

# Read-only dry-run of apply. `cjust bubblebox-plan --refresh` previews an
# upgrade; `--json` for machines.
# Dry-run apply (--refresh previews an upgrade, --json for machines).
[group('bubblebox')]
bubblebox-plan *args: bubblebox-link-profile
    {{ bubblebox_bin }} plan {{ args }}

# Reclaim store bytes no generation/binding/mount references. Dry-run by
# default. `cjust bubblebox-gc apply` prunes to the last 3 generations and
# sweeps.
# Store GC: dry-run, or `apply` to prune to 3 generations + sweep.
[group('bubblebox')]
bubblebox-gc *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{ args }}" = "apply" ]; then
      echo "--- before: $({{ bubblebox_bin }} list | tail -1)"
      {{ bubblebox_bin }} generations keep-last 3
      {{ bubblebox_bin }} gc --apply
      echo "--- after:  $({{ bubblebox_bin }} list | tail -1)"
    else
      {{ bubblebox_bin }} gc
    fi

# One-time: move flatpaks from the SYSTEM installation to the per-user one
# declared in bubblebox/profile.toml [flatpak]. Order is safe by construction:
#   1. `apply` installs every declared app into --user (system copies remain,
#      so nothing is ever missing),
#   2. then each SYSTEM app that now also exists in --user is uninstalled from
#      the system installation (polkit prompts once; app data in ~/.var/app is
#      shared by both installations and is NOT touched),
#   3. system apps NOT declared are listed and left alone (decide per app:
#      add to [flatpak] and re-run, or `flatpak uninstall --system <id>`),
#   4. unused system runtimes are cleaned up.
# Idempotent; safe to re-run. Needs bubblebox ≥ 0.4.0 (cjust bubblebox-install).
# Migrate system-installation flatpaks to the declared per-user set.
[group('bubblebox')]
flatpak-migrate-to-user: bubblebox-apply
    #!/usr/bin/env bash
    set -euo pipefail
    user_apps=$(flatpak list --user --app --columns=application | sort)
    sys_apps=$(flatpak list --system --app --columns=application | sort)
    dupes=$(comm -12 <(echo "${user_apps}") <(echo "${sys_apps}"))
    left=$(comm -13 <(echo "${user_apps}") <(echo "${sys_apps}"))
    if [ -n "${dupes}" ]; then
      echo "==> removing $(echo "${dupes}" | wc -l) system copies now present per-user:"
      echo "${dupes}" | sed 's/^/    /'
      flatpak uninstall --system -y --noninteractive ${dupes}
      flatpak uninstall --system -y --noninteractive --unused || true
    else
      echo "==> no system/user duplicates"
    fi
    if [ -n "${left}" ]; then
      echo "==> still in the SYSTEM installation (not declared — left alone):"
      echo "${left}" | sed 's/^/    /'
    fi
    echo "==> per-user: $(flatpak list --user --app --columns=application | wc -l) apps"

# ── maintainer escape hatch (not part of setup) ─────────────────────────────
# Packages are normally built + published by bubblebox-pkgs CI (publish.yml,
# workflow_dispatch). These recipes build locally to test a Containerfile
# before opening a PR. A local build is NOT published and the next
# `bubblebox-apply` keeps the locked digest — use `bubblebox run <pkg>` (which
# realizes the local descriptor) to try it.
# Build named packages locally (testing only; CI publishes).
[group('bubblebox-maint')]
bubblebox-build *tools:
    #!/usr/bin/env bash
    set -euo pipefail
    tools="{{ tools }}"
    if [ -z "${tools}" ]; then
      echo "usage: cjust bubblebox-build <pkg>...  (full rebuilds happen in CI)" >&2
      exit 2
    fi
    for t in $tools; do
      echo "==> bubblebox-build ${t}"
      {{ bubblebox_bin }} build "$t"
    done

# host image (bootc)
# ═══════════════════════════════════════════════════════════════════════════
#
# The NORMAL flow is registry-driven, built on bees:
#   bees builds + publishes 10.10.0.6:5000/cn/thinkpad-host:stable daily
#   (thinkpad-image-build.timer, hosts/bees/thinkpad-registry.nix), keeping
#   the last 3 immutable tags. `cjust image-rebuild` triggers a build NOW;
#   `cjust image-upgrade` pulls the diff and stages it; reboot applies.
#
# BREAK-GLASS (bees/Nebula down only): build locally from host-image/ —
#   cd hosts/thinkpad/host-image && ./build.sh && ./switch.sh && reboot
# A local build lands on a DIFFERENT bootc reference (containers-storage:),
# so moving back to the registry flow later is another switch. See
# host-image/README.md. Deliberately NOT cjust recipes: the menu should
# point at the normal flow, and a mis-fired break-glass is costly.

# Build on bees NOW (pulls origin/main there), wait, then pull + stage here.
# Requires: SSH key to bees (same ed25519 as elsewhere) + Nebula up.
# "I pushed to origin/main and want it on the laptop today" — builds + stages in one shot.
[group('host image')]
image-rebuild:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> triggering build on bees (this pulls origin/main there) ..."
    ssh -o IdentitiesOnly=yes crussell@10.10.0.6 \
      'sudo systemctl start --no-block thinkpad-image-build.service && sudo journalctl -u thinkpad-image-build.service -f -n 0 -o cat'
    echo
    echo "==> build published; pulling + staging on this host"
    {{ just_executable() }} --justfile "{{ justfile_directory() }}/Justfile" image-upgrade

# One-time: adopt the bees registry image as the host's boot image. (sudo)
# Only for first adoption or changing image reference; for routine updates
# use `image-upgrade`. Reboot after. See host-image/switch.sh.
[group('host image')]
image-switch:
    {{ justfile_directory() }}/host-image/switch.sh

# Routine: pull the latest :stable from bees's registry + stage a new deployment.
# (sudo) Downloads only changed layers. Reboot to go live.
[group('host image')]
image-upgrade:
    {{ justfile_directory() }}/host-image/upgrade.sh

# One-time, AFTER rebooting into an image with the baked units (3.9): remove
# the /etc copies the old install.sh flow left behind — /etc SHADOWS /usr, so
# until they're gone the baked quadlets/timers aren't the ones running.
# Safe post-reboot: identical content, and the baked versions are already
# active. Removes: quadlet copies, restic timers, ntfy template, the
# hand-made nebula wants symlink (the image ships its own).
[group('host image')]
image-adopt-units:
    #!/usr/bin/env bash
    set -euo pipefail
    for f in \
        /etc/containers/systemd/nebula.container \
        /etc/containers/systemd/tailscale.container \
        /etc/containers/systemd/restic-backup.container \
        /etc/containers/systemd/restic-check.container \
        /etc/systemd/system/restic-backup.timer \
        /etc/systemd/system/restic-check.timer \
        "/etc/systemd/system/restic-ntfy-failure@.service" \
        /etc/systemd/system/multi-user.target.wants/nebula.service; do
      if [ -e "$f" ] || [ -L "$f" ]; then sudo rm -f "$f" && echo "removed $f"; fi
    done
    sudo systemctl daemon-reload
    echo "==> baked units now authoritative (host-image/quadlets + systemd/)"


# ═══════════════════════════════════════════════════════════════════════════
# system
# ═══════════════════════════════════════════════════════════════════════════

# Build the nebula image + (re)seed its config volume (idempotent). The
# Quadlet itself ships in the host image; after re-seeding, restart with
# `sudo systemctl restart nebula`.
[group('system')]
nebula:
    {{ justfile_directory() }}/nebula/setup.sh

# Build the restic image + seed creds + init the S3 repo (daily backup +
# weekly check timers ship in the host image). S3-only; see backup/README.md.
# Idempotent — re-run after editing backup/excludes.
[group('system')]
backup:
    {{ justfile_directory() }}/backup/setup.sh

# Pull the upstream image (the on-demand Tailscale Quadlet ships in the host
# image, NOT enabled at boot). Start it manually when needed:
#   sudo systemctl start tailscale
#   sudo podman exec tailscale tailscale up   # first time only (browser auth)
# See tailscale/README.md. Idempotent.
[group('system')]
tailscale:
    {{ justfile_directory() }}/tailscale/setup.sh

# Authorize this host's own ed25519 pub key for inbound SSH (remote access
# over Nebula from bee/bees). Idempotent. The SAME keypair lives on bee and
# bees. The key-only-auth drop-in + `systemctl enable sshd` ship in the HOST
# IMAGE (host-image/etc/ssh/sshd_config.d/, Containerfile 3.9) — this
# recipe is only the per-host authorized_keys state.
#
# Why key-only (baked): crussell has a password set, and sshd binds to ALL interfaces
# (Nebula 10.10.0.10 + LAN/WiFi). Disabling password auth avoids opening a new
# LAN brute-force surface and matches the gateway posture. To allow password
# auth again, delete /etc/ssh/sshd_config.d/10-key-only.conf and restart sshd.
#
# Connect from bee/bees over Nebula:
#   ssh -o IdentitiesOnly=yes crussell@10.10.0.10
# Authorize the shared ed25519 key only (per-host key STATE — the key-only
# drop-in and `systemctl enable sshd` ship in the host image, Containerfile 3.9).
[group('system')]
ssh:
    #!/usr/bin/env bash
    set -euo pipefail
    install -d -m 700 "$HOME/.ssh"
    pub="$HOME/.ssh/id_ed25519.pub"
    auth="$HOME/.ssh/authorized_keys"
    touch "$auth"; chmod 600 "$auth"
    if [ -s "$pub" ]; then
      grep -qF "$(cat "$pub")" "$auth" || cat "$pub" >> "$auth"
      echo "  authorized: $(awk '{print $1, $3}' "$pub")"
    else
      echo "  WARN: $pub missing — no key added (install one manually)" >&2
    fi
    echo "==> key authorized. Connect over Nebula:"
    echo "    ssh -o IdentitiesOnly=yes crussell@10.10.0.10"
    sudo ss -tlnp 2>/dev/null | grep ':22 ' || true

# Sync the Nebula overlay hostnames into the live /etc/hosts NOW, without
# waiting for the next image upgrade + reboot. (sudo)
#
# The host image already bakes these entries into /usr/etc/hosts (Containerfile
# step 3.7), and ostree flows image defaults into /etc on upgrade — this recipe
# is the stopgap for a host that hasn't rebooted onto a hosts-carrying image
# yet. It appends the EXACT same fragment (hosts/thinkpad/host-image/
# nebula-hosts, generated from lib/host-meta.nix by
# `nix run .#render-thinkpad-hosts`), so when the image later ships the same
# bytes there is no conflict — ostree's 3-way merge stays clean and /etc/hosts
# keeps tracking the image default.
#
# Idempotent: no-ops when the file already ends with the current fragment;
# refreshes (marker-block replace) if host-meta.nix changed since the last sync.
# Do NOT hand-edit /etc/hosts afterwards — a modified file stops cleanly
# tracking image updates.
[group('system')]
hosts-sync:
    #!/usr/bin/env bash
    set -euo pipefail
    frag="{{ justfile_directory() }}/host-image/nebula-hosts"
    hosts=/etc/hosts
    [ -f "$frag" ] || { echo "ERROR: $frag missing (run from the cn repo)." >&2; exit 1; }
    # Already synced (file ends with exactly this fragment)? Untouched no-op —
    # important on an image-managed host: rewriting would mark /etc/hosts
    # user-modified and stop clean ostree merges.
    if tail -n "$(wc -l < "$frag")" "$hosts" | diff -q - "$frag" >/dev/null 2>&1; then
        echo "==> /etc/hosts already ends with the current fragment — nothing to do."
        getent hosts bees || true
        exit 0
    fi
    # Drop any previously synced block (marker line through EOF), then append
    # the fresh fragment. Safe: our block is always the file's tail.
    if grep -q '^# --- Nebula overlay hosts' "$hosts"; then
        echo "  replacing previously synced block (host-meta changed?)"
        sudo sed -i '\|^# --- Nebula overlay hosts|,$d' "$hosts"
    fi
    # Ensure the file ends with a newline before appending.
    [ -n "$(tail -c 1 "$hosts")" ] && printf '\n' | sudo tee -a "$hosts" >/dev/null
    sudo tee -a "$hosts" < "$frag" >/dev/null
    echo "==> appended Nebula overlay hosts to /etc/hosts:"
    tail -n +1 "$frag" | sed 's/^/    /'
    echo "==> resolution check:"
    getent hosts bees bee nas nebula-hetzner nebula-lh homeassistant

# Show the current state of this machine: host-image version, bootc deployment,
# bubblebox mounts + wrappers, and linked user units.
# Read-only.
[group('system')]
status:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "=== host image ==="
    cat /usr/lib/host-image-thinkpad-version 2>/dev/null || echo "(no version file)"
    echo
    echo "=== bootc ==="
    bootc status 2>&1 | head -30 || true
    echo
    echo "=== bubblebox mounts ==="
    mount | grep '/bubblebox/' || echo "(none mounted)"
    echo
    echo "=== bubblebox generation + footprint ==="
    {{ bubblebox_bin }} list
    echo
    echo "=== bubblebox wrappers (~/.local/bin/) ==="
    dst_bin="${HOME}/.local/bin"
    for t in $(python3 -c 'import tomllib; print(" ".join(tomllib.load(open("{{ bubblebox_profile }}","rb"))["packages"]))'); do
      if [ -x "${dst_bin}/${t}" ]; then echo "  ok   ${t}"; else echo "  MISS ${t}"; fi
    done
    echo
    echo "=== user units (~/.config/systemd/user/) ==="
    dst_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    if ls -1 "${dst_dir}"/*.service 2>/dev/null; then :; else echo "(none linked)"; fi

# ═══════════════════════════════════════════════════════════════════════════
# bees remote ops — llama.cpp LLM server (on-demand, OpenAI API on :8888)
# ═══════════════════════════════════════════════════════════════════════════
#
# bees serves local LLMs via a systemd TEMPLATE service (llama-server@<model>):
# the instance name is the GGUF basename in /var/lib/llama/models/ minus the
# .gguf extension. Only ONE model runs at a time (single :8888). Full ops
# guide: strix-halo-llm-serving skill; module: hosts/bees/llama-server.nix.
#
#   cjust llama           # start default model (Qwen3.8-27B), wait for :8888
#   cjust llama stop      # stop default model (frees VRAM immediately)
#   cjust llama status    # which model is running + systemd status
#   cjust llama models    # list GGUFs on bees (valid instance names)
#   cjust llama start L3.3-MS-Nevoria-70b-Q4_K_M    # start a different model
#
# Override the target with BEES=user@host (default crussell@10.10.0.6).

# Start/stop/restart/status the on-demand llama-server on bees over SSH.
# `start` refuses if a DIFFERENT model is already loaded (only one fits :8888)
# and then polls /v1/models until the server answers — loading the GGUF into
# VRAM takes ~30-60s for the 27B, so expect a short wait.
[group('bees')]
llama action="start" model="Qwen3.8-27B-UD-Q6_K_XL":
    #!/usr/bin/env bash
    set -euo pipefail
    BEES="${BEES:-crussell@10.10.0.6}"
    host="${BEES#*@}"
    act="{{ action }}"
    model="{{ model }}"
    case "$act" in
      models)
        echo "GGUFs on bees (/var/lib/llama/models/) — instance name = basename minus .gguf:"
        ssh -o IdentitiesOnly=yes "$BEES" 'ls -lh /var/lib/llama/models/'
        exit 0
        ;;
      status)
        ssh -o IdentitiesOnly=yes "$BEES" \
          "systemctl list-units --type=service --state=active --no-legend 'llama-server@*'; \
           systemctl status 'llama-server@${model}.service' --no-pager" || true
        exit 0
        ;;
      start|stop|restart) ;;
      *)
        echo "usage: cjust llama [start|stop|restart|status|models] [model]" >&2
        exit 1
        ;;
    esac
    # Which instance is currently active? (quote the @ pattern — remote zsh globs)
    running="$(ssh -o IdentitiesOnly=yes "$BEES" \
      "systemctl list-units --type=service --state=active --no-legend 'llama-server@*' \
       | awk '{print \$1}'")"
    running="${running%.service}"; running="${running#llama-server@}"
    if [ "$act" = start ] && [ -n "$running" ]; then
      if [ "$running" = "$model" ]; then
        echo "==> ${model} already running — checking health"
      else
        echo "ERROR: ${running} is loaded and only one model fits :8888." >&2
        echo "       Stop it first:  cjust llama stop ${running}" >&2
        exit 1
      fi
    fi
    ssh -o IdentitiesOnly=yes "$BEES" "sudo systemctl ${act} 'llama-server@${model}.service'"
    [ "$act" = start ] || exit 0
    echo "==> waiting for ${model} to load into VRAM ..."
    for _ in $(seq 1 60); do
      if curl -sf "http://${host}:8888/v1/models" >/dev/null 2>&1; then
        echo "==> serving on http://${host}:8888/v1 :"
        curl -sf "http://${host}:8888/v1/models"; echo
        exit 0
      fi
      sleep 2
    done
    echo "ERROR: :8888 not answering after 120s — check with:" >&2
    echo "  ssh $BEES 'journalctl -u llama-server@${model} -n 50'" >&2
    exit 1

# ═══════════════════════════════════════════════════════════════════════════
# BUZZ DESKTOP (block/buzz AppImage; buzz-revival step 2)
#
# The AppImage + data live at ~/.local/share/buzz-desktop/, managed by the
# bubblebox-deployed updater script (~/.local/bin/buzz-desktop). The app's
# own Tauri updater ships endpoint-less (updater.endpoints = []), so OUR
# daily timer owns updates: GitHub releases API, sha256-digest-verified,
# atomic swap, one-generation rollback (.prev).
# After editing anything under bubblebox/: `cjust bubblebox-apply`.
# ═══════════════════════════════════════════════════════════════════════════

[group('buzz')]
buzz-install:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -x "$HOME/.local/bin/buzz-desktop" ]; then
      echo "==> updater script not applied yet — run cjust bubblebox-apply first" >&2
      exit 1
    fi
    "$HOME/.local/bin/buzz-desktop"
    echo "==> launch from the app grid (Buzz), or: ~/.local/share/buzz-desktop/Buzz.AppImage"
    echo "==> daily update timer:"; systemctl --user list-timers --all 'buzz-desktop-update.timer' --no-pager || true

# Manual update check (same engine the timer runs)
[group('buzz')]
buzz-update: buzz-install

[group('buzz')]
buzz-status:
    #!/usr/bin/env bash
    set -euo pipefail
    v="$(cat "$HOME/.local/share/buzz-desktop/version" 2>/dev/null || true)"
    echo "installed: ${v:-<none>}"
    ls -lh "$HOME/.local/share/buzz-desktop/" 2>/dev/null || true
    systemctl --user list-timers --all 'buzz-desktop-update.timer' --no-pager || true
