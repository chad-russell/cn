# eza — modern ls replacement, installed via cargo from a rust:bookworm build
# stage. Same shape as bat/dust: cargo install -> distroless cc-debian12 runtime
# with the few non-default shared libs it needs copied alongside.
FROM rust:bookworm AS build
RUN cargo install eza --root /out
# Gather eza's runtime shared libraries that distroless cc-debian12 doesn't ship
# (e.g. libz). glibc/libgcc/libstdc++ are skipped because distroless already has them.
RUN mkdir -p /libs \
 && ldd /out/bin/eza | awk '/=> \// {print $3}' | sort -u \
 | grep -vE 'libc\.so|libm\.so|libdl\.so|libpthread\.so|librt\.so|libgcc_s\.so|libresolv\.so|libBrokenLocale|ld-linux|libstdc\+\+\.so' \
 | while read lib; do cp -L "$lib" /libs/; done
# Pre-create FHS mountpoints that distroless lacks, so bwrap can bind host dirs.
RUN mkdir -p /dirs/mnt /dirs/media /dirs/opt /dirs/srv \
 && touch /dirs/mnt/.keep /dirs/media/.keep /dirs/opt/.keep /dirs/srv/.keep

FROM gcr.io/distroless/cc-debian12
COPY --from=build /out/bin/eza /usr/bin/eza
COPY --from=build /libs/ /usr/lib/x86_64-linux-gnu/
COPY --from=build /dirs/ /
