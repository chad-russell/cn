# gh — GitHub CLI from Fedora, with git + openssh-clients vendored alongside.
#
# gh shells out to git for repo operations (clone, pr checkout, ...), and git
# needs ssh for SSH-protocol clones (gh defaults to https, but ssh remotes are
# common). Auth tokens & prefs stay at ~/.config/gh/ (machine-local, secret) —
# reached via writable_home in entrypoints/gh.toml; ssh keys at ~/.ssh/ likewise.
#
# Plain dnf install (no --setopt=install_weak_deps=False) so weak deps (pager,
# etc.) flow in — same as aws.
FROM fedora:latest
RUN dnf install -y gh git openssh-clients \
 && dnf clean all
