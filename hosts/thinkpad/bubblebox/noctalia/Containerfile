# noctalia — desktop shell (notifications, volume, brightness, nightlight,
# panels, session lock), from the lionheartp/Hyprland COPR as `noctalia-git`.
#
# Why a Fedora base + COPR (not scratch/cargo): noctalia is a system-level GTK
# app — owns D-Bus names (org.freedesktop.Notifications), renders layer-shell
# surfaces, talks to logind/PipeWire. Fedora + dnf gives us the COPR's binary
# plus the full system-integration dep set (mesa, pipewire-libs, glib, gtk)
# matched to the image's glibc.
#
# No `systemd` package: noctalia talks to logind via D-Bus directly (libs come
# as deps), not via systemd-run shims. Keeps the rootfs lean.
#
# Daemon + per-keypress client model: `bubblebox-run noctalia` starts the
# daemon once at session boot; `bubblebox-run noctalia msg volume-up` is the
# client (mount is already up from the daemon start, so per-keypress cost is
# just a fresh bwrap namespace). The two talk over an IPC socket under
# $XDG_RUNTIME_DIR, which is writable via WRITABLE_RUN=1 in the profile.
#
# No vendored config: noctalia has no authored file config — it uses
# dconf/gsettings over the session bus, sharing the host's theme/font and
# persisting its own state in ~/.config (writable via WRITABLE_HOME=1).
FROM fedora:latest
RUN dnf -y install dnf-plugins-core \
 && dnf -y copr enable lionheartp/Hyprland \
 && dnf -y install \
      noctalia-git \
      mesa-dri-drivers \
      mesa-vulkan-drivers \
      vulkan-loader \
      pipewire-libs \
 && dnf clean all
