#!/bin/sh
# vicinae-launch — launch a HOST app from inside the vicinae bubblebox.
#
# vicinae runs inside the box; the apps it lists (and their .desktop Exec lines)
# target the HOST rootfs, where the binaries actually live. This script is
# vicinae's `launchPrefix` (set in dotfiles/.config/vicinae/settings.json): it
# asks the HOST's user systemd manager to run the command on the host, reached
# through the $XDG_RUNTIME_DIR socket that bubblebox-run binds into the box
# (authenticated by uid). Same `systemd-run --user` host-escape model as
# bin/bubblebox-host-shell, but fire-and-forget (no --pty/--same-dir/--wait)
# because app launches aren't interactive shells.
#
# Why the /bin/sh -c indirection: systemd-run validates that the target binary
# exists in the CALLER's namespace (this sandbox) BEFORE submitting the job.
# The vicinae image is minimal (just systemd + vicinae) — it doesn't ship the
# host apps vicinae lists (flatpak, firefox, …), so naming the .desktop Exec
# binary directly makes validation fail and NO transient unit is ever created
# (the app silently doesn't launch — vicinae doesn't check launchPrefix exit
# codes). /bin/sh is in every base image, so systemd-run accepts it; once
# systemd actually runs the job in the host scope, sh's `exec "$0" "$@"`
# re-execs as the real binary using the HOST's binaries. Positional $0 is the
# app binary, "$@" is its args (both passed through from vicinae via
# launchPrefix). This is the same trick bin/bubblebox-host-shell uses.
#
# Flags:
#   --user      talk to the user manager, not the system manager
#   --collect   auto-remove the transient unit when the app exits
#   --quiet     suppress the "Running as unit: ..." notice
#   no --wait   start the unit and return immediately so vicinae isn't blocked
set -eu

exec systemd-run --user --collect --quiet -- /bin/sh -c 'exec "$0" "$@"' "$@"
