#!/bin/sh
# vicinae-launch — launch a HOST app from inside the vicinae shellbox.
#
# vicinae itself runs inside the box; the apps it lists (and their .desktop
# Exec lines) target the HOST rootfs, where the binaries actually live. This
# script is vicinae's `launchPrefix`: it asks the HOST's user systemd manager
# to run the command on the host, reached through the $XDG_RUNTIME_DIR socket
# that shellbox binds into the box (and authenticates by uid).
#
# This is the same `systemd-run --user` model shellbox's [host] tools use
# (see shellbox AGENTS.md "Host tools"), generalized to arbitrary commands
# instead of one named shim per binary — vicinae needs the generic form
# because launchPrefix is a single prefix string applied to any app.
#
# Flags:
#   --user      talk to the user manager, not the system manager
#   --collect   auto-remove the transient unit when the app exits
#   --quiet     suppress the "Running as unit: ..." notice
#   no --wait   start the unit and return immediately so vicinae isn't blocked
set -eu

exec systemd-run --user --collect --quiet -- "$@"
