# vicinae — application launcher, from the quadratech188/vicinae COPR.
#
# Runtime model (mirrors the shellbox vicinae box):
#   - vicinae runs inside the sandbox; the apps it lists live on the HOST.
#   - `bubblebox-run vicinae server --replace` starts the daemon at session
#     boot; `bubblebox-run vicinae toggle` is the per-keypress client. They
#     share an IPC socket under $XDG_RUNTIME_DIR (writable via WRITABLE_RUN=1
#     in the profile).
#   - Host apps launch via vicinae-launch (vendored here; vicinae's
#     `launchPrefix` — set in dotfiles/.config/vicinae/settings.json — points
#     at it). It escapes to the host user systemd manager via
#     `systemd-run --user`. Same host-escape pattern as bin/bubblebox-host-shell,
#     but without the pty/same-dir machinery because app launches are
#     fire-and-forget, not interactive shells.
#
# `systemd` is installed explicitly for systemd-run (the host-escape primitive).
#
# Config (settings.json, incl. launchPrefix=vicinae-launch) is NOT vendored in
# the image. It lives at dotfiles/.config/vicinae/settings.json, symlinked into
# ~/.config/vicinae/ by `cjust link`. vicinae reads/writes it there through
# WRITABLE_HOME=1 — same dotfiles-symlink-over-$HOME model as wezterm/cosmic/niri.
FROM fedora:latest
RUN dnf -y install dnf-plugins-core \
 && dnf -y copr enable quadratech188/vicinae \
 && dnf -y install \
      systemd \
      vicinae \
 && dnf clean all

# Host-app launcher shim — escapes to the user systemd manager on the host
# via the $XDG_RUNTIME_DIR socket bubblebox-run binds.
COPY vicinae-launch /usr/local/bin/vicinae-launch

RUN chmod 0755 /usr/local/bin/vicinae-launch
