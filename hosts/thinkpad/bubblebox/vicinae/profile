# Per-tool bubblewrap profile, sourced by bubblebox-run.
#
# vicinae runs inside the sandbox; the apps it lists are host binaries. The
# vendored vicinae-launch (launchPrefix in dotfiles/.config/vicinae/settings.json)
# bridges the two by calling `systemd-run --user`, escaping to the host user
# systemd manager through the $XDG_RUNTIME_DIR socket bubblebox-run binds.
#
# Daemon + per-keypress client: same model as noctalia — the server mounts the
# box once at session boot, the toggle client pays only a fresh bwrap namespace
# per call.

WRITABLE_HOME=1   # vicinae persists its state in ~/.config
WRITABLE_RUN=1    # IPC socket + Wayland + session bus live under /run/user/$UID

# GPU render node access. bubblebox-run's `--dev /dev` gives a fresh devtmpfs
# with no /dev/dri, so we create the dir and bind the host's in.
if [ -d /dev/dri ]; then
  BWRAP_EXTRA+=(
    --dir /dev/dri
    --bind /dev/dri /dev/dri
  )
fi

# /sys for Mesa/Vulkan render-node enumeration (same as noctalia).
if [ -d /sys ]; then
  BWRAP_EXTRA+=(
    --ro-bind-try /sys /sys
  )
fi

# Host .desktop files, icons, and fonts. The sandbox rootfs is a stock Fedora
# image with none of the host's installed apps; without these binds vicinae
# would list nothing and render no icons. --ro-bind-try so the box still
# constructs on a headless/CI host where any of these are absent.
for d in applications icons fonts; do
  if [ -d "/usr/share/$d" ]; then
    BWRAP_EXTRA+=( --ro-bind "/usr/share/$d" "/usr/share/$d" )
  fi
done
