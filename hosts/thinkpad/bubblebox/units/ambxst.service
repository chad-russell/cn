[Unit]
Description=Ambxst desktop shell (under niri)
# Mirrors the retired caelestia-shell.service pattern: enabled via
# niri.service.wants so the shell starts exactly when niri does. The same
# ambxst binary also runs under Hyprland (started from hyprland.lua there —
# don't enable this unit for graphical-session.target or it would
# double-start in a Hyprland session).
PartOf=niri.service
PartOf=graphical-session.target
After=niri.service
After=graphical-session.target
# Rate-limit: a startup race should cost a 1s blip, not a restart loop.
# StartLimit* MUST live in [Unit] — systemd ignores them elsewhere.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# ambxst supervises the quickshell shell + axctl + wl-paste; all three are
# on /usr/bin. Shell QML sources resolve via ~/.local/share/ambxst/shell_repo.
# PATH prepends ~/.local/bin: the user-side matugen 4.2 lives there (the
# image ships 3.1 from Fedora; Ambxst's Material You pipeline needs
# --source-color-index, added in 4.x) — without this the niri-side unit
# spawns the old matugen and theming silently fails.
Environment="PATH=%h/.local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/ambxst
Restart=on-failure
RestartSec=1

[Install]
WantedBy=niri.service
