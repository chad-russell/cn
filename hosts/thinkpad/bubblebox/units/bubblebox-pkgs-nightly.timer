# Nightly trigger for bubblebox-pkgs-nightly.service. Persistent= so a
# suspended-at-night thinkpad catches up on first wake.
[Unit]
Description=Nightly bubblebox-pkgs verification run

[Timer]
# Off the :00 mark (avoid colliding with everything else that fires at
# midnight-ish); randomized spread keeps it off other nightly jobs.
OnCalendar=*-*-* 03:42:00
RandomizedDelaySec=20m
Persistent=true

[Install]
WantedBy=timers.target
