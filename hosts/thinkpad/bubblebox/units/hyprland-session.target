[Unit]
Description=Hyprland compositor session
# Bridge unit: Fedora's start-hyprland wrapper doesn't start the systemd
# user graphical session (niri/GNOME do). Hyprland's Lua config starts THIS
# target at hyprland.start; Wants/After dependency-starts
# graphical-session.target (which refuses manual start), pulling in user
# units bound to it (vicinae launcher daemon). Do NOT enable — the
# compositor starts it.
Wants=graphical-session.target
After=graphical-session.target
