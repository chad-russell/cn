[Unit]
Description=Dux Modular Shell (DMS) under Umbriel
# DMS (ex-DankMaterialShell) is the Umbriel session's shell: bar, launcher
# (secondary to vicinae), notifications, lock screen, settings (2026-11, the
# Hyprland/MangoWM retirement). Starts with the umbriel session only --
# NEVER graphical-session.target -- so it does not run in niri (Ambxst) or
# GNOME sessions.
PartOf=umbriel-session.target
PartOf=graphical-session.target
After=umbriel-session.target
After=graphical-session.target
# Readiness waits for the tray host, so tray apps ordered after tray.target
# find it (mirrors the rpm's dms.service).
Before=tray.target
# Rate-limit: a startup race should cost a ~1s blip, not a restart loop
# (same rationale as ambxst.service). StartLimit* MUST live in [Unit].
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Faithful copy of the dms rpm's dms.service [Service] (v2.1) so behavior
# matches upstream; only the binding differs (ours: umbriel-session.target,
# upstream unit ships WantedBy=graphical-session.target but is NOT enabled
# by default -- a deliberately separate unit avoids shadowing it in
# ~/.config/systemd/user, which would mask future rpm updates to it).
Type=notify
BusName=org.freedesktop.Notifications
NotifyAccess=main
Environment=QS_DISABLE_CRASH_HANDLER=1
# PATH prepends ~/.local/bin: vicinae + bubblebox wrappers (the dms CLI
# spawns dmenu/terminal helpers; the spotlight's terminal action resolves
# host wrappers too).
Environment="PATH=%h/.local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/dms run --session
ExecReload=/bin/kill -USR1 $MAINPID
LimitNOFILE=16384:infinity
Restart=on-failure
RestartForceExitStatus=TEMPFAIL
SuccessExitStatus=TEMPFAIL
RestartSec=1.23
TimeoutStartSec=90s
TimeoutStopSec=10

[Install]
WantedBy=umbriel-session.target
