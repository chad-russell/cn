[Unit]
Description=niri-caelestia-shell (our quickshell fork)
# Wired via niri.service.wants (the [Install] below), so the shell starts
# exactly when the niri compositor starts — never under GNOME/other
# sessions. PartOf both niri and the graphical session so it stops (and
# restarts) with the compositor.
PartOf=niri.service
PartOf=graphical-session.target
After=niri.service
After=graphical-session.target
# Rate-limit: a startup race (quickshell 0.3.x posted-event UAF family —
# SIGSEGV in sendPostedEvents, seen once live 2026-09-02) then costs a 1s
# blip instead of a dead shell; give up rather than spin after 5/min.
# NOTE: StartLimit* MUST live in [Unit], not [Service] — systemd ignores
# them elsewhere.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# qs resolves the user clone at ~/.config/quickshell/niri-caelestia-shell
# first (iteration surface), falling back to the image copy at
# /etc/xdg/quickshell/niri-caelestia-shell — same config name, Quickshell
# lookup order. WAYLAND_DISPLAY/NIRI_SOCKET come from the user manager
# environment (niri-session imports them); CAELESTIA_VIRTUAL_ENV from
# environment.d/caelestia.conf.
ExecStart=/usr/bin/qs -c niri-caelestia-shell
Restart=on-failure
RestartSec=1

[Install]
WantedBy=niri.service
