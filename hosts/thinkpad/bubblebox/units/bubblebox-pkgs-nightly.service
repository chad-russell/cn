# bubblebox-pkgs nightly CI (DESIGN-ecosystem.md §3.3) — the E0 quality bar.
# Runs tools/verify.sh over the WHOLE package source (lint -> build -> smoke
# -> footprint gate) in a fully isolated bubblebox store/run/config, so it
# never touches the host's real generation or the internal cache. The FUSE
# server is pinned explicitly (the isolated env's binary is the engine repo's
# release build, whose beside-the-exe/repo fallbacks this guarantees).
[Unit]
Description=bubblebox-pkgs nightly verification (isolated store; never publishes)
# Skip cleanly if the checkout or engine moved (e.g. pre-clone host) instead
# of failing every night.
ConditionPathExists=%h/Code/bubblebox-pkgs/tools/nightly.sh
ConditionPathExists=%h/Code/bubblebox/target/release/bubblebox

[Service]
Type=oneshot
# A full cold verify (26 pkgs incl. podman builds) takes ~20 min; even warm
# runs exceed systemd's 90s default start timeout by far.
TimeoutStartSec=45min
Environment=PKGS_REPO=%h/Code/bubblebox-pkgs
Environment=ENGINE_BIN=%h/Code/bubblebox/target/release/bubblebox
Environment=BUBBLEBOX_FUSE_BIN=%h/Code/bubblebox/fuse-mount/target/release/bubblebox-fuse
Environment=RUN_HOME=%h/.local/state/bubblebox-nightly
Environment=PATH=/usr/bin:/bin:/usr/sbin
# Nice it slightly: it shares the workstation with interactive use.
Nice=10
IOSchedulingClass=idle
ExecStart=%h/Code/bubblebox-pkgs/tools/nightly.sh
