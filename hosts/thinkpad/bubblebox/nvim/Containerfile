# neovim — installed via dnf from a Fedora base.
#
# Why a distro base (not a prebuilt or scratch)? nvim with lazy.nvim needs a
# C toolchain at runtime (treesitter parsers + telescope-fzf-native build via
# `make`), git (lazy clones plugins). Fedora's dnf gives us a recent nvim
# (>= 0.11) and all of those through one package manager. Pin `fedora:NN`
# instead of `latest` for fully reproducible builds.
#
# rg/fd are NOT installed here: they're composed in at runtime from their own
# packages via the bubblebox entrypoint's compose list (see
# entrypoints/nvim.toml). This keeps nvim's image leaner and lets rg/fd be
# shared with their standalone packages. Telescope's live_grep (rg) and
# find_files (fd) reach them through the overlay.
FROM fedora:latest
RUN dnf install -y --setopt=install_weak_deps=False \
      neovim \
      git make gcc \
      unzip ca-certificates \
 && dnf clean all

# Vendored config. bubblebox-run sets XDG_CONFIG_HOME=/usr/share/bubblebox so
# nvim reads /usr/share/bubblebox/nvim/init.lua and never touches the host's
# ~/.config/nvim.
COPY config/ /usr/share/bubblebox/nvim/

# /persist is bind-mounted from $BUBBLEBOX_DATA_DIR/nvim at runtime, holding
# nvim's isolated data/state/cache so nothing leaks into the host $HOME.
RUN mkdir -p /persist
