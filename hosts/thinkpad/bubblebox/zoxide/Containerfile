# zoxide — smarter cd, installed via cargo from a rust:bookworm build stage.
# Same shape as bat/dust/eza: cargo install -> distroless cc-debian12 runtime.
# zoxide has no native/shared deps beyond glibc/libgcc, so /libs/ ends up empty
# in practice — kept in the pattern for consistency with sibling tools.
FROM rust:bookworm AS build
RUN cargo install zoxide --root /out
# Gather zoxide's runtime shared libraries that distroless cc-debian12 doesn't ship.
# glibc/libgcc/libstdc++ are skipped because distroless already has them.
RUN mkdir -p /libs \
 && ldd /out/bin/zoxide | awk '/=> \// {print $3}' | sort -u \
 | grep -vE 'libc\.so|libm\.so|libdl\.so|libpthread\.so|librt\.so|libgcc_s\.so|libresolv\.so|libBrokenLocale|ld-linux|libstdc\+\+\.so' \
 | while read lib; do cp -L "$lib" /libs/; done
# Pre-create FHS mountpoints that distroless lacks, so bwrap can bind host dirs.
RUN mkdir -p /dirs/mnt /dirs/media /dirs/opt /dirs/srv \
 && touch /dirs/mnt/.keep /dirs/media/.keep /dirs/opt/.keep /dirs/srv/.keep
# /persist is bind-mounted from $BUBBLEBOX_DATA_DIR/zoxide at runtime (see
# profile), holding zoxide's database so it survives across runs. distroless
# needs the dir + a .keep file to survive the multi-stage COPY.
RUN mkdir -p /persist && touch /persist/.keep

FROM gcr.io/distroless/cc-debian12
COPY --from=build /out/bin/zoxide /usr/bin/zoxide
COPY --from=build /libs/ /usr/lib/x86_64-linux-gnu/
COPY --from=build /dirs/ /
COPY --from=build /persist/ /persist/
