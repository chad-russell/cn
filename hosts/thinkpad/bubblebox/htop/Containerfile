# htop — interactive process viewer, from Fedora.
#
# Why Fedora (not cargo/distroless): htop is C + ncurses, reads /proc heavily,
# and is a TUI app that talks to the terminal directly. Fedora's dnf gives us
# a recent htop plus ncurses and the few deps it needs, all matched to the
# image's glibc — simpler than cross-building from source and statically
# linking ncurses (which would also force a terminfo dir to ship along).
FROM fedora:latest
RUN dnf install -y --setopt=install_weak_deps=False htop \
 && dnf clean all
