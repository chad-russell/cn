[Unit]
# opencode-web.service — run the opencode web frontend as a user service.
#
# Installed by `cjust units` (symlinks every unit in systemd/user/ into
# ~/.config/systemd/user/, daemon-reloads, and enables lingering). Then:
#
#     systemctl --user enable --now opencode-web.service
#
# The opencode binary, node, and all storage live inside the `opencode` box
# (shellboxes/opencode); this unit just calls into it via `shellbox run`. The
# XDG redirection (config/data/state/cache → the box dir) is applied by
# run_in_box from the manifest, so this unit needs no env setup.
#
# Requires the box to be mounted. The composefs mount is brought up at boot by
# the system template unit shellbox-mount@opencode.service (baked in the host
# image, enabled per-box with `systemctl enable shellbox-mount@opencode.service`).
# `After=` here only orders; a user service can't pull a system unit up on
# demand, so the mount must be enabled for boot — which that template does.
#
# Port: opencode's `web` subcommand defaults --port to 0 (random). We pin
# --port 4096 for a stable URL. Default hostname is 127.0.0.1 (localhost only);
# expose externally later by reverse-proxying via Caddy if desired.

[Unit]
Description=opencode web frontend (shellbox)
# Order after the system mount unit so that on a fresh boot the composefs
# mount is already up by the time this starts. (Ordering across the user/
# system boundary is allowed; only pulling it up on-demand needs polkit, which
# is why the mount is boot-enabled by enabling shellbox-mount@opencode.service
# directly instead.)
After=shellbox-mount@opencode.service

[Service]
Type=simple
ExecStart=%h/.local/bin/shellbox run opencode -- opencode web --port 4096
Restart=on-failure
RestartSec=5
# Keep the working directory predictable; shellbox run uses cwd as the in-box
# cwd (falling back to $HOME if outside it).
WorkingDirectory=%h

[Install]
WantedBy=default.target
