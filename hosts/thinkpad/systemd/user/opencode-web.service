[Unit]
Description=opencode web frontend
# opencode is installed host-native via npm to ~/.local/bin/opencode.
# Enable with: systemctl --user enable --now opencode-web.service

[Service]
Type=simple
ExecStart=%h/.local/bin/opencode web --port 4096
Restart=on-failure
RestartSec=5
WorkingDirectory=%h

[Install]
WantedBy=default.target
