# Custom Fedora Silverblue image for the ThinkPad -- "bluefin-style".
#
# A thin layer over stock Silverblue. The active host-level changes:
#   - add `distrobox` (the base image's `toolbox` stays -- deliberate,
#     2026-09-24: it can't hurt next to distrobox/podman).
#   - install the compositor stack (niri + our shell fork) from COPRs.
#     (desktoppak, the old per-user bwrap payload layer, was retired
#     2026-09-01 -- the normal bootc/image path won; see host-image/README.md.)
#
# This image uses the modern bootc-native build model, matching current
# Bluefin/finpilot (projectbluefin/finpilot):
#   - `dnf5` for all package changes at build time (NOT `rpm-ostree`).
#     finpilot's AGENTS.md is explicit: "Use dnf5 exclusively (never dnf, yum,
#     rpm-ostree)". In a bootc container build dnf5 writes straight into the
#     image's /usr, so a plain `dnf5 remove` drops a base package -- no
#     `rpm-ostree override remove` needed (that was an rpm-ostree *client*
#     concept; at build time the tree is just a writable filesystem).
#   - `bootc container lint` to finalize/validate (replaces the old
#     `ostree container commit`).
#   - Switched/deployed with `bootc`, not `rpm-ostree` (see switch.sh).
#   bootc still uses ostree/libostree under the hood -- it's the stable,
#   future-facing front-end (per bootc-status(8): "bootc and rpm-ostree share
#   the same code").
#
# Built ON BEES (daily timer + on-demand `cjust image-rebuild`) and published
# to the homelab zot registry; the thinkpad pulls from there. Local
# build.sh/switch.sh remain as the break-glass path. See README.md.
#
# Base image: the same one ublue/bluefin/finpilot derive from.

ARG FEDORA_MAJOR_VERSION=44
FROM quay.io/fedora-ostree-desktops/silverblue:${FEDORA_MAJOR_VERSION}

# ---- 1. distrobox added (toolbox stays) ---------------------------------
# `dnf5 install` pulls distrobox from the Fedora repos; the base image's
# `toolbox` is intentionally left in place (harmless alongside
# distrobox/podman). The cache mounts persist the dnf cache across
# rebuilds so repeated builds are fast (finpilot/lina-bh pattern).
#
# NOTE: this does NOT change the bespoke dev container in ../toolbox (that one
# stays a plain podman create with a separate $HOME). distrobox here just gives
# the `distrobox` CLI on the host for ad-hoc containers, alongside `toolbox`.
#
# `just` and `fzf` are host-native on purpose: they back the `cjust` task menu
# (hosts/thinkpad/Justfile + the cjust function in bubblebox/files/.zshrc). Like
# oh-my-posh they can't live in a bubblebox -- `cjust` must run before any box
# is set up. (`just` was previously borrowed from the `default` box, which
# made the menu depend on the thing it bootstraps; `fzf` backs `just --choose`.)
# `nodejs` + `npm` are host-native for the hermes desktop app build
# (`cjust hermes-desktop-build` runs npm directly; see Justfile).
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    dnf5 -y install distrobox zsh just fzf nodejs npm

# ---- 1.5. FUSE 2 (libfuse.so.2) for type-2 AppImages --------------------
# This is an ostree/bootc image, so we can't layer via `rpm-ostree install`
# on the running host -- packages must be baked in at build time. Fedora 44
# DROPPED the FUSE 2 libraries from the Atomic Desktop base images (the F44
# change proposal "Atomic Desktops: Drop FUSE 2 libraries"), so the base
# Silverblue here ships only FUSE 3 (libfuse.so.3). Classic (type-2)
# AppImages dlopen() libfuse.so.2 to mount themselves and abort with "error
# loading libfuse.so.2" without it. `fuse-libs` is still shipped in the
# Fedora 44 repos and re-installing it is the documented fix. (`fuse2`
# works too, but fuse-libs is the minimal runtime shim; AppImage's
# mount-and-run path doesn't need the fusermount helper.) Added for PhysCAD;
# enables native `./AppImage` launch instead of --appimage-extract-and-run.
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    dnf5 -y install fuse-libs

# ---- 2. Desktop stack: niri + our niri-caelestia-shell fork --------------
# niri comes from the upstream maintainer's COPR (yalter/niri), which tracks
# newer than Fedora's package. xwayland-satellite provides niri's X11 app
# support (niri has no native XWayland). dnf5-plugins supplies the `dnf5 copr`
# subcommand used below; it is installed in the same transaction, so the
# subcommand is available to the very next `&&` in this RUN. The cache mounts
# keep COPR downloads fast across rebuilds, matching step 1.
#
# Hyprland + Caelestia-shell were REMOVED 2026-09-02 (trial concluded; the
# keeper is niri + our own fork of niri-caelestia-shell, see below). satty,
# dart-sass, and the mineiro/hyprland COPR were Hyprland-trial baggage and
# leave with it. peterwu/rendezvous stays: it only ever supplied
# bibata-cursor-themes, which the cursor setup (niri xcursor-theme + user
# gsettings) still uses.
#
# The shell stack for niri (fork: github.com/chad-russell/niri-caelestia-shell,
# our maintenance fork of AyushKr2003's archived port of Caelestia to niri):
#   - `quickshell` from errornointernet/quickshell (F44 release build 0.3.x --
#     the QML runtime the fork's shell runs on).
#   - fonts + materialyoucolor from gmanka/caelestia -- the ONE thing we keep
#     that COPR for (material-symbols-fonts, cascadia-code-nerd-fonts,
#     python3-materialyoucolor); caelestia-shell itself is NOT installed.
#   - `app2unit` from celestelove/app2unit (the fork's app-launcher helper:
#     launches apps as transient user units, scoped to the graphical session).
#   - `libcava` (+ devel, tiny) from celestelove/libcava -- the audio-
#     visualizer lib the shell's C++ plugin links for the audio visualizer
#     widget (plugin built in step 2.5 below).
#
# Runtime deps for the fork (each verified available on F44):
#   matugen (Fedora proper -- the Material-You color pipeline), nmcli via
#   NetworkManager (base image), kdialog + kf6-kirigami + kf6-syntax-
#   highlighting + plasma-integration (Qt dialogs/theme), swappy +
#   tesseract-langpack-eng + wf-recorder (screenshot annotate/OCR/record),
#   ydotool/wtype (virtual input), translate-shell, cava (CLI visualizer),
#   libqalculate + qalculate (launcher calc mode), pavucontrol, lm_sensors,
#   geoclue2 (weather location), fish (launcher calc mode), jq/bc/rsync/
#   xdg-user-dirs/xdg-utils (shell scripts), nm-connection-editor (tray NM
#   state). Portals: the niri-friendly set (gnome screen-share + gtk).
#
# NO dolphin/system-settings: their weak-dep chain pulls in the entire Plasma
# workspace (plasma.desktop session included). nautilus (GNOME base) is the
# file manager; the fork's file-manager config default just points at a
# binary -- nautilus covers it. install_weak_deps=False keeps other recommends
# (fonts, extra modules) from ballooning the image the same way.
#
# COSMIC soft-removed 2026-09-01: not in active use; revisit in a few months
# to check epoch progress. To restore, un-comment the cosmic lines below and
# rebuild (`cjust image-rebuild`). Settings are already backed up in-repo
# (cjust cosmic-backup -> bubblebox/files/.config/cosmic/).
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    dnf5 -y install dnf5-plugins \
    && dnf5 -y copr enable yalter/niri \
    # && dnf5 -y copr enable ryanabx/cosmic-epoch \
    && dnf5 -y copr enable errornointernet/quickshell \
    && dnf5 -y copr enable gmanka/caelestia \
    && dnf5 -y copr enable celestelove/libcava \
    && dnf5 -y copr enable celestelove/app2unit \
    && dnf5 -y copr enable peterwu/rendezvous \
    # --refresh: the cache mount (type=cache,dst=/var/cache/libdnf5) persists
    # rpm-md across builds with a 48h default TTL; when Fedora supersedes a
    # build (assimp 6.0.5-5 -> -6, 2026-10-21) cached metadata kept resolving
    # the dead rpm and every mirror 404ed. --refresh forces fresh metadata
    # whenever this layer re-executes.
    && dnf5 -y --refresh --setopt=install_weak_deps=False install \
                       niri xwayland-satellite bibata-cursor-themes \
                       quickshell app2unit libcava libcava-devel \
                       material-symbols-fonts cascadia-code-nerd-fonts \
                       python3-materialyoucolor matugen adw-gtk3-theme \
                       kf6-kirigami kf6-syntax-highlighting kdialog plasma-integration \
                       qt6-qt5compat qt6-qtmultimedia qt6-qtquicktimeline \
                       wl-clipboard cliphist grim slurp swappy \
                       tesseract tesseract-langpack-eng wf-recorder \
                       ydotool wtype translate-shell cava \
                       libqalculate qalculate pavucontrol lm_sensors \
                       geoclue2 \
                       xdg-desktop-portal-gnome xdg-desktop-portal-gtk \
                       jq bc curl wget rsync \
                       xdg-user-dirs xdg-utils libnotify brightnessctl \
                       ddcutil playerctl upower nm-connection-editor \
                       breeze-icon-theme
    # Hyprland + MangoWM REMOVED 2026-11 (trial concluded; the keeper is
    # ShojiWM): the suite lines, the mineiro/hyprland COPR, step 2.4's uwsm
    # session surgery, and step 2.7's hyprpm build deps all went together.
    # waybar left with them. The second-session role then went Umbriel + DMS
    # -> ShojiWM + shoji-bar-4 (Umbriel + DMS retired 2026-11, see step 2.8).
    # ripgrep removed 2026-10-15: duplicate of the bubblebox `rg` package
    # (the ~/.local/bin wrapper shadows /usr/bin/rg anyway). fish removed:
    # unused (login shell is zsh; no terminal profile or spawn references).
    # jq/curl/wget/rsync STAY: host-image infra runs them OUTSIDE any bubblebox
    # sandbox (thinkpad-image-update, the restic ntfy template, the cjust
    # recipes) and system units have no ~/.local/bin on PATH.
    # && dnf5 -y install cosmic-desktop

# ---- 2.5. Ambxst shell binaries (all compositors) -------------------------
# Ambxst replaces the retired niri-caelestia-shell fork (2026-11): one Go
# binary supervising a quickshell shell + axctl, running under niri (the
# ShojiWM session runs shoji-bar-4 instead -- step 2.8). Pinned release, SHA256-verified. The shell QML sources clone
# per-user to ~/.local/src/ambxst (ambxst finds them via the pointer file
# ~/.local/share/ambxst/shell_repo; axctl.toml there maps compositor
# targets). Phosphor icon fonts install user-side with the sources.
RUN curl -fsSL https://github.com/Axenide/Ambxst/releases/download/1.3.12/ambxst-linux-amd64 -o /tmp/ambxst-linux-amd64 \
    && curl -fsSL https://github.com/Axenide/Ambxst/releases/download/1.3.12/SHA256SUMS -o /tmp/ambxst.SHA256SUMS \
    && (cd /tmp && sha256sum --check --ignore-missing ambxst.SHA256SUMS) \
    && install -m 755 /tmp/ambxst-linux-amd64 /usr/bin/ambxst \
    && curl -fsSL https://github.com/Axenide/axctl/releases/download/v0.0.29/axctl_linux_amd64 -o /tmp/axctl \
    && install -m 755 /tmp/axctl /usr/bin/axctl \
    && rm -f /tmp/ambxst-linux-amd64 /tmp/ambxst.SHA256SUMS /tmp/axctl

# ---- 2.8. ShojiWM (the second compositor; 2026-11) -------------------------
# ShojiWM (github.com/bea4dev/ShojiWM -- Smithay-based, TypeScript-configured,
# with xwayland-satellite built in) is the second GDM session next to niri.
# The second-session lineage: hyprland+mango (trial) -> Umbriel + DMS ->
# ShojiWM + shoji-bar-4. Umbriel + DMS were RETIRED 2026-11 and this step
# replaces theirs wholesale: the Terra repo (umbriel-nightly +
# xdg-desktop-portal-umbriel-nightly), the duxlabs/dms COPR (dms dms-cli
# dux-search dgop matugen), the dms-umbriel.service user unit, and the
# bubblebox .config/umbriel files are all gone.
#
# Source-only: ShojiWM ships no distro packages yet (upstream's own docs say
# packaged installs land "just before the official release"), so this step
# clones the repo PINNED BY COMMIT (048f2fdf9f2ddd2dea5c96bbb9a37f381edb09b1;
# no tag at the point we adopted -- a commit pin is the strongest guarantee we
# have, and Cargo.lock + the pinned smithay fork rev inside it make the build
# reproducible) and installs exactly what dist/install.sh installs, minus the
# user-side bits (no default user config is seeded at build time -- first
# setup copies /usr/share/shojiwm/default-config/. to ~/.config/shojiwm, which
# is then a repo-managed bubblebox [[files]] dir; node_modules/shoji_wm inside
# it is a symlink to /usr/lib/shojiwm/packages/shoji_wm created then).
#
# The shell for the session is shoji-bar-4 (github.com/bea4dev/shoji-bar-4):
# a user-side Rust build cloned to ~/.config/shoji-bar-4 and built with the
# rust-dev bubblebox devshell -- deliberately NOT baked here. ShojiWM's
# default config launches ~/.config/shoji-bar-4/target/release/shoji-bar-4
# only if it exists, so the compositor is complete without it.
#
# GDM entry: /usr/share/wayland-sessions/shojiwm.desktop, Exec=/usr/bin/
# shoji_wm --tty, DesktopNames=ShojiWM. Portal backend (ScreenCast):
# /usr/share/xdg-desktop-portal/portals/shojiwm.portal + the dbus/systemd
# units below; per-session backend selection lives user-side in
# .config/xdg-desktop-portal/shojiwm-portals.conf.
#
# ONE RUN LAYER, toolchain removed at the end (image size): F44's rustc is
# 1.99.1, new enough for the workspace (upstream CI runs stable). Build deps
# are dnf5-removed after the artifacts are installed; removing the *-devel
# packages leaves the RUNTIME libs in place (wayland, libxkbcommon,
# systemd-libs, libinput, mesa-libgbm, libseat, libxcb, xcb-util-cursor,
# pipewire -- shoji_wm links them; Xwayland 24.1 is already in the base for
# the built-in xwayland-satellite). The bindgen-based -sys crates (drm/gbm/
# input/libseat/libspa/pipewire/lcms2/pixman/xcb-util-cursor) drive the devel
# list -- libspa's headers ship inside pipewire-devel (pkgconfig(libspa-0.2),
# /usr/include/spa-0.2; F44 has no separate SPA devel package) -- and libclang
# (clang-libs) is for bindgen itself: a live build without it panics in
# bindgen/lib.rs "Unable to find libclang". clang-libs also ships the builtin
# headers under /usr/lib/clang/22 (not /usr/lib64/...), which libclang's
# resource-dir lookup misses on Fedora's multiarch split -- the
# BINDGEN_EXTRA_CLANG_ARGS resource-dir pin below fixes stdbool.h not found.
# `dnf5 history
# inside a container build (no transaction history survives the layer), so
# plain remove + clean all is the honest cleanup. git and Xwayland are NOT
# in the remove list: both are base-image packages (the install line lists
# them only so the build fails loudly if a future base drops them). The
# cargo cache (~/.cargo: registry tarballs + the smithay git checkout --
# hundreds of MB) is deleted too; the runtime TS files under /usr/lib/
# shojiwm are what the compositor actually loads at session start.
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    dnf5 -y --setopt=install_weak_deps=False install \
        rust cargo gcc make \
        wayland-devel libxkbcommon-devel systemd-devel libinput-devel \
        mesa-libgbm-devel libseat-devel libxcb-devel xcb-util-cursor-devel \
        xorg-x11-server-Xwayland pipewire-devel git \
        clang-libs libdrm-devel lcms2-devel pixman-devel \
    && git clone --no-checkout https://github.com/bea4dev/ShojiWM.git /tmp/ShojiWM \
    && git -C /tmp/ShojiWM checkout 048f2fdf9f2ddd2dea5c96bbb9a37f381edb09b1 \
    && (cd /tmp/ShojiWM \
        && BINDGEN_EXTRA_CLANG_ARGS='-resource-dir /usr/lib/clang/22' \
           cargo build --release -p shoji_wm -p xdg-desktop-portal-shojiwm \
        && install -Dm755 target/release/shoji_wm /usr/bin/shoji_wm \
        && install -Dm755 target/release/xdg-desktop-portal-shojiwm \
            /usr/bin/xdg-desktop-portal-shojiwm \
        && mkdir -p /usr/lib/shojiwm/packages /usr/lib/shojiwm/tools \
        && cp -a packages/shoji_wm /usr/lib/shojiwm/packages/ \
        && cp tools/decoration-runtime.ts /usr/lib/shojiwm/tools/ \
        && install -Dm644 dist/shojiwm.desktop \
            /usr/share/wayland-sessions/shojiwm.desktop \
        && install -Dm644 dist/shojiwm.portal \
            /usr/share/xdg-desktop-portal/portals/shojiwm.portal \
        && install -Dm644 dist/org.freedesktop.impl.portal.desktop.shojiwm.service \
            /usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.shojiwm.service \
        && install -Dm644 dist/xdg-desktop-portal-shojiwm.service \
            /usr/lib/systemd/user/xdg-desktop-portal-shojiwm.service \
        && rm -rf /usr/share/shojiwm/default-config \
        && mkdir -p /usr/share/shojiwm/default-config \
        && cp -a packages/config/. /usr/share/shojiwm/default-config/) \
    && dnf5 -y remove \
        rust cargo gcc make \
        wayland-devel libxkbcommon-devel systemd-devel libinput-devel \
        mesa-libgbm-devel libseat-devel libxcb-devel xcb-util-cursor-devel \
        pipewire-devel \
        clang-libs libdrm-devel lcms2-devel pixman-devel \
    && dnf5 -y clean all \
    && rm -rf /tmp/ShojiWM ~/.cargo /root/.cargo \
    && test -x /usr/bin/shoji_wm \
    && test -f /usr/share/wayland-sessions/shojiwm.desktop

# ---- 3. SELinux: disabled (personal-laptop host policy) -----------------
# This is a single-user personal laptop, and the operator comes from NixOS/
# Arch where SELinux isn't part of the workflow. Fedora ships the `targeted`
# policy enabled by default; its friction (label mismatches on relocated paths,
# audit noise, per-inode relabeling cost) isn't worth the hardening for this
# threat model -- the desktop apps worth sandboxing run in bubblebox containers
# or come from this image itself, and the daemons `targeted` most protects
# (httpd, named, ...) don't run on a desktop. So: disable it in the image.
#
# Mechanism: `SELINUX=disabled` in /etc/selinux/config -- the canonical, image-
# bakeable way. The selinux-policy packages stay installed (removing them
# breaks a web of dependencies), but no policy is loaded and no enforcement
# happens. For absolute-zero kernel overhead you could additionally
# `rpm-ostree kargs --append-if-missing selinux=0` on the host, but the config
# change alone is effectively all the way there.
RUN sed -i 's/^SELINUX=.*/SELINUX=disabled/' /etc/selinux/config && \
    grep -q '^SELINUX=disabled' /etc/selinux/config

# ---- 3.1. zsh: default login shell for new users -------------------------
# Make zsh the default login shell for newly-created users, while keeping bash
# available (it stays installed as part of the base image). The default user on
# this host is created by the installer from these defaults, so new installs get
# zsh automatically. For an already-installed host, switch the existing account
# with `chsh -s /usr/bin/zsh` after deploying this image.
#
# shadow-utils ships the file at /etc/default/useradd, but in an ostree/bootc
# image the "default" copy may also live at /usr/etc/default/useradd (the image
# default that gets copied to /etc on first boot). Handle either location.
RUN set -e; \
    edited=0; \
    for f in /etc/default/useradd /usr/etc/default/useradd; do \
        if [ -f "$f" ]; then \
            sed -i 's|^SHELL=.*|SHELL=/usr/bin/zsh|' "$f"; \
            grep -q '^SHELL=/usr/bin/zsh' "$f"; \
            edited=1; \
        fi; \
    done; \
    [ "$edited" = 1 ]

# ---- 3.5. kernel args (bootc static kargs) -----------------------------
# bootc applies *.toml files under /usr/lib/bootc/kargs.d/ to every deployment
# staged from this image -- on BOTH `bootc install` and routine `bootc upgrade`
# -- by diffing the booted image's kargs.d against the new image's and patching
# the new deployment's cmdline accordingly. Removing a file from a future
# image retracts its karg on the next upgrade. This is the image-bakeable,
# declarative equivalent of `rpm-ostree kargs --append-if-missing`, and it
# survives reinstalls. (Schema: a required `kargs` array of strings plus an
# optional `match-architectures` array; confirmed against bootc_kargs.rs in
# bootc 1.15.2.)
#
# usbcore.autosuspend=-1: disables USB runtime autosuspend globally. The Dell
# P3225QE over USB-C/DisplayPort on this Lunar Lake (xe) ThinkPad was flapping
# the DP-1 connector at a steady ~3s cadence -- the classic signature of the
# USB-C DP tunnel cycling in/out of runtime suspend, which drops HPD and forces
# a link retrain each wake. Keeping the tunnel awake fixes the external-monitor
# black-screen cycling at full 4K@60, so the 1440p workaround in
# bubblebox/files/.config/monitors.xml + niri config can be reverted once this is live.
RUN mkdir -p /usr/lib/bootc/kargs.d && \
    printf 'kargs = ["usbcore.autosuspend=-1"]\nmatch-architectures = ["x86_64"]\n' \
    > /usr/lib/bootc/kargs.d/10-usb-autosuspend.toml

# ---- 3.6. insecure-registry drop-in for the homelab zot registry --------
# The host's boot image pulls from bees's zot registry at 10.10.0.6:5000 --
# plain HTTP inside the Nebula WireGuard tunnel (Nebula IS the transport
# security; the registry is bound to the overlay address only). This drop-in
# teaches container tools in the image (skopeo/bootc container previews,
# `podman pull 10.10.0.6:5000/...` if you ever want to inspect the image
# without switching) that the registry is intentionally insecure-HTTP.
# NOTE: bootc itself reads these drop-ins too (same containers-image stack)
# -- trust for 10.10.0.6:5000 must exist on the HOST at switch/upgrade time;
# switch.sh bootstraps it for the running host.
RUN mkdir -p /etc/containers/registries.conf.d && \
    printf '[[registry]]\nlocation = "10.10.0.6:5000"\ninsecure = true\n' \
    > /etc/containers/registries.conf.d/10-homelab-registry.conf

# ---- 3.7. Nebula overlay hostnames (/etc/hosts) --------------------
# The fleet's NixOS hosts get these /etc/hosts entries via
# modules/nebula-hosts.nix, rendered from lib/host-meta.nix (the single
# source of truth). The thinkpad bakes the SAME rendered entries into the
# image's /etc/hosts. At deploy time bootc migrates the image's /etc into
# the deployment's /usr/etc defaults, and ostree 3-way merges those into
# the live /etc/hosts on every upgrade -- so overlay names (bee, bees, nas,
# nebula-hetzner, ...) resolve everywhere, and future host-meta changes
# flow to this host with each image upgrade, as long as the live /etc/hosts
# stays unmodified (it ships unmodified today).
#
# MECHANISM -- COPY, not RUN: buildah RUN-time-masks /etc/hosts (like
# resolv.conf / hostname): every RUN container gets a freshly generated
# /etc/hosts, so `RUN cat >> /etc/hosts` writes the throwaway runtime copy
# and NEVER commits to the layer (verified live: a separate-RUN grep
# assertion failed, 2026-08-27). COPY writes the layer tarball directly --
# no masking. etc-hosts is the COMPLETE file (stock Fedora loopback block +
# the generated fragment), rendered by `nix run .#render-thinkpad-hosts`;
# the identical fragment (hosts-sync on the laptop) is also committed as
# nebula-hosts. `nix flake check` fails if either goes stale.
COPY etc-hosts /etc/hosts

# ---- 3.8. sudoers: passwordless `bootc upgrade` for the daily timer -------
# bubblebox ships a user timer (hosts/thinkpad/bubblebox/units/thinkpad-
# image-update.{service,timer}) that runs the consumer side of this pipeline
# daily: stage the latest build (`bootc upgrade`, stage-only -- reboots stay
# manual) + an ntfy lag alert. A user unit has no TTY for an askpass, so the
# staging command gets an explicit NOPASSWD grant. Args are listed EXPLICITLY:
# a Cmnd with arguments matches ONLY that exact argv, so `upgrade` alone is
# granted and `upgrade --apply` (which reboots) still requires a password.
# (The original grant pinned the args as `upgrade ""` -- an empty-string
# argument in the spec -- which sudo listed as a valid match but never
# honoured at exec time; the daily timer failed "a password is required"
# from day one. Plain `upgrade` is the exact-argv form.)
# Everything that changes the image REFERENCE (`bootc switch`, `bootc edit`)
# stays passworded. The username is baked in: single-user personal image.
# visudo -cf validates the file at build time, before it can brick sudo.
RUN printf 'crussell ALL=(root) NOPASSWD: /usr/bin/bootc upgrade\n' \
    > /etc/sudoers.d/90-bootc-upgrade \
    && chmod 0440 /etc/sudoers.d/90-bootc-upgrade \
    && visudo -cf /etc/sudoers.d/90-bootc-upgrade

# ---- 3.9. system services baked from this repo --------------------------
# The nebula/tailscale/restic units are part of the SYSTEM layer now: quadlet
# sources + timers + the ntfy template ship in the image (their dirs under
# hosts/thinkpad/ keep only the container-image builds and the one-time
# secret seeding -- volumes and /etc/restic-backup are host state, not image
# state). This replaces the sudo install.sh copies into /etc, which could
# drift from the repo and vanish on a reinstall.
COPY quadlets/ /usr/share/containers/systemd/
COPY systemd/ /usr/lib/systemd/system/
# sshd: key-only drop-in. Ships in /etc -- bootc snapshots build-time /etc as
# the default configuration (same as the etc-hosts COPY below; /usr/etc is a
# bootc implementation detail and `bootc container lint` rejects it).
# Replaces `cjust ssh`'s imperative write; authorized_keys stays a recipe
# (it's per-host key state).
COPY etc/ /etc/
# User linger: bubblebox user units run before any login (tmpfiles.d).
COPY tmpfiles.d/ /usr/lib/tmpfiles.d/
# nebula autostart: quadlet units are GENERATED at boot (no unit file exists
# at build time, so `systemctl enable` can't work) -- bake the wants symlink
# to the generator output. Same mechanism install.sh used (proven on this
# host); the generator runs before multi-user.target evaluates its wants.
# tailscale stays on-demand (no symlink) by design -- see its quadlet header.
RUN mkdir -p /etc/systemd/system/multi-user.target.wants \
    && ln -s /run/systemd/generator/nebula.service \
        /etc/systemd/system/multi-user.target.wants/nebula.service
# Real units enable normally (offline in the build root -- bootc-blessed).
RUN systemctl enable restic-backup.timer restic-check.timer sshd.service

# ---- 4. build identity (lets `bootc upgrade` detect a rebuild) ----------
# Each build injects a unique IMAGE_VERSION (git SHA + timestamp; see
# build.sh) two ways:
#   - as an OCI LABEL, which lives in the image *config* and therefore changes
#     the image's MANIFEST/CONFIG DIGEST on every build. That digest is exactly
#     what `bootc upgrade` compares against the booted image, so a rebuilt
#     `:stable` is always detected as new and gets deployed (see README, "switch
#     once, upgrade thereafter"). Without the label, a rebuild that reuses
#     podman's layer cache has an identical manifest digest and `bootc upgrade`
#     correctly -- but uselessly -- reports "No update available".
#   - written to /usr as well, so on the booted system you can `cat
#     /usr/lib/host-image-thinkpad-version` to see exactly which build you're
#     on without querying bootc/podman.
# This is the ONLY layer that changes per build, so the dnf layers above stay
# cached and rebuilds stay fast.
ARG IMAGE_VERSION=local
RUN printf 'IMAGE_VERSION=%s\n' "${IMAGE_VERSION}" > /usr/lib/host-image-thinkpad-version
LABEL org.opencontainers.image.version="${IMAGE_VERSION}"


# ---- 5. finalize: bootc-native validation -----------------------------
# systemd as pid 1 is required for a bootc image. `bootc container lint` then
# validates the image (catches /run leftovers, /opt issues, etc.) before you
# ever switch to it -- it replaces the old `ostree container commit`.
CMD ["/sbin/init"]
RUN bootc container lint
