#!/usr/bin/env bash
# zen-browser — launch the Zen flatpak and clamp it under a cgroup v2 soft
# memory limit (MemoryHigh), applied to flatpak's own app scope at launch.
#
# Why a wrapper instead of `systemd-run --scope -p MemoryHigh=...` around the
# launch: flatpak calls StartTransientScope itself via its session helper,
# creating `app-flatpak-<appid>-<id>.scope` as a SIBLING under app.slice — so
# any outer scope we wrap the launch in is bypassed and the browser escapes
# with MemoryHigh=infinity. The only reliable attachment point is flatpak's
# OWN scope, via `systemctl --user set-property --runtime` once it appears.
# (Verified empirically: an inner scope created from inside an outer scope
# lands at app.slice, not nested under the outer scope.)
#
# Why MemoryHigh (not MemoryMax): MemoryHigh is a cgroup v2 *soft* limit. When
# the scope exceeds it, the kernel aggressively reclaims pages inside it
# (swap → zram) and emits PSI memory-pressure events, but never OOM-kills.
# Firefox/Zen's nsAvailableMemoryWatcher reacts to PSI by unloading tabs — so
# the browser self-governs as if the box only has $ZEN_MEMHIGH RAM, which is
# the goal: stop it from eating everything before its own unload logic kicks
# in, without ever killing it. MemoryMax would OOM-kill the whole browser;
# MemoryHigh just throttles/reclaims.
#
# The limit comes from ZEN_MEMHIGH (default 16G). The desktop override
# (generated by `cjust zen-memlimit`) sets this via an `env ZEN_MEMHIGH=...`
# prefix, so `cjust zen-memlimit 12G` regenerates with the new value — this
# script itself stays static and version-controlled.
#
# See hosts/thinkpad/Justfile (`zen-memlimit` recipe) for the full setup.

set -euo pipefail

APPID="app.zen_browser.zen"
MEM="${ZEN_MEMHIGH:-16G}"

# Re-launch the flatpak with all forwarded args (URLs, --private-window, etc.).
# Backgrounded so we can watch for the scope; `wait` at the end preserves
# desktop-launch semantics (Exec blocks until the app exits).
/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=launch-script.sh \
  --file-forwarding "$APPID" "$@" &
fp_pid=$!

# flatpak's app-flatpak-<appid>-<id>.scope appears within ~100ms of launch.
# Poll for up to ~5s, then apply MemoryHigh to every matching scope (normally
# exactly one; matching all is harmless and also covers the case where this
# launch forwarded to an already-running instance — that existing scope gets
# re-capped too). --runtime keeps the property ephemeral (/run, not
# ~/.config/systemd/user/) so nothing accumulates across launches.
applied=0
for _ in $(seq 1 50); do
  scopes=$(systemctl --user list-units --type=scope --all --no-legend --no-pager 2>/dev/null \
           | awk -v app="$APPID" '$1 ~ ("app-flatpak-" app "-[0-9]+\\.scope$") {print $1}')
  if [ -n "$scopes" ]; then
    for scope in $scopes; do
      if systemctl --user set-property --runtime "$scope" MemoryHigh="$MEM" >/dev/null 2>&1; then
        echo "zen-browser: MemoryHigh=$MEM on $scope" >&2
        applied=1
      fi
    done
    break
  fi
  # If flatpak already exited (e.g. forwarded to an existing instance and
  # returned), stop polling — but we still re-scan once more below in case the
  # scope for that instance is what we want.
  kill -0 "$fp_pid" 2>/dev/null || { sleep 0.2; break; }
  sleep 0.1
done

if [ "$applied" != "1" ]; then
  echo "zen-browser: no app-flatpak scope capped (flatpak may have forwarded to an existing instance before we could attach)" >&2
fi

wait "$fp_pid"
