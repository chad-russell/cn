[Unit]
Description=sweatshop - personal software factory (CI-built zot image), http://bee:3300 + preview proxy 10.10.0.12:3301
# rustfs.service is the skills sidecar's generated unit name (quadlet
# units take the file name rustfs.container -> rustfs.service).
After=network-online.target rustfs.service
Wants=network-online.target rustfs.service

[Container]
# Image-era serving (sweatshop 0091, cn quadlet cutover): the image is
# CI-built on merge to main by the sweatshop repo's Forgejo workflow and
# pushed to the bees zot registry. The repo's deploy workflow pulls
# :main and restarts this unit; AutoUpdate=registry is the catch-up
# (nightly podman auto-update pulls if a deploy pull failed — tastyquant
# model). zot is plain HTTP on the Nebula LAN: registries.insecure on
# bee (tastyquant.nix).
Image=10.10.0.6:5000/sweatshop/app:main
AutoUpdate=registry
# Name kept from the ./dev era: sweatshop's sandbox-gc client and the
# claude bridge reach the app by this name on sweatshop-harness.
ContainerName=sweatshop-dev
# Rootless podman maps container root to crussell, so writes into the
# bind-mounted data dir land crussell-owned (the same model as ./dev).
User=0
# NO checkout bind, NO node_modules volume (0091): the image carries the
# built tree + deps. State (sqlite + WAL, workflow-data, backups/,
# env/.env.local) lives in ~/.sweatshop-data, moved out of the checkout
# by the cutover activation in sweatshop.nix — restic covers it
# (backup.nix). The checkout stays for ./dev but is no longer serving
# infrastructure.
Volume=%h/.sweatshop-data:/app/data
# Host rootless podman socket: sandboxes, service containers and previews
# are sibling containers on host podman (no nesting).
Volume=%t/podman/podman.sock:/var/run/docker.sock
# Private bridge shared with sandboxes (claude bridge, preview proxy,
# sandbox services reach each other by container name). Never published.
Network=sweatshop-harness.network
# App on 3300 (host 3000 is taken on bee); preview proxy on the Nebula IP
# only, where bees' Caddy forwards pv-*.internal.crussell.io.
PublishPort=3300:3000
PublishPort=10.10.0.12:3301:3001
# Model and git credentials (0600), relocated to the data dir by the
# cutover activation (a symlink keeps the checkout's ./dev path working).
# The sweatshop Secrets entity is the long-term home for these.
# Skills store (0088): SKILLS_S3_* lines (endpoint http://sweatshop-rustfs:9000,
# bucket skills, dedicated rustfs keypair) — env is read at process
# start, so a unit restart is needed after edits land.
EnvironmentFile=%h/.sweatshop-data/env/.env.local
# 0043 host channel: the exec tool's SSH key (agenix, crussell-owned on
# the host). One key authorized on every NixOS host; each HOST_<NAME>_…
# var names it for that host's registry entry (vars without a matching
# project_hosts row are inert).
Volume=/run/agenix/sweatshop-host-key:/run/agenix/sweatshop-host-key:ro
Environment=HOST_BEE_SSH_KEY_FILE=/run/agenix/sweatshop-host-key
Environment=HOST_BEES_SSH_KEY_FILE=/run/agenix/sweatshop-host-key
Environment=HOST_NAS_SSH_KEY_FILE=/run/agenix/sweatshop-host-key
Environment=HOST_GATEWAY_SSH_KEY_FILE=/run/agenix/sweatshop-host-key
Environment=NODE_ENV=production
# Workflow SDK local world beside the db (backed up), not in .next/. BOTH
# are required: withWorkflow() overwrites WORKFLOW_LOCAL_DATA_DIR to
# .next/workflow-data whenever WORKFLOW_TARGET_WORLD is unset.
Environment=WORKFLOW_TARGET_WORLD=local
Environment=WORKFLOW_LOCAL_DATA_DIR=/app/data/workflow-data
# No Entrypoint=/Exec= override: the image CMD runs migrations then
# `next start -p 3000` (self-contained schema step, sweatshop 0091).

[Service]
Restart=always
RestartSec=5
# Cold start pulls the image (if absent) and runs migrations before
# serving; the pull is the slow part on first boot.
TimeoutStartSec=300

[Install]
WantedBy=default.target
