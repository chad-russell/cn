# sweatshop — renamed successor (repo
# git.crussell.io/chad/sweatshop). One app, apps/web (TanStack Start +
# nitro), serving https://sweatshop.internal.crussell.io via bees Caddy
# (hosts/bees/caddy/routes/internal/sweatshop.caddy) → 10.10.0.12:3330.
#
# Runs the CI-built zot image (:main). Deploy flow (no cn change needed):
#   merge to chad/sweatshop main → bees Forgejo runner builds the image →
#   pushes 10.10.0.6:5000/sweatshop/app:main → CI ssh's to bee, pulls and
#   `systemctl --user restart sweatshop.service`. The nightly
#   podman-auto-update (AutoUpdate=registry) catches any missed restart.
# NixOS activation (hosts/bee/sweatshop.nix) only installs/reloads this
# file; it never starts or restarts the app.
#
# First boot, before the first image push: the pull fails and the unit
# retries (Restart=always). Expected and harmless.
#
# State: /home/crussell/sweatshop-data (sqlite+WAL db, generated
# secret-key/media-secret, claude-home/, codex-home/) — in bee's restic
# paths; nightly consistent copy at backups/nightly.db (sweatshop.nix).
#
# Sandboxes: sweatshop drives the host rootless podman engine via dockerode
# through the mounted socket, so sandboxes run as sibling containers.
# Published sandbox preview ports are reachable on the engine host at
# 10.10.0.12:<port>.
[Unit]
Description=sweatshop (apps/web, 10.10.0.12:3330 → sweatshop.internal)
After=network-online.target
Wants=network-online.target

[Container]
Image=10.10.0.6:5000/sweatshop/app:main
ContainerName=sweatshop
AutoUpdate=registry
# Host network: binds the Nebula IP directly and lets the app reach
# sandbox preview ports published on the host (tastyquant precedent).
Network=host
# Runtime layout is baked into the image (git + docker-cli included).
WorkingDir=/app/apps/web
Environment=NODE_ENV=production
Environment=SWEATSHOP_DB=/data/sweatshop.db
Environment=SWEATSHOP_CLAUDE_HOME=/data/claude-home
Environment=SWEATSHOP_CODEX_HOME=/data/codex-home
# Preview subdomain suffix: sandboxes answer at
# https://<slug>.preview.internal.crussell.io (bees Caddy wildcard site,
# routes/preview/sweatshop-previews.caddy) which proxies here with the
# original Host intact — the app strips the slug off the front of it.
Environment=SWEATSHOP_PREVIEW_DOMAIN=preview.internal.crussell.io
Environment=PORT=3330
Environment=HOST=10.10.0.12
Volume=/home/crussell/sweatshop-data:/data
# Host rootless podman socket (the built-in "Podman" profile uses it).
Volume=%t/podman/podman.sock:/var/run/docker.sock
Exec=node .output/server/index.mjs

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
