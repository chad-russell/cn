# Storyhub container dev environment
# Uses compose service DNS names (postgres, rustfs)

NODE_ENV=development
APP_ENV=local

# Database (compose DNS: postgres:5432)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/storyhub"
DIRECT_URL="postgresql://postgres:postgres@postgres:5432/storyhub"

# Hummingbird connections (browser-facing auth uses dev.crussell.io)
HUMMINGBIRD_API_URL="http://hb-api:8000"
HUMMINGBIRD_URL="https://hb-web.dev.crussell.io"
HUMMINGBIRD_INTEGRATION_TOKEN="g360-storyhub-to-hummingbird-bearer-token"

# Storyhub worker (compose DNS)
STORYHUB_WORKER_URL="http://storyhub-worker:8001"
STORYHUB_WORKER_BEARER_TOKEN="g360-storyhub-worker-bearer-token"
STORYHUB_STANDALONE="false"

# Session
# SESSION_SECRET loaded from encrypted secrets

# S3 (compose DNS: rustfs:9000)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="rustfsadmin"
AWS_SECRET_ACCESS_KEY="rustfsadmin"
S3_ENDPOINT="http://rustfs:9000"
MEDIA_ITEMS_BUCKET="storyhub-media-items"
