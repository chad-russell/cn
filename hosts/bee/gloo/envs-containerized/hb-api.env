# Hummingbird API container dev environment
# Uses compose service DNS names (postgres, rustfs)

NODE_ENV=development
APP_ENV=local
PORT=8000
HOST=0.0.0.0

# Database (compose DNS: postgres:5432)
CONN_URL=postgresql://postgres:postgres@postgres:5432/postgres

# S3 (compose DNS: rustfs:9000)
AWS_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=rustfsadmin
AWS_S3_SECRET_ACCESS_KEY=rustfsadmin
AWS_S3_BUCKET=storyhub-media-items
AWS_S3_ENDPOINT=http://rustfs:9000
AWS_CLOUDFRONT_URL=http://rustfs:9000/storyhub-media-items
AWS_CLOUDFRONT_KEYPAIR_ID=dummy-keypair-id

# Dev-only placeholder
CLOUDFRONT_KEYPAIR_USER_CONTENT_PRIVATE_KEY="placeholder"

# Browser-facing audience redirects
STORYHUB_REDIRECT_URL=https://storyhub.internal.crussell.io/auth/login
