# Polymer container dev environment
# Uses compose service DNS names (postgres, rustfs)

NODE_ENV=development

# Database (compose DNS: postgres:5432)
POSTGRES_URL=postgres://postgres:postgres@postgres:5432/polymer

# App URLs (browser-facing)
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/callback

# WorkOS
WORKOS_CLIENT_ID=client_01JWEPWFJX19G5YQNYJ3X5D8SN
# WORKOS_API_KEY loaded from encrypted secrets
# WORKOS_COOKIE_PASSWORD loaded from encrypted secrets
WORKOS_SSO_DUNHAM_AND_COMPANY_CONNECTION_ID=""

# Object storage (compose DNS: rustfs:9000)
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_REGION=us-east-1
S3_ENDPOINT=http://rustfs:9000
MEDIA_BUCKET=polymer-bucket

# Analytics
# NEXT_PUBLIC_POSTHOG_KEY loaded from encrypted secrets
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Platform Snowflake (centralized warehouse for reports)
SNOWFLAKE_ACCOUNT=GLOO-GLOO360
SNOWFLAKE_USERNAME=SVC_POLYMER_DEV
# SNOWFLAKE_PRIVATE_KEY loaded from encrypted secrets
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=DB_DEVELOPMENT_R
SNOWFLAKE_DATABASE=DEVELOPMENT

# Encryption key
# INTEGRATION_ENCRYPTION_KEY loaded from encrypted secrets
