# GPL container dev environment
# Uses compose service DNS names (postgres, rustfs, hb-api)

NODE_ENV=development
NEXT_PUBLIC_ENABLE_PROJECT_PACKS_PAGE=true

# Database (compose DNS: postgres:5432)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/gpl_db

# Better Auth
# BETTER_AUTH_SECRET loaded from encrypted secrets
BETTER_AUTH_URL=https://gpl.internal.crussell.io
NEXT_PUBLIC_BETTER_AUTH_URL=https://gpl.internal.crussell.io

# S3 (compose DNS: rustfs:9000)
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=gpl-assets
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true

# Hummingbird API (compose DNS: hb-api:8000)
HUMMINGBIRD_API_URL=http://hb-api:8000
HUMMINGBIRD_API_PATH=/api/hummingbird/projects
# HUMMINGBIRD_API_KEY loaded from encrypted secrets

# Hummingbird SSO (browser-facing — stays as internal.crussell.io domains)
NEXT_PUBLIC_HUMMINGBIRD_URL=https://hb-web.internal.crussell.io
NEXT_PUBLIC_HUMMINGBIRD_REDIRECT_URI=https://gpl.internal.crussell.io/auth/hummingbird/callback
