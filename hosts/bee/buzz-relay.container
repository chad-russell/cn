[Unit]
Description=Buzz relay (ghcr.io/block/buzz) — wss://buzz.crussell.io
# Cross-service ordering (Quadlet auto-adds the pod dependency via Pod=).
# The relay retry-starts until PG accepts connections; resolves itself on
# cold boot within a few seconds.
Requires=buzz-postgres.service buzz-redis.service buzz-minio.service buzz-minio-init.service
After=buzz-postgres.service buzz-redis.service buzz-minio.service buzz-minio-init.service

[Container]
Image=ghcr.io/block/buzz:main
AutoUpdate=registry
ContainerName=buzz-relay
Pod=buzz-relay.pod
Volume=buzz-git-data:/data/git
EnvironmentFile=/run/agenix/buzz-relay-env
# Invite and join flows use WebView fetch rather than the native HTTP bridge.
# Desktop probes NIP-11 and uses this sidecar instead of the legacy /pair
# fallback when relays require membership before joining.
PodmanArgs=--env=BUZZ_CORS_ORIGINS=https://buzz.crussell.io,tauri://localhost,http://tauri.localhost,https://tauri.localhost --env=BUZZ_PAIRING_RELAY_URL=wss://buzz.crussell.io/pair

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
