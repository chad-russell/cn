# tastyquant analytics site (apps/site, 10.10.0.12:8808) — the desk's
# backend. Also the SPAWNER host: on Approve it launches one-off placement
# containers through the podman socket (read-plane .env for reprice runs;
# .env.production never mounts here — only the spawned executor sees it).
[Unit]
Description=tastyquant analytics site (apps/site, 10.10.0.12:8808 — desk backend)

[Container]
Image=10.10.0.6:5000/tastyquant/app:main
ContainerName=tq-site
AutoUpdate=registry
Network=host
WorkingDir=/work
Environment=TZ=UTC
Environment=TQ_PLACE_ORDERS=production
Environment=TQ_REPRICE_PODMAN_SOCK=/run/user/1000/podman/podman.sock
Environment=TQ_REPRICE_REPO_HOST=%h/tastyquant
Environment=TQ_REPRICE_REPO_CONTAINER=/work
Environment=TQ_REPRICE_CACHE_VOLUME=tq-build-cache
Environment=TQ_REPRICE_IMAGE=docker.io/library/node:22
Environment=TQ_REPRICE_DATA_HOST=%h/tastyquant-data
Environment=TQ_EXECUTOR_KILL_SWITCH=/work/data/executor/kill-switch
Environment=TQ_EXECUTOR_AUDIT_DB=/work/data/executor/executor.db
Volume=%h/tastyquant-data:/work/data
Volume=%h/tastyquant/.env:/work/.env:ro
Volume=/run/user/1000/podman/podman.sock:/run/user/1000/podman/podman.sock
Exec=node apps/site/dist/server.js --db data/v2/portfolio.db --port 8808 --host 10.10.0.12

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
