[Unit]
Description=Hermes Agent (Nous Research) — gateway mode
Documentation=https://hermes-agent.nousresearch.com/docs/user-guide/docker
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/nousresearch/hermes-agent:latest
ContainerName=hermes
# gateway run starts the messaging adapters (Telegram here), the optional
# API server, and the dashboard under s6-overlay supervision.
Exec=gateway run

# Single source of truth: config.yaml, .env, sessions/, memories/, skills/,
# cron/, logs/, home/. s6 init chowns this to PUID:PGID on first boot.
Volume=/var/lib/hermes:/opt/data

# Run as crussell:users so files on the volume are host-editable without sudo.
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=America/New_York

# Dashboard (HTTP, basic auth via agenix env). Container binds 0.0.0.0 so the
# podman port-forward below works; host-side publish is bound to the Nebula IP
# only, so the LAN and internet cannot reach it.
Environment=HERMES_DASHBOARD=1
Environment=HERMES_DASHBOARD_HOST=0.0.0.0

# OpenAI-compatible API server. Auth gated by API_SERVER_KEY in the env file.
Environment=API_SERVER_ENABLED=true
Environment=API_SERVER_HOST=0.0.0.0

# Secrets (OPENROUTER_API_KEY, TELEGRAM_*, API_SERVER_KEY,
# HERMES_DASHBOARD_BASIC_AUTH_*) — agenix-decrypted at /run/agenix/hermes-env.
EnvironmentFile=/run/agenix/hermes-env
# ZAI_API_KEY — shared with opencode; lets hermes use Z.AI's OpenAI-compatible
# endpoint (e.g. glm-4.7) as a primary or compression model.
EnvironmentFile=/run/agenix/zai-api-key

# Nebula-only exposure (10.10.0.12). bee's firewall is disabled, so the
# PublishPort host IP is what enforces the network boundary.
PublishPort=10.10.0.12:8642:8642
PublishPort=10.10.0.12:9119:9119

[Service]
Restart=always
RestartSec=5
# Image pulls can be slow on first boot; give it room before restart-limit kicks in.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
