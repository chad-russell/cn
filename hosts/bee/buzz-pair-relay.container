[Unit]
Description=Buzz device pairing relay (NIP-AB)

[Container]
Image=ghcr.io/block/buzz:main
ContainerName=buzz-pair-relay
Pod=buzz-relay.pod
PodmanArgs=--entrypoint=/usr/local/bin/buzz-pair-relay
Environment=BUZZ_PAIR_RELAY_BIND_ADDR=0.0.0.0:5000

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
