[Unit]
Description=Buzz relay Redis

[Container]
Image=redis:7-alpine
ContainerName=buzz-redis
Pod=buzz-relay.pod
Volume=buzz-redis-data:/data
Exec=redis-server --appendonly yes
# No requirepass: Redis is pod-internal only (port 6379 is not published).

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
