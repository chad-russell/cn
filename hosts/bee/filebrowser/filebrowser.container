[Unit]
Description=filebrowser (gtstef/filebrowser) — web file manager, Nebula 10.10.0.12:8093

[Container]
Image=docker.io/gtstef/filebrowser:stable
# Run as container-root: under rootless podman that IS crussell (uid 1000),
# which is what the old manual container did — the image's named `filebrowser`
# user maps to a shifted host uid that cannot read the 0660 config, and
# --userns=keep-id trips a crun exec bug with this image (verified 2026-09-19).
User=0:0
PublishPort=10.10.0.12:8093:8080
# Faithful port of the manual container's mounts (podman inspect 2026-09-19).
# NOTE (security): browses the whole home incl. employer trees + hermes
# state — deliberate convenience, Nebula-only listener, revisit if it
# ever gains a public route.
Volume=/home/crussell/personal:/srv/personal
Volume=/home/crussell/rmt:/srv/rmt
Volume=/home/crussell/business:/srv/business
Volume=/home/crussell/Gloo:/srv/Gloo
Volume=/home/crussell/filebrowser/data:/home/filebrowser/data
Volume=/var/lib/hermes/.hermes:/srv/hermes
Volume=/home/crussell:/srv/home
Volume=/home/crussell/Code:/srv/Code

[Service]
# The manual container had NO restart policy (ran since 2026-09-08 only by
# luck); D-017 conversion adds supervision.
Restart=always

[Install]
WantedBy=default.target
