import { makeBrunch } from "brunch";
import { aiBrunchConfig } from "./hosts/ai/index.bri";
import { thinkpadBrunchConfig } from "./hosts/thinkpad/index.bri";
import { hubBrunchConfig } from "./hosts/hub/index.bri";

export async function ai() {
  return makeBrunch(aiBrunchConfig);
}

export async function thinkpad() {
  return makeBrunch(thinkpadBrunchConfig);
}

export async function hub() {
  return makeBrunch(hubBrunchConfig);
}
