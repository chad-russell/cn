# Podman network for the polymer quadlet dev stack.
#
# Default network name is systemd-polymer-dev. Containers on it resolve each
# other by ContainerName and by NetworkAlias (DNS), so the app can reach its
# postgres/minio via the hostnames already baked into .env.local.
[Unit]
Description=Polymer quadlet dev stack — podman network

[Network]
Label=io.gloo.project=polymer
