#!/usr/bin/env bash
#
# qd — thin convenience wrapper around systemctl for the polymer quadlet stack.
# The raw systemd commands always work; this just saves typing. See README.md.
#
#   qd polymer up          start the whole stack (db + minio + app)
#   qd polymer down        stop the whole stack
#   qd polymer restart     restart the app (and its db/minio via PartOf)
#   qd polymer status      status of app + db + minio
#   qd polymer logs        tail the app journal
#   qd polymer rebuild     rebuild the app image, then remind you to restart
set -euo pipefail

if command -v systemctl >/dev/null 2>&1; then
  SYS=(systemctl --user); JRN=(journalctl --user)
elif command -v flatpak-spawn >/dev/null 2>&1; then
  SYS=(flatpak-spawn --host systemctl --user); JRN=(flatpak-spawn --host journalctl --user)
else
  echo "FATAL: no systemctl found (run on the host or a toolbox with flatpak-spawn)" >&2
  exit 1
fi

proj="${1:-}"; cmd="${2:-up}"
# (No `rebuild` command: polymer now uses a published image, not a local build.
# To update the toolchain image: podman image pull mcr.microsoft.com/devcontainers/javascript-node:24
# && systemctl --user restart polymer-dev-app)
case "$proj" in
  polymer) svc="polymer-dev-app" ;;
  *) echo "usage: $0 <polymer> <up|down|restart|status|logs>" >&2; exit 1 ;;
esac

case "$cmd" in
  up)      "${SYS[@]}" start "$svc" ;;
  down)    "${SYS[@]}" stop "$svc" ;;
  restart) "${SYS[@]}" restart "$svc" ;;
  status)  "${SYS[@]}" status polymer-dev-app polymer-dev-db polymer-dev-minio ;;
  logs)    "${JRN[@]}" -u polymer-dev-app -f ;;
  *) echo "unknown command: $cmd" >&2
     echo "commands: up down restart status logs" >&2; exit 1 ;;
esac
