# ============================================
# Custom Keybindings
# ============================================

# Tab management
keybind = ctrl+t=new_tab
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

# Split creation (ctrl+b prefix, similar to tmux)
keybind = ctrl+b>h=new_split:left
keybind = ctrl+b>j=new_split:down
keybind = ctrl+b>k=new_split:up
keybind = ctrl+b>l=new_split:right

# Split navigation with alt+hjkl
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

# Close current split or tab
keybind = ctrl+w=close_surface

# Toggle fullscreen for current split
keybind = ctrl+y=toggle_split_zoom

# Tab overview (shows all tabs in a grid - Linux only, requires libadwaita 1.4+)
keybind = ctrl+shift+o=toggle_tab_overview

# ============================================
# Shell Configuration
# ============================================

# Set zsh as the default shell
command = zsh
